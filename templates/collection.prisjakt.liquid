{%- layout none -%}
{%- paginate collection.products by 250 -%}
{%- assign lt = "<" -%}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:g="http://base.google.com/ns/1.0">
<channel>
<title>{{ shop.name | escape }}</title>
{{ lt }}link>{{ shop.url }}{{ lt }}/link>
<description>Produktfeed for Prisjakt</description>
{%- for product in collection.products -%}
  {%- if product.gift_card? or product.price <= 0 -%}{%- continue -%}{%- endif -%}
  {%- assign description = product.description | strip_html | strip_newlines | replace: '&nbsp;', ' ' | replace: '  ', ' ' | strip | truncate: 5000, '...' -%}
  {%- for variant in product.variants -%}
    {%- if variant.price <= 0 -%}{%- continue -%}{%- endif -%}
    {%- assign image = variant.featured_image | default: product.featured_image -%}
    {%- assign title = product.title -%}
    {%- unless product.has_only_default_variant -%}{%- assign title = title | append: ' - ' | append: variant.title -%}{%- endunless -%}
    {%- assign price_cents = variant.price | modulo: 100 -%}
    {%- assign list_cents = variant.price -%}
    {%- if variant.compare_at_price > variant.price -%}{%- assign list_cents = variant.compare_at_price -%}{%- endif -%}
    {%- assign mpn = variant.sku | default: variant.id %}
<item>
<g:id>{{ variant.id }}</g:id>
<title>{{ title | escape }}</title>
<description>{{ description | escape }}</description>
{{ lt }}link>{{ shop.url }}{{ variant.url }}{{ lt }}/link>
{%- if image %}
<g:image_link>{{ image | image_url: width: 1200 }}</g:image_link>
{%- endif %}
<g:price>{{ list_cents | divided_by: 100 }}.{{ list_cents | modulo: 100 | plus: 100 | append: '' | slice: 1, 2 }} NOK</g:price>
{%- if variant.compare_at_price > variant.price %}
<g:sale_price>{{ variant.price | divided_by: 100 }}.{{ price_cents | plus: 100 | append: '' | slice: 1, 2 }} NOK</g:sale_price>
{%- endif %}
<g:availability>{% if variant.available %}in_stock{% else %}out_of_stock{% endif %}</g:availability>
<g:brand>Skinora</g:brand>
<g:condition>new</g:condition>
<g:mpn>{{ mpn | escape }}</g:mpn>
{%- if variant.barcode != blank %}
<g:gtin>{{ variant.barcode | escape }}</g:gtin>
{%- endif %}
<g:shipping>
<g:country>NO</g:country>
<g:service>PostNord</g:service>
<g:price>0.00 NOK</g:price>
</g:shipping>
</item>
  {%- endfor -%}
{%- endfor %}
</channel>
</rss>
{%- endpaginate -%}
