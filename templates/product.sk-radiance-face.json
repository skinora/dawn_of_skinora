    "sk_pdp_moden_hud": {
      "type": "sk-pdp-text-media",
      "settings": {
        "heading": "Laget for moden hud",
        "text": "<p>Skinora Radiance Face er en LED-maske for ansiktet, laget for deg som ser at huden har endret seg. Fine linjer har blitt til rynker. Huden er slappere langs kjevelinjen og rundt øynene. Gløden er ikke den samme som før. Masken er utviklet i Norge med moden hud i tankene.</p>",
        "product_image_no": 2,
        "image_alt": "Kvinne med LED-masken Skinora Radiance Face på, med rødt lys tent",
        "image_side": "right"
      }
    },
    "sk_pdp_ti_minutter": {
      "type": "sk-pdp-cards",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "",
            "text": "Rens ansiktet og tørk huden.",
            "depth": 0
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "",
            "text": "Legg på masken, fest stroppene og trykk på kontrollenheten.",
            "depth": 0
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "",
            "text": "Etter 10 minutter slår den seg av av seg selv. Bruk den 3–5 ganger i uken.",
            "depth": 0
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ],
      "settings": {
        "heading": "Ti minutter, noen kvelder i uken",
        "intro": "",
        "numbered": true,
        "outro": "<p>Du kan lese, høre på en podkast eller bare ligge stille. Ta serum og krem etterpå, som vanlig. Resultatene kommer med jevn bruk over uker. Det er rutinen som gjør forskjellen.</p>"
      }
    },
    "sk_pdp_bolgelengder": {
      "type": "sk-pdp-cards",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "title": "630 nm – rødt lys",
            "text": "Virker i de øvre hudlagene og gir huden et friskere uttrykk.",
            "depth": 1
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "title": "830 nm – nær-infrarødt lys",
            "text": "Når dypere ned, der kollagenet dannes.",
            "depth": 2
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "title": "1072 nm – dypt nær-infrarødt lys",
            "text": "Når lengst ned. Denne bølgelengden er sjelden i masker for hjemmebruk.",
            "depth": 3
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ],
      "settings": {
        "heading": "Hvorfor tre bølgelengder",
        "intro": "<p>De fleste LED-masker for anti-aging bruker rødt og nær-infrarødt lys. Radiance Face har tre bølgelengder, som virker på hvert sitt nivå i huden:</p>",
        "numbered": false,
        "outro": "<p>Med tre bølgelengder får flere lag av huden lys i samme behandling. Det er derfor masken passer for rynker og slapp hud, ikke bare for glød.</p>",
        "product_image_no": 8,
        "image_alt": ""
      }
    },
    "sk_pdp_silikon": {
      "type": "sk-pdp-text-media",
      "blocks": {
        "fact_1": {
          "type": "fact",
