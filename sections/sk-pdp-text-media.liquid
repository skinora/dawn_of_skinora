{{ 'section-sk-pdp-text-media.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  sk-pdp-text-media — H2, brødtekst og (valgfritt) bilde og fakta-merker.
  Produktsiden. All tekst kommer fra innstillinger og blokker, ingenting er
  skrevet fast her. Teksten står i HTML-en fra serveren, synlig som standard.

  Bildet: eget bilde (image_picker) vinner. Ellers hentes bilde nr. N fra
  produktets medier, så malen kan bruke produktbildene uten at de må lastes
  opp på nytt under Filer. 0 = intet bilde.
{%- endcomment -%}
{%- liquid
  assign tm_image = section.settings.image
  if tm_image == blank and section.settings.product_image_no > 0
    assign tm_idx = section.settings.product_image_no | minus: 1
    assign tm_image = product.images[tm_idx]
  endif
  assign tm_alt = section.settings.image_alt | strip
  if tm_alt == blank
    assign tm_alt = tm_image.alt | default: product.title
  endif
-%}

<section
  class="sk-pdp-text-media{% if tm_image != blank %} sk-pdp-text-media--has-media sk-pdp-text-media--media-{{ section.settings.image_side }}{% endif %}"
  {% if section.settings.heading != blank %}aria-labelledby="sk-pdp-tm-{{ section.id }}"{% endif %}
>
  <div class="page-width">
    <div class="sk-pdp-text-media__inner">
      {%- if tm_image != blank -%}
        <div class="sk-pdp-text-media__media">
          <img
            src="{{ tm_image | image_url: width: 900 }}"
            srcset="{{ tm_image | image_url: width: 450 }} 450w, {{ tm_image | image_url: width: 700 }} 700w, {{ tm_image | image_url: width: 900 }} 900w, {{ tm_image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 480px, calc(100vw - 32px)"
            alt="{{ tm_alt | escape }}"
            width="{{ tm_image.width }}"
            height="{{ tm_image.height }}"
            loading="lazy"
            decoding="async"
          >
        </div>
      {%- endif -%}

      <div class="sk-pdp-text-media__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="sk-pdp-text-media__heading" id="sk-pdp-tm-{{ section.id }}">
            {{- section.settings.heading | escape -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="sk-pdp-text-media__body">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sk-pdp-text-media__facts">
            {%- for block in section.blocks -%}
              {%- if block.settings.label != blank -%}
                <li class="sk-pdp-text-media__fact" {{ block.shopify_attributes }}>
                  {{- block.settings.label | escape -}}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SK PDP Tekst + bilde",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift (H2)"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst"
    },
    {
      "type": "header",
      "content": "Bilde"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Eget bilde",
      "info": "Valgfritt. Står feltet tomt, brukes produktbildet under."
    },
    {
      "type": "range",
      "id": "product_image_no",
      "label": "Produktbilde nr.",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0,
      "info": "Rekkefølgen i produktets medier. 0 = intet bilde."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt-tekst",
      "info": "Si hva bildet viser, og nevn produktnavnet. Tomt felt = bildets egen alt-tekst."
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Bildets side på desktop",
      "options": [
        { "value": "left", "label": "Venstre" },
        { "value": "right", "label": "Høyre" }
      ],
      "default": "right"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fakta-merke",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tekst"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK PDP Tekst + bilde"
    }
  ]
}
{% endschema %}
