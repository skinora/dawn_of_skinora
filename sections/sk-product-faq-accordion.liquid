{{ 'section-sk-product-faq-accordion.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Synlig FAQ (<details>/<summary>, ingen JS) + FAQPage JSON-LD fra SAMME kilde.
  Kilden er metafeltet custom.faq_item. Listen gås gjennom én gang: hvert
  spørsmål/svar skrives til både HTML-en og JSON-LD-en i samme iterasjon, så
  de ikke kan komme i utakt. Svarene ligger i HTML-en ved sidelasting.
{%- endcomment -%}
{%- assign faq_items = product.metafields.custom.faq_item.value -%}

{%- if faq_items != blank -%}
  {%- capture faq_ld -%}
    {%- for faq_item in faq_items -%}
      {
        "@type": "Question",
        "name": {{ faq_item.question | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ faq_item.answer | metafield_text | strip_newlines | strip | json }}
        }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  {%- endcapture -%}

  <section class="sk-product-faq-accordion" aria-labelledby="faq-heading-{{ section.id }}">
    <div class="page-width">
      <div class="sk-faq-accordion__content">
        {%- if section.settings.title != blank -%}
          <h2 class="sk-faq-accordion__title" id="faq-heading-{{ section.id }}">
            {{- section.settings.title | escape -}}
          </h2>
        {%- endif -%}

        <div class="sk-faq-accordion__list">
          {%- for faq_item in faq_items -%}
            <details
              class="sk-faq-accordion__item"
              {%- if forloop.first and section.settings.open_first_item %} open{% endif %}
            >
              <summary class="sk-faq-accordion__summary">
                <h3 class="sk-faq-accordion__question">{{ faq_item.question | escape }}</h3>
              </summary>
              <div class="sk-faq-accordion__answer">
                {%- if faq_item.answer.type == 'rich_text_field' -%}
                  {{ faq_item.answer | metafield_tag }}
                {%- else -%}
                  {{ faq_item.answer }}
                {%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{{ faq_ld }}]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SK Product FAQ",
  "tag": "div",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Viser spørsmål og svar fra produktets metafelt custom.faq_item (liste av metaobjekter med 'question' og 'answer'). FAQPage-schema bygges av de samme elementene."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Overskrift (H2)",
      "default": "Spørsmål og svar om LED-masken"
    },
    {
      "type": "checkbox",
      "id": "open_first_item",
      "label": "Åpne første spørsmål som standard",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "SK Product FAQ"
    }
  ]
}
{% endschema %}
