{%- comment -%}
  Skinora video story
  Erstatter «Kundereiser: før og etter» på produktsiden. Viser at masken er
  ekte og enkel å bruke hjemme – ikke resultater. Ingen hudpåstander i
  standardtekstene.

  Videokilde: Shopify-hostet video (Filer) vinner; YouTube/Vimeo-lenken
  brukes bare når den mangler. Avspilling styres av
  assets/skinora-video-story.js: spiller kun synlig, pauser utenfor skjermen,
  ingen autoplay ved prefers-reduced-motion.

  Ingen autoplay-attributt i markupen med vilje: attributtet starter videoen
  før den er synlig og overstyrer reduced-motion. Skriptet kaller play() når
  videoen kommer inn i bildet – samme effekt for alle andre.

  Malen product.sk-radiance deles av flere produkter. «Skjul på disse
  produktene» lar seksjonen stå i malen uten å vises der videoen ikke passer
  (f.eks. Radiance Face-videoen på Skinora Clear). Da rendres ingenting.
{%- endcomment -%}

{%- liquid
  assign hide_section = false
  if product and section.settings.hide_on_handles != blank
    assign hidden_handles = section.settings.hide_on_handles | remove: ' ' | split: ','
    if hidden_handles contains product.handle
      assign hide_section = true
    endif
  endif
-%}

{%- unless hide_section -%}
{{ 'section-skinora-video-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign video = section.settings.video
  assign has_file = false
  if video != blank
    assign has_file = true
  endif
  assign ext = section.settings.video_url
  assign has_ext = false
  if has_file == false and ext != blank
    assign has_ext = true
  endif

  case section.settings.aspect_ratio
    when '9-16'
      assign ratio = '9 / 16'
      assign ratio_num = 0.5625
    when '1-1'
      assign ratio = '1 / 1'
      assign ratio_num = 1
    when '16-9'
      assign ratio = '16 / 9'
      assign ratio_num = 1.7778
    else
      assign ratio = '4 / 5'
      assign ratio_num = 0.8
  endcase

  assign poster = section.settings.poster_image
  if poster == blank and has_file
    assign poster = video.preview_image
  endif

  assign video_label = section.settings.video_label | default: section.settings.heading | escape
  assign uid = 'VideoStory-' | append: section.id
-%}

<section
  id="{{ section.settings.anchor_id | default: uid | handleize }}"
  class="skinora-video-story{% if section.settings.video_position == 'right' %} skinora-video-story--media-right{% endif %}{% unless has_file or has_ext %} skinora-video-story--no-media{% endunless %}"
  style="--vs-bg: {{ section.settings.background_color }}; --vs-ratio: {{ ratio }}; --vs-ratio-num: {{ ratio_num }}; --vs-focus: {{ section.settings.video_focus }};"
  data-video-story
  data-vs-placement="{% if template.name == 'product' %}{% if template.suffix contains 'sk-lp' %}lp{% else %}pdp{% endif %}{% else %}lp{% endif %}"
  aria-labelledby="{{ uid }}-heading"
>
  <div class="skinora-video-story__inner">
    {%- if has_file or has_ext -%}
      <div class="skinora-video-story__media">
        <div class="skinora-video-story__frame" data-vs-frame>
          {%- if has_file -%}
            <video
              class="skinora-video-story__video"
              muted
              loop
              playsinline
              preload="metadata"
              {% if section.settings.show_controls %}controls{% endif %}
              {% if poster != blank %}poster="{{ poster | image_url: width: 1100 }}"{% endif %}
              aria-label="{{ video_label }}"
              data-vs-video
            >
              {%- for source in video.sources -%}
                {%- if source.format == 'mp4' or source.format == 'mov' -%}
                  <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endif -%}
              {%- endfor -%}
            </video>
          {%- else -%}
            {%- liquid
              if ext.type == 'youtube'
                assign ctrl = 0
                if section.settings.show_controls
                  assign ctrl = 1
                endif
                assign embed = 'https://www.youtube-nocookie.com/embed/' | append: ext.id | append: '?enablejsapi=1&mute=1&loop=1&playlist=' | append: ext.id | append: '&playsinline=1&rel=0&modestbranding=1&controls=' | append: ctrl
              else
                assign ctrl = 'false'
                if section.settings.show_controls
                  assign ctrl = 'true'
                endif
                assign embed = 'https://player.vimeo.com/video/' | append: ext.id | append: '?muted=1&loop=1&playsinline=1&dnt=1&controls=' | append: ctrl
              endif
            -%}
            <iframe
              class="skinora-video-story__video"
              data-src="{{ embed }}"
              data-vs-embed="{{ ext.type }}"
              title="{{ video_label }}"
              allow="autoplay; encrypted-media; picture-in-picture"
              loading="lazy"
              {% if poster != blank %}style="background-image: url('{{ poster | image_url: width: 1100 }}');"{% endif %}
            ></iframe>
          {%- endif -%}

          {%- if has_file and section.settings.show_controls == false -%}
            {%- comment -%}
              Stor ▶ over den dempede videoen: trykk = lyd på og start fra
              begynnelsen. Ved reduced motion står videoen stille bak den.
            {%- endcomment -%}
            <button
              type="button"
              class="skinora-video-story__unmute"
              data-vs-unmute
            >
              <span class="skinora-video-story__unmute-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="28" height="28" focusable="false">
                  <path d="M8 5v14l11-7z" fill="currentColor"/>
                </svg>
              </span>
              <span class="skinora-video-story__unmute-label">{{ section.settings.unmute_label | default: 'Se med lyd' | escape }}</span>
            </button>
          {%- else -%}
            <button
              type="button"
              class="skinora-video-story__play"
              aria-label="Spill av video"
              data-vs-play
              hidden
            >
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                <path d="M8 5v14l11-7z" fill="currentColor"/>
              </svg>
            </button>
          {%- endif -%}

          {%- unless section.settings.show_controls -%}
            <button
              type="button"
              class="skinora-video-story__sound"
              aria-label="Slå på lyd"
              aria-pressed="false"
              data-vs-sound
            >
              <svg class="skinora-video-story__icon-muted" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
                <path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              </svg>
              <svg class="skinora-video-story__icon-sound" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
                <path d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              </svg>
              <span class="skinora-video-story__sound-label" data-vs-sound-label>Slå på lyd</span>
            </button>
          {%- endunless -%}
        </div>
      </div>
    {%- endif -%}

    <div class="skinora-video-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="skinora-video-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="{{ uid }}-heading" class="skinora-video-story__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="skinora-video-story__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="skinora-video-story__steps">
          {%- for block in section.blocks -%}
            <li class="skinora-video-story__step" {{ block.shopify_attributes }}>
              <span class="skinora-video-story__step-num" aria-hidden="true">{{ forloop.index }}</span>
              <div>
                <p class="skinora-video-story__step-title">{{ block.settings.title | escape }}</p>
                {%- if block.settings.text != blank -%}
                  <p class="skinora-video-story__step-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="skinora-video-story__cta">
          <a
            href="{{ section.settings.button_link | default: '#product-form' }}"
            class="sk-btn sk-btn--primary"
            data-vs-cta
            data-analytics="cta_video_story"
          >
            {{- section.settings.button_label | escape -}}
          </a>
          {%- if section.settings.button_note != blank -%}
            <p class="skinora-video-story__note">{{ section.settings.button_note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script src="{{ 'skinora-video-story.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{% schema %}
{
  "name": "Video – slik brukes den",
  "tag": "div",
  "class": "section-skinora-video-story",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (fra Filer)",
      "info": "Brukes først. Mobilvideo (stående) passer best med 4:5 eller 9:16."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Reserve: YouTube- eller Vimeo-lenke",
      "accept": ["youtube", "vimeo"],
      "info": "Brukes bare når det ikke er valgt en video over."
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Posterbilde",
      "info": "Tomt = videoens forhåndsvisningsbilde."
    },
    {
      "type": "text",
      "id": "video_label",
      "label": "Beskrivelse av videoen (skjermlesere)",
      "default": "Skinora LED-masken i bruk hjemme",
      "info": "Beskriv kort hva som skjer i videoen."
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Størrelsesforhold",
      "options": [
        { "value": "9-16", "label": "9:16 (stående, hele mobilbildet)" },
        { "value": "4-5", "label": "4:5" },
        { "value": "1-1", "label": "1:1" },
        { "value": "16-9", "label": "16:9" }
      ],
      "default": "4-5"
    },
    {
      "type": "select",
      "id": "video_focus",
      "label": "Utsnitt (hvilken del av videoen som vises når den beskjæres)",
      "options": [
        { "value": "50% 0%", "label": "Topp" },
        { "value": "50% 25%", "label": "Øvre del" },
        { "value": "50% 50%", "label": "Midten" },
        { "value": "50% 75%", "label": "Nedre del" },
        { "value": "50% 100%", "label": "Bunn" }
      ],
      "default": "50% 50%",
      "info": "En stående mobilvideo i 4:5 mister litt topp og bunn. Velg hvor ansiktet/masken er."
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Videoens plassering (desktop)",
      "options": [
        { "value": "left", "label": "Venstre" },
        { "value": "right", "label": "Høyre" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "unmute_label",
      "label": "Tekst på den store ▶-knappen",
      "default": "Se med lyd",
      "info": "Trykk starter videoen fra begynnelsen med lyd."
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Vis standard videokontroller",
      "default": false
    },
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Liten tekst over overskriften",
      "default": "SLIK BRUKES DEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "10 minutter. Sofaen. Ferdig."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst",
      "default": "<p>Ta på masken, velg program og len deg tilbake. Den slår seg av selv. Ingen gel, ingen oppvarming – bare en rolig pause i hverdagen.</p>"
    },
    {
      "type": "header",
      "content": "Knapp"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knappetekst",
      "default": "Prøv hjemme i 30 dager"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Knappelenke",
      "default": "#product-form",
      "info": "#product-form ruller myk til produktets kjøpsknapp. Kan også være en vanlig lenke, f.eks. /products/…"
    },
    {
      "type": "text",
      "id": "button_note",
      "label": "Liten tekst under knappen",
      "default": "Fornøyd, eller pengene tilbake."
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-id",
      "default": "se-videoen",
      "info": "Lenk hit med #se-videoen, f.eks. fra heroens «Se hvordan den brukes». Må være unik på siden."
    },
    {
      "type": "header",
      "content": "Synlighet"
    },
    {
      "type": "text",
      "id": "hide_on_handles",
      "label": "Skjul på disse produktene",
      "info": "Produkt-handles adskilt med komma, f.eks. skinora-clear. Tomt = vises på alle produkter som bruker malen."
    },
    {
      "type": "header",
      "content": "Farger"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Bakgrunnsfarge",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Steg",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tittel",
          "default": "Rengjør huden"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Kort tekst",
          "default": "Ren, tørr hud uten tunge produkter."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video – slik brukes den",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Rengjør huden",
            "text": "Ren, tørr hud uten tunge produkter."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Velg program",
            "text": "Rødt og nær-infrarødt lys, ett trykk på fjernkontrollen."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "10 minutter",
            "text": "Masken slår seg av automatisk."
          }
        }
      ]
    }
  ]
}
{% endschema %}
