{%- comment -%}
  sk-product-clinic-proof — «klinikkene selger den».

  Ment å stå rett etter produkt-heroen. Jobben er å fjerne tvil, ikke å
  ta klikket: kjøpsknappen står rett over, så seksjonen har ingen egen
  knapp og ingen lenke ut til klinikkene (det ville lekket kunden ut av
  siden i det øyeblikket hun er nærmest å kjøpe).

  Bevisrekkefølge: påstand (H2) → én navngitt fagperson med ansikt →
  bredden bak henne (antall klinikker, byer, logoer). Én person slår tre
  små avatarer; bredden kommer etterpå som bekreftelse.

  Ingenting her har påfunnet standardinnhold. Sitat, navn, tittel og
  antall klinikker står tomme til de fylles inn med ekte, samtykket
  innhold – og det som er tomt, rendres ikke.

  Sitatet skrives uten anførselstegn; «» legges på i CSS.
{%- endcomment -%}

{{ 'section-sk-product-clinic-proof.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings

  assign has_media = false
  if s.image != blank
    assign has_media = true
  endif

  assign has_person = false
  if s.quote != blank or s.name != blank
    assign has_person = true
  endif

  assign has_proof = false
  if s.clinic_count > 0 or s.cities != blank or section.blocks.size > 0
    assign has_proof = true
  endif

  assign portrait_alt = s.image_alt
  if portrait_alt == blank and s.name != blank
    assign portrait_alt = s.name | append: ', ' | append: s.role
  endif
-%}

<section
  class="sk-cproof sk-cproof--{{ s.background }}{% unless has_media %} sk-cproof--no-media{% endunless %}"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  aria-labelledby="sk-cproof-heading-{{ section.id }}"
>
  <div class="sk-cproof__inner">
    <div class="sk-cproof__grid">
      <div class="sk-cproof__intro">
        {%- if s.eyebrow != blank -%}
          <p class="sk-cproof__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        <h2 id="sk-cproof-heading-{{ section.id }}" class="sk-cproof__heading">{{ s.heading | escape }}</h2>

        {%- comment -%}
          Grunnene er skrevet som opplevelse, ikke spesifikasjon: hva hun
          merker, ikke hva masken inneholder. Tallet foran gjør overskriftens
          «tre grunner» til et løfte som leses ut.
        {%- endcomment -%}
        {%- capture reasons -%}
          {%- for i in (1..3) -%}
            {%- assign title_key = 'reason_' | append: i | append: '_title' -%}
            {%- assign text_key = 'reason_' | append: i | append: '_text' -%}
            {%- assign r_title = s[title_key] -%}
            {%- assign r_text = s[text_key] -%}
            {%- if r_title != blank -%}
              <li class="sk-cproof__reason">
                <p class="sk-cproof__reason-title">{{ r_title | escape }}</p>
                {%- if r_text != blank -%}
                  <p class="sk-cproof__reason-text">{{ r_text | escape }}</p>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if reasons != blank -%}
          <ol class="sk-cproof__reasons" role="list">{{ reasons }}</ol>
        {%- endif -%}

        {%- if s.body != blank -%}
          <div class="sk-cproof__body">{{ s.body }}</div>
        {%- endif -%}
      </div>

      {%- if has_media -%}
        <div class="sk-cproof__media" style="--sk-cproof-focus-y: {{ s.image_focus_y }}%;">
          {{
            s.image
            | image_url: width: 1200
            | image_tag:
              widths: '360, 540, 720, 960, 1200',
              sizes: '(min-width: 769px) 460px, calc(100vw - 32px)',
              class: 'sk-cproof__portrait',
              alt: portrait_alt,
              loading: 'lazy'
          }}
        </div>
      {%- endif -%}

      {%- if has_person -%}
        <figure class="sk-cproof__person">
          {%- if s.quote != blank -%}
            <blockquote class="sk-cproof__quote">
              <p>{{ s.quote | escape | newline_to_br }}</p>
            </blockquote>
          {%- endif -%}

          {%- if s.name != blank -%}
            <figcaption class="sk-cproof__credit">
              <span class="sk-cproof__name">
                {{- s.name | escape -}}
                {%- if s.role != blank %}<span class="sk-cproof__role">, {{ s.role | escape }}</span>{% endif -%}
              </span>
              {%- if s.clinic != blank or s.city != blank -%}
                <span class="sk-cproof__clinic">
                  {{- s.clinic | escape -}}
                  {%- if s.clinic != blank and s.city != blank %}, {% endif -%}
                  {{- s.city | escape -}}
                </span>
              {%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endif -%}
    </div>

    {%- if has_proof -%}
      <div class="sk-cproof__proof">
        {%- if s.clinic_count > 0 or s.cities != blank -%}
          <p class="sk-cproof__count">
            {%- if s.clinic_count > 0 -%}
              <strong>{{ s.clinic_count }}</strong> {{ s.count_label | escape }}
            {%- endif -%}
            {%- if s.clinic_count > 0 and s.cities != blank %}<span class="sk-cproof__sep" aria-hidden="true"> · </span>{% endif -%}
            {%- if s.cities != blank -%}
              <span class="sk-cproof__cities">{{ s.cities | escape }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="sk-cproof__logos" role="list" aria-label="{{ s.logos_label | escape }}">
            {%- for block in section.blocks -%}
              <li class="sk-cproof__logo" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  {{
                    block.settings.logo
                    | image_url: width: 320
                    | image_tag:
                      widths: '160, 320',
                      sizes: '140px',
                      alt: block.settings.name,
                      loading: 'lazy'
                  }}
                {%- else -%}
                  <span class="sk-cproof__logo-name">{{ block.settings.name | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "SK Klinikkbevis",
  "tag": "div",
  "class": "sk-cproof-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Bakgrunn",
      "info": "Kjølig grå skiller seksjonen fra heroen uten sterke farger.",
      "options": [
        { "value": "cool", "label": "Kjølig grå" },
        { "value": "cream", "label": "Varm krem" },
        { "value": "paper", "label": "Hvit" }
      ],
      "default": "cool"
    },
    {
      "type": "header",
      "content": "Påstanden"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Bruk yrkestittelen bare hvis de som selger masken faktisk har den. Ellers: «fagfolk».",
      "default": "Anbefalt av dermatologiske sykepleiere"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "info": "Må være sant.",
      "default": "Fagfolkene velger den av tre grunner."
    },
    {
      "type": "header",
      "content": "Tre grunner"
    },
    {
      "type": "paragraph",
      "content": "Skriv det hun opplever, ikke hva masken inneholder. En grunn uten tittel vises ikke."
    },
    {
      "type": "text",
      "id": "reason_1_title",
      "label": "Grunn 1 – tittel",
      "default": "Du slipper å lure på om den virker"
    },
    {
      "type": "text",
      "id": "reason_1_text",
      "label": "Grunn 1 – tekst",
      "default": "Lyset er sterkt nok til å gjøre jobben, hver gang."
    },
    {
      "type": "text",
      "id": "reason_2_title",
      "label": "Grunn 2 – tittel",
      "default": "Den føles god å ha på"
    },
    {
      "type": "text",
      "id": "reason_2_text",
      "label": "Grunn 2 – tekst",
      "default": "Myk og lett, og den sitter tett. Behandlingen blir en stund for deg selv, ikke en plikt."
    },
    {
      "type": "text",
      "id": "reason_3_title",
      "label": "Grunn 3 – tittel",
      "default": "Du ser det selv i speilet"
    },
    {
      "type": "text",
      "id": "reason_3_text",
      "label": "Grunn 3 – tekst",
      "default": "Med jevnlig bruk er det speilet ditt som overbeviser deg, ikke oss."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Avslutningslinje",
      "info": "Vises under grunnene. Kort – bro over til sitatet.",
      "default": "<p>Den samme masken selges gjennom norske hudklinikker. Her får du den rett hjem, med 30 dagers åpent kjøp.</p>"
    },
    {
      "type": "header",
      "content": "Fagpersonen"
    },
    {
      "type": "paragraph",
      "content": "Bruk kun ekte navn, bilde og sitat med skriftlig samtykke. Tomme felt vises ikke."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrett",
      "info": "Ekte foto i klinikken, gjerne med masken i hånda. Vises i 4:5."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt-tekst",
      "info": "Tom: navn og tittel brukes."
    },
    {
      "type": "range",
      "id": "image_focus_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Vertikalt bildefokus",
      "info": "Lav verdi holder toppen av bildet.",
      "default": 30
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Sitat",
      "info": "Uten anførselstegn – de legges på automatisk. Konkret: en situasjon, og gjerne svar på «orker jeg dette?»."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Navn"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Tittel",
      "info": "Tittelen personen faktisk har. «Sykepleier» er en beskyttet tittel."
    },
    {
      "type": "text",
      "id": "clinic",
      "label": "Klinikk"
    },
    {
      "type": "text",
      "id": "city",
      "label": "By"
    },
    {
      "type": "header",
      "content": "Bredden"
    },
    {
      "type": "number",
      "id": "clinic_count",
      "label": "Antall klinikker",
      "info": "Det faktiske tallet. Tom: vises ikke."
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Tekst etter tallet",
      "default": "hudklinikker har valgt Skinora"
    },
    {
      "type": "text",
      "id": "cities",
      "label": "Byer",
      "info": "F.eks. «Oslo · Bergen · Trondheim»."
    },
    {
      "type": "text",
      "id": "logos_label",
      "label": "Skjermleser-tekst for logoraden",
      "default": "Klinikker som selger Skinora"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anker-ID (valgfri)"
    }
  ],
  "blocks": [
    {
      "type": "clinic",
      "name": "Klinikk",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Navn",
          "info": "Brukes som alt-tekst, eller vises som tekst hvis logo mangler."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Kun med klinikkens samtykke. Vises dempet i gråtoner."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Klinikkbevis"
    }
  ],
  "enabled_on": {
    "templates": ["product", "index", "page"]
  }
}
{% endschema %}
