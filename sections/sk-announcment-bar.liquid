{%- liquid
  # Under kampanje skjules melding 1 (10 %-tilbudet): to rabatter samtidig
  # kannibaliserer og gjør kampanjeprisen utydelig. Meldingen slettes ikke –
  # den kommer tilbake når kampanje_aktiv slås av.
  assign vis_melding_1 = true
-%}
{%- capture ann_campaign_live -%}{% render 'sk-campaign-live' %}{%- endcapture -%}
{%- liquid
  # Kampanjen sjekkes via 'sk-campaign-live', ikke via bryteren alene: en
  # kampanje som har passert sluttdatoen skal ikke lenger undertrykke
  # 10 %-meldingen. Ellers ville velkomsttilbudet blitt borte for godt
  # den dagen noen glemte å slå av bryteren.
  if ann_campaign_live contains '1'
    assign vis_melding_1 = false
  endif

  # Tell synlige meldinger og utled animasjonstiming, så det aldri blir en
  # tom periode der ingen melding vises.
  assign ann_count = 0
  if section.settings.message_1 != blank and vis_melding_1
    assign ann_count = ann_count | plus: 1
  endif
  if section.settings.message_2 != blank
    assign ann_count = ann_count | plus: 1
  endif
  if section.settings.message_3 != blank
    assign ann_count = ann_count | plus: 1
  endif
  if ann_count < 1
    assign ann_count = 1
  endif
-%}
{%- capture ann_bw_live -%}{%- render 'sk-bw-live' -%}{%- endcapture -%}
{%- liquid
  # Black Week: baren viser ÉN melding, statisk, på alle skjermer. De faste
  # meldingene slettes ikke — de kommer tilbake av seg selv etter sluttdatoen.
  # Teksten og lenken ligger i Temainnstillinger → Black Week.
  assign ann_bw = false
  if ann_bw_live contains '1' and settings.bw_banner_tekst != blank
    assign ann_bw = true
    assign ann_bw_maks = settings.bw_prosent_3
    # Forhåndsvisning med butikkens førpriser — kun i upubliserte temaer.
    # Samme regnestykke som i sections/sk-black-week.liquid.
    if settings.bw_forhandsvis_forpris
        assign ann_bw_keep = 100 | minus: settings.bw_prosent_3
        for ann_q in settings.bw_produkter
          assign ann_qv = ann_q.selected_or_first_available_variant
          if ann_qv.compare_at_price > ann_qv.price
            assign ann_q_unit = ann_qv.price | times: ann_bw_keep | divided_by: 100.0
            assign ann_q_pct = ann_qv.compare_at_price | minus: ann_q_unit | times: 100 | divided_by: ann_qv.compare_at_price | round
            if ann_q_pct > ann_bw_maks
              assign ann_bw_maks = ann_q_pct
            endif
          endif
        endfor
    endif
    assign ann_bw_text = settings.bw_banner_tekst | replace: '[maks]', ann_bw_maks | remove_first: 'Black Week: '
    assign ann_bw_until = ''
    assign ann_bw_end_iso = settings.bw_slutt_iso | strip
    if ann_bw_end_iso != blank
      assign ann_bw_months = 'januar,februar,mars,april,mai,juni,juli,august,september,oktober,november,desember' | split: ','
      assign ann_bw_end_m = ann_bw_end_iso | date: '%-m' | minus: 1
      assign ann_bw_until = ann_bw_end_iso | date: '%-d' | append: '. ' | append: ann_bw_months[ann_bw_end_m]
    endif
    assign ann_count = 1
  endif

  assign ann_cycle = ann_count | times: 5
  assign ann_slot = 100.0 | divided_by: ann_count
  assign ann_fade_out = ann_slot | minus: 3
-%}

<style>
  /* ── Black Week: svart bar med gull, større skrift, på alle skjermer ──
     Vanlig bar er 40 px og dempet på mobil fordi den konkurrerer med
     kjøpsknappen. Under Black Week ER baren budskapet, så den får 52 px,
     tydelig skrift og et gullmerke. Slår seg av med sk-bw-live. */
  .sk-announcement--bw {
    background: var(--bf-black);
    border-bottom: 1px solid var(--accent-gold);
  }

  .sk-announcement--bw .sk-announcement__inner {
    min-height: 52px;
    padding-block: var(--space-2);
  }

  .sk-announcement--bw .sk-announcement__bw {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-1) var(--space-3);
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    font-weight: var(--fw-semibold);
    line-height: var(--lh-relaxed);
    letter-spacing: var(--tracking-wide);
    color: var(--paper-0);
  }

  .sk-announcement__bw-tag {
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    background: var(--accent-gold);
    color: var(--bf-black);
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-wider);
    white-space: nowrap;
  }

  .sk-announcement__bw-until {
    color: var(--accent-gold);
    white-space: nowrap;
  }

  .sk-announcement {
    background: var(--ink-900);
    color: var(--color-white, #ffffff);
    font-family: var(--font-body-family, 'Inter', 'system-ui', sans-serif);
  }

  /* Meldingene legges i samme grid-celle (grid-row/column 1) og veksler med
     ren CSS-animasjon – én synlig om gangen. Grid-stacking gjør at baren får
     høyden til den enkelte meldingen, ikke summen av alle tre (ingen layout-
     shift, siden cellen alltid er like høy som den høyeste meldingen). */
  .sk-announcement__inner {
    min-height: 48px;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    justify-items: center;
    text-align: center;
    padding: 0.75rem var(--sk-page-gutter, 1rem);
  }

  .sk-announcement__text,
  .sk-announcement__link {
    grid-row: 1;
    grid-column: 1;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    line-height: var(--sk-line-height-tight, 1.45);
    margin: 0;
    color: inherit;
    text-decoration: none;
    opacity: 0;
    animation: sk-announcement-rotate-{{ section.id }} {{ ann_cycle }}s infinite;
  }

  {%- comment -%} Én melding igjen → ingen rotasjon, vis den statisk. {%- endcomment -%}
  {%- if ann_count == 1 -%}
  .sk-announcement__text,
  .sk-announcement__link {
    animation: none;
    opacity: 1;
  }
  {%- endif -%}

  /* Fallback hvis animasjon ikke kjører: vis i det minste tilbudet. */
  .sk-announcement__inner > :first-child {
    opacity: 1;
  }

  .sk-announcement__inner > :nth-child(1) { animation-delay: 0s; }
  .sk-announcement__inner > :nth-child(2) { animation-delay: 5s; }
  {%- if ann_count > 2 -%}
  .sk-announcement__inner > :nth-child(3) { animation-delay: 10s; }
  {%- endif -%}

  .sk-announcement__link:focus-visible,
  .sk-announcement__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Hver melding synlig ~5s av syklusen. Prosentene utledes fra antall
     synlige meldinger ({{ ann_count }}), så tidslinjen alltid går opp og
     ingen tom periode oppstår. pointer-events følger synlighet, så bare
     meldingen som vises er klikkbar. */
  @keyframes sk-announcement-rotate-{{ section.id }} {
    0% {
      opacity: 0;
      pointer-events: none;
    }
    2% {
      opacity: 1;
      pointer-events: auto;
    }
    {{ ann_fade_out }}% {
      opacity: 1;
      pointer-events: auto;
    }
    {{ ann_slot }}% {
      opacity: 0;
      pointer-events: none;
    }
    100% {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* Respekter «redusert bevegelse»: ingen rotasjon – vis kun tilbudet statisk. */
  @media (prefers-reduced-motion: reduce) {
    .sk-announcement__text,
    .sk-announcement__link {
      animation: none;
      opacity: 0;
    }

    .sk-announcement__inner > :first-child {
      opacity: 1;
    }

    .sk-announcement__inner > :not(:first-child) {
      display: none;
    }
  }

  /* ── Mobil: ett budskap, 40 px ────────────────────────────────────────────
     97 % av trafikken er mobil, og der teller hver piksel over folden —
     ATC-knappen skal ligge under 700 px i dokumentet. Baren kostet 48 px og
     roterte gjennom tre budskap, som betyr at kunden i verste fall ser feil
     budskap i det halvsekundet hen bestemmer seg.

     På mobil vises derfor kun frakt, statisk. Ingen animasjon: den koster
     også en kompositor-lag per melding, i toppen av siden, mens LCP-bildet
     kjemper om den samme rammen. */
  @media (max-width: 749px) {
    .sk-announcement__inner {
      min-height: 40px;
      padding-block: 0;
    }

    .sk-announcement__text,
    .sk-announcement__link {
      display: none;
      animation: none;
      opacity: 1;
    }

    .sk-announcement__text--primary {
      display: block;
      pointer-events: auto;
    }
  }
</style>

<div class="sk-announcement{% if ann_bw %} sk-announcement--bw{% endif %}">
  <div class="page-width sk-announcement__inner">
    {%- if ann_bw -%}
      {%- comment -%}
        --primary gjør at meldingen også vises på mobil, der baren ellers
        bare viser frakt.
      {%- endcomment -%}
      {%- if settings.bw_banner_lenke != blank -%}
        <a
          class="sk-announcement__link sk-announcement__text--primary sk-announcement__bw"
          href="{{ settings.bw_banner_lenke }}"
        >
          <span class="sk-announcement__bw-tag">Black Week</span>
          <span>{{ ann_bw_text | escape }}</span>
          {%- if ann_bw_until != blank -%}
            <span class="sk-announcement__bw-until">til {{ ann_bw_until }}</span>
          {%- endif -%}
        </a>
      {%- else -%}
        <p class="sk-announcement__text sk-announcement__text--primary">{{ ann_bw_text | escape }}</p>
      {%- endif -%}
    {%- else -%}
    {%- comment -%}
      Melding 1 = velkomsttilbudet. Klikkbar: scroller til nyhetsbrev-skjemaet
      i footeren via ankeret (#newsletter på .footer-top_section). Meldingene
      vises statisk (temaets eksisterende mekanisme — ingen rotasjon/script).
    {%- endcomment -%}
    {%- if section.settings.message_1 != blank and vis_melding_1 -%}
      {%- if section.settings.message_1_anchor != blank -%}
        <a class="sk-announcement__link" href="{{ section.settings.message_1_anchor }}">
          {{- section.settings.message_1 -}}
        </a>
      {%- else -%}
        <p class="sk-announcement__text">{{ section.settings.message_1 }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      Melding 2 = frakt. Den er merket fordi den er den ENESTE som vises på
      mobil: 97 % av trafikken er mobil, og der er baren ren kostnad i
      høydebudsjettet over folden. Frakt er det budskapet som faktisk
      påvirker kjøpsbeslutningen — garanti og nyhetsbrev kan vente til
      kunden har sett produktet.
    {%- endcomment -%}
    {%- if section.settings.message_2 != blank -%}
      <p class="sk-announcement__text sk-announcement__text--primary">{{ section.settings.message_2 }}</p>
    {%- endif -%}

    {%- if section.settings.message_3 != blank -%}
      <p class="sk-announcement__text">{{ section.settings.message_3 }}</p>
    {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SK Announcement Bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "message_1",
      "label": "Melding 1 (tilbud – klikkbar)",
      "default": "✦ 10 % på din første maske – meld deg på nyhetsbrevet"
    },
    {
      "type": "text",
      "id": "message_1_anchor",
      "label": "Melding 1 – anker/lenke",
      "info": "F.eks. #newsletter for å scrolle til nyhetsbrev-skjemaet i footeren. La stå tom for å vise meldingen uten lenke.",
      "default": "#newsletter"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Melding 2",
      "default": "✦ Gratis frakt i hele Norge – sendes fra norsk lager"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Melding 3",
      "default": "✦ 30 dagers fornøydgaranti – pengene tilbake"
    }
  ],
  "blocks": [
    {
      "type": "placeholder",
      "name": "Content block",
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "SK Announcement Bar"
    }
  ]
}
{% endschema %}
