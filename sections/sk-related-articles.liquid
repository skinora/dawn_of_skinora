{{ 'section-sk-related-articles.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Relaterte artikler — kontekstuell intern lenking (temaklynge).
  Viser 3–6 andre innlegg fra samme blogg (innstillingen «Antall artikler»),
  valgt etter delte tags, ikke tilfeldig og ikke bare nyeste. Ankertekst =
  artikkelens tittel.

  Rekkefølge:
  1. Pilarartikkelen (settingen `pillar_article`), når den er satt og ikke er
     artikkelen man står på — slik lenker alle undertema-artikler til
     pilarsiden.
  2. Artikler som deler minst to tags med denne.
  3. Artikler som deler én tag. Tags som «women» går igjen på mange
     artikler, så én felles tag alene er et svakere signal enn to.
  4. Nyeste artikler fyller opp resten, så seksjonen aldri står halvtom.

  Innen hvert trinn gjelder bloggens egen rekkefølge (nyeste først), så
  utvalget er stabilt mellom sidevisninger.
{%- endcomment -%}

{%- liquid
  assign max_posts = section.settings.max_posts | default: 4
  assign pillar = section.settings.pillar_article
  assign show_pillar = false
  if pillar != blank and pillar.handle != article.handle
    assign show_pillar = true
    assign max_posts = max_posts | minus: 1
  endif

  comment
    picked er en |-avgrenset liste over handles som allerede er brukt, så
    samme artikkel aldri kommer to ganger på tvers av trinnene.
  endcomment
  assign picked = '|' | append: article.handle | append: '|'
  if show_pillar
    assign picked = picked | append: pillar.handle | append: '|'
  endif

  assign picked_list = ''
  assign shown = 0
  assign thresholds = '2,1,0' | split: ','
  for threshold_str in thresholds
    assign threshold = threshold_str | plus: 0
    for related in blog.articles
      if shown >= max_posts
        break
      endif
      assign key = '|' | append: related.handle | append: '|'
      if picked contains key
        continue
      endif

      assign shared = 0
      for tag in related.tags
        if article.tags contains tag
          assign shared = shared | plus: 1
        endif
      endfor

      if shared >= threshold
        assign picked = picked | append: related.handle | append: '|'
        assign picked_list = picked_list | append: related.handle | append: ','
        assign shown = shown | plus: 1
      endif
    endfor
  endfor

  assign picked_handles = picked_list | split: ','
-%}

{%- if show_pillar or shown > 0 -%}
  <section
    class="sk-related-articles section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
    aria-labelledby="sk-related-articles-heading-{{ section.id }}"
  >
    <div class="page-width">
      <h2 id="sk-related-articles-heading-{{ section.id }}" class="sk-related-articles__heading">
        {{ section.settings.heading | default: 'Relaterte artikler' | escape }}
      </h2>

      <div class="sk-related-articles__grid">
        {%- if show_pillar -%}
          {%- render 'sk-related-article-card', related: pillar -%}
        {%- endif -%}

        {%- for handle in picked_handles -%}
          {%- for related in blog.articles -%}
            {%- if related.handle == handle -%}
              {%- render 'sk-related-article-card', related: related -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Relaterte artikler",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["article"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Relaterte artikler"
    },
    {
      "type": "article",
      "id": "pillar_article",
      "label": "Pilarartikkel",
      "info": "Vises alltid først (f.eks. komplett-guiden). La stå tom for kun automatiske forslag."
    },
    {
      "type": "range",
      "id": "max_posts",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Antall artikler",
      "info": "Inkludert pilarartikkelen. Velges etter felles tags, deretter nyeste.",
      "default": 4
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "t:sections.all.colors.accent_1.label"
        },
        {
          "value": "accent-2",
          "label": "t:sections.all.colors.accent_2.label"
        },
        {
          "value": "background-1",
          "label": "t:sections.all.colors.background_1.label"
        },
        {
          "value": "background-2",
          "label": "t:sections.all.colors.background_2.label"
        }
      ],
      "default": "background-1",
      "label": "t:sections.all.colors.label"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Relaterte artikler"
    }
  ]
}
{% endschema %}
