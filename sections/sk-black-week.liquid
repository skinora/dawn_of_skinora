{{ 'section-sk-black-week.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  sk-black-week — Black Week-tilbudet på ett produkt, med nedtelling
  ----------------------------------------------------------------------------
  Bilde, overskrift, pris / før-pris / besparelse, nedtelling, kjøpslenke,
  to trygghetslinjer og vilkår.

  INGEN TALL ER SKREVET HER. Pris, før-pris og besparelse kommer fra
  produktet i Temainnstillinger → Black Week, via snippets/sk-bw-offer
  (som leser sk-lp-pricing). Før-prisen er produktets «Sammenlign med» i
  Shopify — den skal være prisen masken faktisk hadde før kampanjen.

  Seksjonen vises bare når BEGGE stemmer:
    1. Black Week går (sk-bw-live: bryter + start- og sluttdato)
    2. produktet faktisk er satt ned i Shopify
  Den fjerner seg selv når fristen passeres, også i en fane som har stått
  åpen (JS nederst).
{%- endcomment -%}

{%- capture bw_live -%}{%- render 'sk-bw-live' -%}{%- endcapture -%}
{%- capture bw_sale -%}{%- render 'sk-bw-offer', part: 'salg' -%}{%- endcapture -%}

{%- if bw_live contains '1' and bw_sale contains '1' -%}
  {%- capture bw_price -%}{%- render 'sk-bw-offer', part: 'pris' -%}{%- endcapture -%}
  {%- capture bw_was -%}{%- render 'sk-bw-offer', part: 'for' -%}{%- endcapture -%}
  {%- capture bw_save -%}{%- render 'sk-bw-offer', part: 'spar' -%}{%- endcapture -%}
  {%- capture bw_preview -%}{%- render 'sk-bw-offer', part: 'preview' -%}{%- endcapture -%}
  {%- liquid
    assign bw_p = settings.bw_produkt
    assign bw_name = bw_p.title | split: ' – ' | first | remove: 'Skinora® ' | remove: 'Skinora '
    assign bw_months = 'januar,februar,mars,april,mai,juni,juli,august,september,oktober,november,desember' | split: ','

    assign bw_start_iso = settings.bw_start_iso | strip
    assign bw_end_iso = settings.bw_slutt_iso | strip
    assign bw_period = ''
    assign bw_end_text = ''
    assign bw_end_ts = 0

    if bw_end_iso != blank
      assign bw_end_ts = bw_end_iso | date: '%s' | plus: 86399
      assign bw_end_day = bw_end_iso | date: '%-d'
      assign bw_end_m = bw_end_iso | date: '%-m' | minus: 1
      assign bw_end_text = bw_end_day | append: '. ' | append: bw_months[bw_end_m]
      assign bw_period = bw_end_text

      if bw_start_iso != blank
        assign bw_start_day = bw_start_iso | date: '%-d'
        assign bw_start_m = bw_start_iso | date: '%-m' | minus: 1
        if bw_start_m == bw_end_m
          assign bw_period = bw_start_day | append: '.–' | append: bw_end_text
        else
          assign bw_period = bw_start_day | append: '. ' | append: bw_months[bw_start_m] | append: ' – ' | append: bw_end_text
        endif
      endif
    endif

    assign bw_heading = section.settings.heading | replace: '[produkt]', bw_name | replace: '[pris]', bw_price | replace: '[spar]', bw_save
    assign bw_terms = section.settings.terms | replace: '[periode]', bw_period | replace: '[produkt]', bw_name
    assign bw_tag = section.settings.heading_tag | default: 'h2'

    assign bw_cta_url = section.settings.cta_url
    if bw_cta_url == blank
      assign bw_cta_url = bw_p.url
    endif
    assign bw_cta_label = section.settings.cta_label | replace: '[produkt]', bw_name
  -%}

  <div
    class="sk-bw"
    id="sk-bw-{{ section.id }}"
    {% if bw_end_ts > 0 %}
      data-end-ts="{{ bw_end_ts }}"
    {% endif %}
  >
    <div class="sk-bw__inner page-width">
      {%- if section.settings.show_image and bw_p.featured_image != blank -%}
        <a class="sk-bw__media" href="{{ bw_cta_url }}" tabindex="-1" aria-hidden="true">
          {{-
            bw_p.featured_image
            | image_url: width: 900
            | image_tag:
              class: 'sk-bw__img',
              loading: 'lazy',
              widths: '360, 540, 720, 900',
              sizes: '(min-width: 990px) 420px, 90vw',
              alt: bw_p.featured_image.alt
          -}}
        </a>
      {%- endif -%}

      <div class="sk-bw__body">
        <p class="sk-bw__eyebrow">
          {{ section.settings.eyebrow }}
          {%- if bw_period != blank %} · {{ bw_period }}{% endif -%}
        </p>
        <{{ bw_tag }} class="sk-bw__title">{{ bw_heading | escape }}</{{ bw_tag }}>
        {%- if section.settings.lede != blank -%}
          <p class="sk-bw__lede">{{ section.settings.lede | escape }}</p>
        {%- endif -%}

        <p class="sk-bw__prices">
          <span class="sk-bw__now"><span class="visually-hidden">Nå:</span> {{ bw_price }}</span>
          <s class="sk-bw__was"><span class="visually-hidden">Før:</span> {{ bw_was }}</s>
          <span class="sk-bw__save">Spar {{ bw_save }}</span>
        </p>
        {%- if bw_preview contains '1' -%}
          <p class="sk-bw__preview-note">
            Forhåndsvisning: prisen er ikke endret i Shopify ennå.
          </p>
        {%- endif -%}

        {%- if bw_end_ts > 0 -%}
          {%- liquid
            assign bw_now_ts = 'now' | date: '%s' | plus: 0
            assign bw_left = bw_end_ts | minus: bw_now_ts
            if bw_left < 0
              assign bw_left = 0
            endif
            assign bw_d = bw_left | divided_by: 86400
            assign bw_h = bw_left | modulo: 86400 | divided_by: 3600
            assign bw_m = bw_left | modulo: 3600 | divided_by: 60
            assign bw_s = bw_left | modulo: 60
          -%}
          {%- comment -%}
            Serveren skriver ut ferdige tall, så klokka er riktig ved første
            maling. JS teller mot samme tidsstempel (sekunder siden 1970), så
            kundens tidssone ikke flytter fristen.
          {%- endcomment -%}
          <div class="sk-bw__countdown">
            <p class="sk-bw__countdown-label">{{ section.settings.countdown_label }}</p>
            <p class="sk-bw__clock" data-sk-bw-clock role="timer">
              <span class="sk-bw__unit">
                <span class="sk-bw__num" data-u="d">{{ bw_d }}</span>
                <span class="sk-bw__unit-label">dager</span>
              </span>
              <span class="sk-bw__unit">
                <span class="sk-bw__num" data-u="h">{{ bw_h | prepend: '0' | slice: -2, 2 }}</span>
                <span class="sk-bw__unit-label">timer</span>
              </span>
              <span class="sk-bw__unit">
                <span class="sk-bw__num" data-u="m">{{ bw_m | prepend: '0' | slice: -2, 2 }}</span>
                <span class="sk-bw__unit-label">min</span>
              </span>
              <span class="sk-bw__unit">
                <span class="sk-bw__num" data-u="s">{{ bw_s | prepend: '0' | slice: -2, 2 }}</span>
                <span class="sk-bw__unit-label">sek</span>
              </span>
            </p>
            {%- if bw_end_text != blank -%}
              <p class="sk-bw__countdown-until">Til {{ bw_end_text }} kl. 23.59</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if bw_cta_label != blank -%}
          <p class="sk-bw__cta-wrap">
            <a class="sk-bw__cta" href="{{ bw_cta_url }}">{{ bw_cta_label | escape }}</a>
          </p>
        {%- endif -%}

        <ul class="sk-bw__trust">
          {%- if section.settings.trust_1 != blank -%}
            <li class="sk-bw__trust-item">{{ section.settings.trust_1 | escape }}</li>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <li class="sk-bw__trust-item">{{ section.settings.trust_2 | escape }}</li>
          {%- endif -%}
        </ul>

        {%- if bw_terms != blank -%}
          <p class="sk-bw__terms">{{ bw_terms | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      Julegave-pakken: settet fra Temainnstillinger → Black Week → «Pakken».
      Vises bare når pakken selv er satt ned i Shopify. Tallene kommer fra
      pakkeproduktet, samme vei som hovedtilbudet (sk-bw-offer, which: 'pakke').
    {%- endcomment -%}
    {%- capture bwg_sale -%}{%- render 'sk-bw-offer', which: 'pakke', part: 'salg' -%}{%- endcapture -%}
    {%- if section.settings.show_gift and bwg_sale contains '1' -%}
      {%- capture bwg_price -%}{%- render 'sk-bw-offer', which: 'pakke', part: 'pris' -%}{%- endcapture -%}
      {%- capture bwg_was -%}{%- render 'sk-bw-offer', which: 'pakke', part: 'for' -%}{%- endcapture -%}
      {%- capture bwg_save -%}{%- render 'sk-bw-offer', which: 'pakke', part: 'spar' -%}{%- endcapture -%}
      {%- liquid
        assign bwg_p = settings.bw_pakke
        assign bwg_name = bwg_p.title | split: ' – ' | first | remove: 'Skinora® ' | remove: 'Skinora '
        assign bwg_heading = section.settings.gift_heading | replace: '[pakke]', bwg_name | replace: '[pris]', bwg_price
        assign bwg_cta = section.settings.gift_cta | replace: '[pakke]', bwg_name
      -%}
      <div class="sk-bw__gift-wrap page-width">
        <div class="sk-bw__gift">
          {%- if bwg_p.featured_image != blank -%}
            <a class="sk-bw__gift-media" href="{{ bwg_p.url }}" tabindex="-1" aria-hidden="true">
              {{-
                bwg_p.featured_image
                | image_url: width: 600
                | image_tag:
                  class: 'sk-bw__img',
                  loading: 'lazy',
                  widths: '240, 360, 600',
                  sizes: '(min-width: 990px) 240px, 90vw',
                  alt: bwg_p.featured_image.alt
              -}}
            </a>
          {%- endif -%}
          <div class="sk-bw__gift-body">
            <p class="sk-bw__eyebrow">{{ section.settings.gift_eyebrow }}</p>
            <h3 class="sk-bw__gift-title">{{ bwg_heading | escape }}</h3>
            {%- if section.settings.gift_lede != blank -%}
              <p class="sk-bw__lede">{{ section.settings.gift_lede | escape }}</p>
            {%- endif -%}
            <p class="sk-bw__prices sk-bw__prices--gift">
              <span class="sk-bw__now sk-bw__now--gift"><span class="visually-hidden">Nå:</span> {{ bwg_price }}</span>
              <s class="sk-bw__was"><span class="visually-hidden">Før:</span> {{ bwg_was }}</s>
              <span class="sk-bw__save">Spar {{ bwg_save }}</span>
            </p>
            {%- if bwg_cta != blank -%}
              <p class="sk-bw__cta-wrap">
                <a class="sk-bw__cta sk-bw__cta--outline" href="{{ bwg_p.url }}">{{ bwg_cta | escape }}</a>
              </p>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>

  <script>
    (function () {
      var root = document.getElementById('sk-bw-{{ section.id }}');
      if (!root) return;
      var end = parseInt(root.getAttribute('data-end-ts'), 10) * 1000;
      var clock = root.querySelector('[data-sk-bw-clock]');
      if (!end || !clock) return;

      var cells = {};
      ['d', 'h', 'm', 's'].forEach(function (k) {
        cells[k] = clock.querySelector('[data-u="' + k + '"]');
      });
      function pad(n) {
        return n < 10 ? '0' + n : String(n);
      }

      var timer;
      function tick() {
        var left = Math.floor((end - Date.now()) / 1000);
        if (left <= 0) {
          /* Fristen passert mens siden sto åpen: fjern hele seksjonen. Et
             utløpt tilbud er verre enn ingen kampanje. */
          clearInterval(timer);
          root.remove();
          return;
        }
        if (cells.d) cells.d.textContent = Math.floor(left / 86400);
        if (cells.h) cells.h.textContent = pad(Math.floor((left % 86400) / 3600));
        if (cells.m) cells.m.textContent = pad(Math.floor((left % 3600) / 60));
        if (cells.s) cells.s.textContent = pad(left % 60);
      }

      tick();
      timer = setInterval(tick, 1000);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Black Week – tilbud",
  "tag": "section",
  "class": "section sk-bw-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Vises bare mens Black Week går OG produktet er satt ned i Shopify (Temainnstillinger → Black Week). Pris, før-pris og besparelse hentes fra produktet — skriv aldri tall i feltene under. [produkt], [pris] og [spar] byttes ut i overskriften, [periode] og [produkt] i vilkårene."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Overskriftsnivå",
      "options": [
        { "value": "h1", "label": "H1 (egen Black Week-side)" },
        { "value": "h2", "label": "H2 (forside og andre sider)" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Vis produktbildet",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Merke over overskriften",
      "default": "Black Week"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "[produkt] til [pris]"
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Ingress",
      "default": "Prisen er allerede satt ned. Du trenger ingen kode."
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Tekst over nedtellingen",
      "default": "Tilbudet slutter om"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Knappetekst",
      "default": "Kjøp [produkt]"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Knappen lenker til",
      "info": "Tom = produktsiden."
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trygghetslinje 1",
      "default": "Gratis frakt i hele Norge"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trygghetslinje 2",
      "default": "30 dager – pengene for masken tilbake"
    },
    {
      "type": "textarea",
      "id": "terms",
      "label": "Vilkår",
      "default": "Gjelder [produkt] [periode] 2026, så langt lageret rekker."
    },
    {
      "type": "header",
      "content": "Julegave-pakken"
    },
    {
      "type": "checkbox",
      "id": "show_gift",
      "label": "Vis pakken",
      "default": true,
      "info": "Pakken velges i Temainnstillinger → Black Week. Den vises bare når pakken er satt ned i Shopify."
    },
    {
      "type": "text",
      "id": "gift_eyebrow",
      "label": "Merke",
      "default": "Årets julegave"
    },
    {
      "type": "text",
      "id": "gift_heading",
      "label": "Overskrift",
      "default": "[pakke] til [pris]"
    },
    {
      "type": "text",
      "id": "gift_lede",
      "label": "Ingress",
      "default": "Begge maskene i én pakke: én for ansiktet og én for halsen."
    },
    {
      "type": "text",
      "id": "gift_cta",
      "label": "Knappetekst",
      "default": "Kjøp [pakke]"
    }
  ],
  "presets": [
    {
      "name": "Black Week – tilbud"
    }
  ]
}
{% endschema %}
