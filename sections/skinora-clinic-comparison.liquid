{%- comment -%}
  skinora-clinic-comparison.liquid
  --------------------------------
  ROI-anker som en redaksjonell side, ikke en widget. Asymmetrisk:
  ett dominant serif-tall til venstre, rolig merkevare-tekst til høyre,
  bunn-justert. Kun aubergine (--ink-*) på hvit/lavendel (--paper-*).
  Ingen bokser, pills, ✓ eller sentrert stabel. Tall/tekst = section settings.
{%- endcomment -%}

<style>
  .sk-clinic-{{ section.id }} {
    background: {% if section.settings.background_style == 'lavender' %}var(--paper-150){% elsif section.settings.background_style == 'gray' %}var(--paper-50){% else %}var(--paper-0){% endif %};
    padding-block: clamp(var(--space-7, 48px), 7vw, var(--space-9, 96px));
  }

  .sk-clinic-{{ section.id }} .sk-clinic__inner {
    max-width: 78rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: end;
    column-gap: clamp(2.5rem, 6vw, 6rem);
    row-gap: var(--space-5, 24px);
  }

  /* ---------- Det dominante tallet ---------- */
  .sk-clinic-{{ section.id }} .sk-clinic__figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-2, 8px);
    line-height: 0.82;
  }
  .sk-clinic-{{ section.id }} .sk-clinic__num {
    font-family: var(--ff-serif);
    font-size: clamp(64px, 11vw, 132px);
    font-weight: var(--fw-regular);
    letter-spacing: -0.03em;
    color: var(--ink-900);
  }
  .sk-clinic-{{ section.id }} .sk-clinic__unit {
    font-family: var(--ff-serif);
    font-size: clamp(22px, 3vw, 34px);
    font-weight: var(--fw-regular);
    color: var(--ink-900);
  }
  .sk-clinic-{{ section.id }} .sk-clinic__once {
    display: block;
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-500);
    margin-top: var(--space-3, 12px);
  }

  /* ---------- Redaksjonell tekst ---------- */
  .sk-clinic-{{ section.id }} .sk-clinic__body {
    max-width: 34ch;
  }
  .sk-clinic-{{ section.id }} .sk-clinic__lead {
    font-family: var(--ff-sans);
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--ink-500);
    margin: 0 0 var(--space-3, 12px);
    padding-bottom: var(--space-3, 12px);
    border-bottom: 1px solid var(--ink-300);
  }
  .sk-clinic-{{ section.id }} .sk-clinic__kicker {
    font-family: var(--ff-serif);
    font-size: var(--fs-xl);
    font-weight: var(--fw-regular);
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
    margin: 0 0 var(--space-5, 24px);
    text-wrap: balance;
  }

  /* ---------- CTA (understated) ---------- */
  .sk-clinic-{{ section.id }} .sk-clinic__cta.sk-btn--primary {
    width: auto;
    min-width: 26rem;
  }
  .sk-clinic-{{ section.id }} .sk-clinic__guarantee {
    font-family: var(--ff-sans);
    font-size: var(--fs-xs);
    color: var(--ink-400);
    margin: var(--space-3, 12px) 0 0;
  }

  /* ---------- Mobil: stable, tallet først, fortsatt editorial ---------- */
  @media (max-width: 749px) {
    .sk-clinic-{{ section.id }} .sk-clinic__inner {
      grid-template-columns: 1fr;
      align-items: start;
      row-gap: var(--space-4, 16px);
    }
    .sk-clinic-{{ section.id }} .sk-clinic__num {
      font-size: clamp(72px, 26vw, 104px);
    }
    .sk-clinic-{{ section.id }} .sk-clinic__cta.sk-btn--primary {
      width: 100%;
      min-width: 0;
    }
  }
</style>

<section class="sk-clinic-{{ section.id }} sk-clinic" aria-labelledby="sk-clinic-heading-{{ section.id }}">
  <div class="page-width sk-clinic__inner">
    <div class="sk-clinic__figure-wrap">
      <p class="sk-clinic__figure">
        <span class="sk-clinic__num">{{ section.settings.number }}</span>
        <span class="sk-clinic__unit">{{ section.settings.unit }}</span>
      </p>
      {%- if section.settings.once_label != blank -%}
        <span class="sk-clinic__once">{{ section.settings.once_label }}</span>
      {%- endif -%}
    </div>

    <div class="sk-clinic__body">
      {%- if section.settings.lead != blank -%}
        <p class="sk-clinic__lead">{{ section.settings.lead }}</p>
      {%- endif -%}
      {%- if section.settings.kicker != blank -%}
        <p id="sk-clinic-heading-{{ section.id }}" class="sk-clinic__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}

      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <div>
          <a
            href="{{ section.settings.cta_link | default: '#' }}"
            class="sk-btn sk-btn--primary sk-clinic__cta"
            data-analytics="cta_clinic_compare"
          >
            {{ section.settings.cta_label }} →
          </a>
          {%- if section.settings.guarantee_line != blank -%}
            <p class="sk-clinic__guarantee">{{ section.settings.guarantee_line }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Klinikksammenligning",
  "tag": "section",
  "class": "sk-clinic-compare-wrap",
  "settings": [
    {
      "type": "select",
      "id": "background_style",
      "label": "Bakgrunn",
      "options": [
        { "value": "white", "label": "Hvit" },
        { "value": "lavender", "label": "Lavendel" },
        { "value": "gray", "label": "Lys grå" }
      ],
      "default": "lavender"
    },

    { "type": "header", "content": "Tallet" },
    { "type": "text", "id": "number", "label": "Tall", "default": "4 690" },
    { "type": "text", "id": "unit", "label": "Enhet", "default": "kr" },
    { "type": "text", "id": "once_label", "label": "Under tallet", "default": "Én gang" },

    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "lead", "label": "Oppsett-linje (liten, over)", "default": "I klinikken betaler du 800–1 500 kr for hver behandling." },
    { "type": "text", "id": "kicker", "label": "Hovedlinje (serif)", "default": "Skinora koster som noen få økter – så er masken din. Bruk den hjemme, så ofte du vil." },

    { "type": "header", "content": "CTA" },
    { "type": "checkbox", "id": "show_cta", "label": "Vis CTA", "default": true },
    { "type": "text", "id": "cta_label", "label": "Knappetekst", "default": "Prøv risikofritt i 30 dager" },
    { "type": "url", "id": "cta_link", "label": "Knappelenke" },
    { "type": "text", "id": "guarantee_line", "label": "Garanti-linje", "default": "30 dagers åpent kjøp." }
  ],
  "presets": [
    { "name": "Klinikksammenligning", "category": "Skinora landing" }
  ]
}
{% endschema %}
