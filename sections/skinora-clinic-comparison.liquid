{%- comment -%}
  skinora-clinic-comparison.liquid
  --------------------------------
  ROI-anker som en rolig redaksjonell linje, ikke en widget. Asymmetrisk:
  ett tall (engangsprisen) til venstre, kort merkevare-tekst til høyre.
  Bruker SAMME system som naboseksjonene (sk-base.css): --sk-font-size-*,
  --sk-color-*, --color-brand, --font-heading/body-family. Ingen skrikende
  px-størrelser, ingen --ink-*/--fs-* (de hører til LP-seksjonene).
  Tall/tekst = section settings.
{%- endcomment -%}

<style>
  .sk-clinic-{{ section.id }} {
    --clinic-fg: rgb(var(--color-foreground));
    --clinic-muted: rgba(var(--sk-color-body-text), 0.8);
    --clinic-faint: rgba(var(--sk-color-body-text), 0.55);
    --clinic-line: rgba(var(--sk-color-body-text), 0.16);
    background: {% if section.settings.background_style == 'lavender' %}var(--paper-150){% elsif section.settings.background_style == 'gray' %}var(--paper-50){% else %}var(--paper-0){% endif %};
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .sk-clinic-{{ section.id }} .sk-clinic__inner {
    max-width: 62rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: center;
    column-gap: clamp(2rem, 5vw, 4rem);
    row-gap: var(--sk-gap-md, 24px);
  }

  /* ---------- Tallet: anker, ikke skrik (≈ seksjons-H1) ---------- */
  .sk-clinic-{{ section.id }} .sk-clinic__figure {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    line-height: 1;
    margin: 0;
  }
  .sk-clinic-{{ section.id }} .sk-clinic__num {
    font-family: var(--font-heading-family);
    font-size: var(--sk-font-size-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-brand);
  }
  .sk-clinic-{{ section.id }} .sk-clinic__unit {
    font-family: var(--font-heading-family);
    font-size: var(--sk-font-size-large);
    font-weight: 600;
    color: var(--color-brand);
  }
  .sk-clinic-{{ section.id }} .sk-clinic__once {
    display: block;
    font-family: var(--font-body-family);
    font-size: var(--sk-section-eyebrow-size);
    font-weight: 600;
    letter-spacing: var(--sk-section-eyebrow-spacing);
    text-transform: uppercase;
    color: var(--clinic-faint);
    margin-top: 0.7rem;
  }

  /* ---------- Redaksjonell tekst ---------- */
  .sk-clinic-{{ section.id }} .sk-clinic__body {
    max-width: 42ch;
  }
  .sk-clinic-{{ section.id }} .sk-clinic__lead {
    font-family: var(--font-body-family);
    font-size: var(--sk-font-size-xxs);
    line-height: var(--sk-line-height-tight);
    color: var(--clinic-muted);
    margin: 0 0 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--clinic-line);
  }
  .sk-clinic-{{ section.id }} .sk-clinic__kicker {
    font-family: var(--font-heading-family);
    font-size: var(--sk-font-size-small);
    font-weight: 600;
    line-height: 1.3;
    color: var(--clinic-fg);
    margin: 0 0 1.6rem;
    text-wrap: balance;
  }

  /* ---------- CTA (understated) ---------- */
  .sk-clinic-{{ section.id }} .sk-clinic__cta.sk-btn--primary {
    width: auto;
  }
  .sk-clinic-{{ section.id }} .sk-clinic__guarantee {
    font-family: var(--font-body-family);
    font-size: var(--sk-font-size-xxs);
    color: var(--clinic-faint);
    margin: 0.9rem 0 0;
  }

  /* ---------- Mobil: stable, tallet først ---------- */
  @media (max-width: 749px) {
    .sk-clinic-{{ section.id }} {
      padding-block: clamp(2.5rem, 8vw, 3.5rem);
    }
    .sk-clinic-{{ section.id }} .sk-clinic__inner {
      grid-template-columns: 1fr;
      align-items: start;
      row-gap: var(--sk-gap-sm, 16px);
    }
    .sk-clinic-{{ section.id }} .sk-clinic__num {
      font-size: var(--sk-font-size-large);
    }
    .sk-clinic-{{ section.id }} .sk-clinic__unit {
      font-size: var(--sk-font-size-medium);
    }
    .sk-clinic-{{ section.id }} .sk-clinic__cta.sk-btn--primary {
      width: 100%;
    }
  }
</style>

{%- liquid
  # Prisen er IKKE hardkodet: tom «number»-innstilling => hent produktets pris.
  # Samme format som kjøpsboksen (money_without_trailing_zeros = «4 690 kr»),
  # men vi stripper valutaen siden enheten står i sin egen span.
  assign clinic_number = section.settings.number
  if clinic_number == blank and product
    assign clinic_number = product.price | money_without_trailing_zeros | remove: 'kr' | remove: 'NOK' | remove: ',-' | strip
  endif

  # CTA-lenke: tom => dette produktets side. Gjør seksjonen gjenbrukbar
  # på et hvilket som helst produkt uten å sette lenken manuelt.
  assign clinic_cta_link = section.settings.cta_link
  if clinic_cta_link == blank and product
    assign clinic_cta_link = product.url
  endif
-%}

<section class="sk-clinic-{{ section.id }} sk-clinic section" aria-labelledby="sk-clinic-heading-{{ section.id }}">
  <div class="page-width sk-clinic__inner">
    <div class="sk-clinic__figure-wrap">
      <p class="sk-clinic__figure">
        <span class="sk-clinic__num">{{ clinic_number }}</span>
        <span class="sk-clinic__unit">{{ section.settings.unit }}</span>
      </p>
      {%- if section.settings.once_label != blank -%}
        <span class="sk-clinic__once">{{ section.settings.once_label }}</span>
      {%- endif -%}
    </div>

    <div class="sk-clinic__body">
      {%- if section.settings.lead != blank -%}
        <p class="sk-clinic__lead">{{ section.settings.lead }}</p>
      {%- endif -%}
      {%- if section.settings.kicker != blank -%}
        <p id="sk-clinic-heading-{{ section.id }}" class="sk-clinic__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}

      {%- if section.settings.show_cta and section.settings.cta_label != blank -%}
        <div>
          <a
            href="{{ clinic_cta_link | default: '#' }}"
            class="sk-btn sk-btn--primary sk-clinic__cta"
            data-analytics="cta_clinic_compare"
          >
            {{ section.settings.cta_label }} →
          </a>
          {%- if section.settings.guarantee_line != blank -%}
            <p class="sk-clinic__guarantee">{{ section.settings.guarantee_line }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Klinikksammenligning",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "background_style",
      "label": "Bakgrunn",
      "options": [
        { "value": "white", "label": "Hvit" },
        { "value": "lavender", "label": "Lavendel" },
        { "value": "gray", "label": "Lys grå" }
      ],
      "default": "lavender"
    },

    { "type": "header", "content": "Tallet" },
    { "type": "paragraph", "content": "La «Tall» stå tomt for å hente produktets pris automatisk (anbefalt). Fyll bare inn hvis du vil overstyre." },
    { "type": "text", "id": "number", "label": "Tall (tom = produktets pris)" },
    { "type": "text", "id": "unit", "label": "Enhet", "default": "kr" },
    { "type": "text", "id": "once_label", "label": "Under tallet", "default": "Én gang" },

    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "lead", "label": "Oppsett-linje (liten, over)", "default": "I klinikken betaler du 800–1 500 kr for hver behandling." },
    { "type": "text", "id": "kicker", "label": "Hovedlinje (serif)", "default": "Skinora koster som noen få økter – så er masken din. Bruk den hjemme, så ofte du vil." },

    { "type": "header", "content": "CTA" },
    { "type": "checkbox", "id": "show_cta", "label": "Vis CTA", "default": true },
    { "type": "text", "id": "cta_label", "label": "Knappetekst", "default": "Prøv risikofritt i 30 dager" },
    { "type": "url", "id": "cta_link", "label": "Knappelenke" },
    { "type": "text", "id": "guarantee_line", "label": "Garanti-linje", "default": "30 dagers åpent kjøp." }
  ],
  "presets": [
    { "name": "Klinikksammenligning", "category": "Skinora landing" }
  ]
}
{% endschema %}
