<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
{%- comment -%}
  component-cart-notification.css er fjernet. Butikken bruker cart drawer
  (settings_data cart_type: "drawer"), saa varselet ble aldri rendret —
  den eneste `render 'cart-notification'` sto inne i snippetens egen
  kommentarblokk. CSS-en ble likevel lastet paa hver eneste sidevisning.
{%- endcomment -%}

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{{ 'section-header.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .header {
    padding: 9px 5px;
  }

  .section-header {
    position: sticky;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
  }
{%- endstyle -%}

{% liquid
  assign header_tag = 'div'
  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper header-wrapper--sk color-{{ section.settings.color_scheme }}{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  <header class="header sk-header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }}">
    <div class="sk-header__grid">
      <!-- LEFT: NAV + DRAWER -->
      {% render 'header-drawer' %}

      {% if section.settings.menu != blank %}
        {%- assign nav_links_count = section.settings.menu.links | size -%}
        <nav class="header__menu small-hide">
          {% case section.settings.menu_type_desktop %}
            {% when 'dropdown', 'drawer' %}
              {% render 'header-dropdown-menu',
                nav_limit: nav_links_count,
                nav_variant_class: 'sk-header__inline-menu sk-header__inline-menu--primary'
              %}
            {% when 'mega' %}
              {% render 'header-mega-menu',
                nav_limit: nav_links_count,
                nav_variant_class: 'sk-header__inline-menu sk-header__inline-menu--primary'
              %}
          {% endcase %}
        </nav>
      {% endif %}

      <!-- CENTER: LOGO -->
      <div class="sk-header__brand">
        <a
          href="{{ routes.root_url }}"
          class="header__heading-link link link--text"
          aria-label="{{ shop.name }}"
        >
          <div class="header__heading-logo-wrapper" style="--header-logo-width: {{ settings.logo_width }}px;">
            {{ 'custom-logo.svg' | inline_asset_content }}
          </div>
        </a>
      </div>

      <!-- RIGHT: ICONS -->
      <div class="header__icons">
        {% render 'header-search', input_id: 'Search-In-Modal' %}

        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="header__icon header__icon--account link focus-inset small-hide"
            rel="nofollow"
            aria-label="{{ 'customer.account_fallback' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
          </a>
        {%- endif -%}

        {%- comment -%} Produktveiviser: knapp ved handlekurven (skjult på minste skjerm – ligger også i menyskuffen) {%- endcomment -%}
        {%- unless request.page_type == 'cart' -%}
          {% render 'sk-quiz-trigger', style: 'pill', placement: 'header', classes: 'sk-quiz-trigger--header', label: 'Finn din maske', label_short: 'Quiz' %}
        {%- endunless -%}

        <a
          href="{{ routes.cart_url }}"
          class="header__icon header__icon--cart link focus-inset"
          id="cart-icon-bubble"
          aria-label="{{ 'sections.cart.title' | t }} ({{ cart.item_count }})"
        >
          <span class="svg-wrapper{% if cart == empty %} cart-empty{% endif %}">
            {{ 'icon-cart-empty.svg' | inline_asset_content }}
          </span>
          {% if cart != empty %}
            <div class="cart-count-bubble">
              <span aria-hidden="true">{{ cart.item_count }}</span>
            </div>
          {% endif %}
        </a>
      </div>
    </div>
  </header>
  {%- comment -%}
    Mobil-CTA-raden for quizen er fjernet: den tok en hel linje over folden på
    hver eneste side. Quizen nås fortsatt fra menyskuffen på mobil, og fra
    header-pillen på desktop. Snippeten støtter fortsatt part:'bar' – re-aktiver
    ved å sette inn render-kallet her igjen (CSS-en ligger i sk-quiz.css).
  {%- endcomment -%}
</{{ header_tag }}>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "default": 20,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 36,
      "step": 4,
      "unit": "px",
      "default": 20,
      "label": "Bottom padding"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "Margin bottom"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "Show separator line"
    },
    {
      "type": "select",
      "id": "menu_type_desktop",
      "default": "dropdown",
      "options": [
        { "value": "dropdown", "label": "Dropdown" },
        { "value": "mega", "label": "Mega menu" },
        { "value": "drawer", "label": "Drawer" }
      ],
      "label": "Desktop menu type"
    }
  ]
}
{% endschema %}

<script>
  (function () {
    const HOVER_DELAY = 160;

    function bindHoverMenus(root) {
      const detailNodes = root.querySelectorAll('.sk-header header-menu details');
      detailNodes.forEach((detailsEl) => {
        if (detailsEl.dataset.hoverBound === 'true') return;
        detailsEl.dataset.hoverBound = 'true';

        let closeTimer;

        const openMenu = () => {
          clearTimeout(closeTimer);
          detailsEl.dataset.hover = 'true';
          detailsEl.open = true;
        };

        const scheduleClose = () => {
          clearTimeout(closeTimer);
          closeTimer = setTimeout(() => {
            detailsEl.dataset.hover = 'false';
            detailsEl.removeAttribute('data-hover');
            detailsEl.open = false;
          }, HOVER_DELAY);
        };

        detailsEl.addEventListener('mouseenter', openMenu);
        detailsEl.addEventListener('mouseleave', scheduleClose);
        detailsEl.querySelector('summary')?.addEventListener('focus', openMenu);
        detailsEl.addEventListener('focusout', (event) => {
          if (!detailsEl.contains(event.relatedTarget)) {
            scheduleClose();
          }
        });
      });
    }

    function initHoverMenus() {
      const root = document;
      bindHoverMenus(root);
    }

    document.addEventListener('DOMContentLoaded', initHoverMenus);
    document.addEventListener('shopify:section:load', (event) => {
      bindHoverMenus(event.target);
    });
  })();
</script>
