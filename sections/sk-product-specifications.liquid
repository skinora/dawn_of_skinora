{% comment %}
  SECTION: Skinora – Product Specifications (Metaobject-driven)

  Metaobject type handle: product_specification (MUST match Shopify exactly)
  Fields:
  - section_header (single line text)
  - subheader (single line text)
  - main_image (file/image)        <-- used as poster / fallback
  - image_alt (single line text)
  - tech_details_blocks (list of metaobjects: tech_details_block)
      - title (single line)
      - content (rich text)
      - icon (file/image)
  - tech_spec_detailed_description (rich text)
  - tech_spec_ai_seo (rich text, hidden)

  3D: Product media (GLB) is rendered natively via Shopify media_tag (best UX).

  FIXES (stable):
  1) If odd number of cells, last cell spans full width on desktop.
  2) Any block with rich text content spans both columns on desktop.

  PATCH (important):
  - Product metafield reference MUST win over section.settings override.
    Otherwise one selected metaobject in Theme Editor can override all products.
{% endcomment %}

{{ 'section-sk-product-specifications.css' | asset_url | stylesheet_tag }}

{% liquid
  assign spec = null

  assign product_spec = null
  assign product_spec_wrapper = null
  if product
    assign product_spec_wrapper = product.metafields.custom.product_specification_wrapper.value

    comment
      Wrapper strategy:
      - Some products store a wrapper metaobject which then references the real product_specification.
      - We try a few common field names so the theme works even if the wrapper schema differs.
    endcomment
    if product_spec_wrapper != blank
      if product_spec_wrapper.system.type == 'product_specification'
        assign product_spec = product_spec_wrapper
      elsif product_spec_wrapper.product_specification != blank
        assign product_spec = product_spec_wrapper.product_specification.value
      elsif product_spec_wrapper.specification != blank
        assign product_spec = product_spec_wrapper.specification.value
      elsif product_spec_wrapper.spec != blank
        assign product_spec = product_spec_wrapper.spec.value
      elsif product_spec_wrapper.product_spec != blank
        assign product_spec = product_spec_wrapper.product_spec.value
      endif
    endif
  endif

  assign section_spec = null
  if section.settings.specification != blank
    assign section_spec = section.settings.specification
  endif

  comment
    Spec selection:
    - On product pages: use product metafield wrapper only.
    - Outside product context: allow section setting (useful for previews/non-product templates).
  endcomment
  if product
    if product_spec != blank
      assign spec = product_spec
    else
      assign spec = null
    endif
  elsif section_spec != blank
    assign spec = section_spec
  endif

  assign blocks = blank
  if spec != blank and spec.tech_details_blocks != blank
    assign blocks = spec.tech_details_blocks.value
  endif

  assign img = blank
  if spec != blank and spec.main_image != blank
    assign img = spec.main_image.value
  endif

  assign product_model = blank
  if product
    assign product_model = product.media | where: 'media_type', 'model' | first
  endif
%}

{% if spec != blank %}
  <section
    class="sk-product-specifications sk-specs-{{ section.id }}"
  >
    <div class="page-width sk-specs__wrap">
      <!-- Left: Media -->
      <div class="sk-specs__media">
        {% if product_model != blank %}
          {{ product_model | media_tag: class: 'sk-specs__model-media', image_size: '1200x' }}

          <div id="sk-hint-{{ section.id }}" class="sk-specs__hint" aria-hidden="true">
            <span class="sk-specs__hint-dot"></span>
            <span>Trykk og dra for å rotere</span>
          </div>

          <script>
            (function () {
              var wrap = document.querySelector('.sk-specs-{{ section.id }} .sk-specs__media');
              if (!wrap) return;

              var modelViewer = wrap.querySelector('model-viewer');
              if (modelViewer) {
                /* media_tag hard-coder background-color:#000000 inline på model-viewer;
                   nulles ut her (kan ikke overstyres i CSS uten !important) slik at
                   .sk-specs__media sin lyse bakgrunn vises. --poster-color røres ikke. */
                modelViewer.style.backgroundColor = 'transparent';

                /* Shopify-genererte poster-JPEG for 3D-modellen har helsvart bakgrunn
                   bakt inn i selve bildefilen — fjernes så den lyse bakgrunnen vises
                   under lasting og den transparente 3D-canvasen etterpå.
                   MEN: removeAttribute('poster') + dismissPoster() trigger EAGER
                   last av .glb + model-viewer-runtime. Kjørte vi det på sidelast,
                   ble hele modellen (flere MB) lastet med en gang selv om seksjonen
                   er langt nede på siden — det var tregheten. Utsett til seksjonen
                   nærmer seg viewporten via IntersectionObserver. */
                var activateModel = function () {
                  modelViewer.removeAttribute('poster');
                  if (typeof modelViewer.dismissPoster === 'function') {
                    modelViewer.dismissPoster();
                  }
                };
                if ('IntersectionObserver' in window) {
                  var io = new IntersectionObserver(function (entries, obs) {
                    for (var k = 0; k < entries.length; k++) {
                      if (entries[k].isIntersecting) {
                        obs.disconnect();
                        activateModel();
                        break;
                      }
                    }
                  }, { rootMargin: '300px 0px' });
                  io.observe(wrap);
                } else {
                  activateModel();
                }
              }

              var hint = document.getElementById('sk-hint-{{ section.id }}');
              if (!hint) return;

              var mq = window.matchMedia && window.matchMedia('(max-width: 990px)');

              var hidden = false;
              var hide = function () {
                if (hidden) return;
                hidden = true;
                hint.classList.add('is-hidden');
              };

              var applyMobileZoom = function () {
                if (!modelViewer || !mq || !mq.matches) return;

                try {
                  if (typeof modelViewer.getCameraOrbit === 'function') {
                    var orbit = modelViewer.getCameraOrbit();
                    if (orbit && typeof orbit.radius === 'number' && orbit.radius > 0) {
                      var nextRadius = orbit.radius * 0.85;
                      modelViewer.setAttribute(
                        'camera-orbit',
                        orbit.theta + 'rad ' + orbit.phi + 'rad ' + nextRadius + 'm'
                      );
                      return;
                    }
                  }

                  modelViewer.setAttribute('camera-orbit', '0deg 75deg 2.6m');
                } catch (e) {
                  // no-op
                }
              };

              if (modelViewer) {
                modelViewer.addEventListener('load', applyMobileZoom);
              }

              wrap.addEventListener('pointerdown', hide, { passive: true });
              wrap.addEventListener('touchstart', hide, { passive: true });
              wrap.addEventListener('mousedown', hide);

              setTimeout(hide, 5500);
            })();
          </script>

        {% elsif img != blank %}
          <img
            class="sk-specs__img"
            src="{{ img | image_url: width: 1200 }}"
            alt="{{ spec.image_alt | default: product.title | escape }}"
            loading="lazy"
            width="{{ img.width }}"
            height="{{ img.height }}"
          >
        {% elsif product and product.featured_image != blank %}
          <img
            class="sk-specs__img"
            src="{{ product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.title | escape }}"
            loading="lazy"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
          >
        {% endif %}
      </div>

      <!-- Right: Content -->
      <div class="sk-specs__content">
        {% if spec.section_header != blank %}
          <h2 class="sk-specs__h">{{ spec.section_header }}</h2>
        {% endif %}

        {% if spec.subheader != blank %}
          <p class="sk-specs__sub">{{ spec.subheader }}</p>
        {% endif %}

        {% if blocks != blank and blocks.size > 0 %}
          <div class="sk-specs__card" role="region" aria-label="Hovedspesifikasjoner">
            <div class="sk-specs__grid">
              {% for b in blocks %}
                {% assign is_rich = false %}
                {% if b.content != blank %}
                  {% assign is_rich = true %}
                {% endif %}

                {% assign has_inline_list = false %}
                {% if is_rich %}
                  {% capture sk_specs_content_html %}{{ b.content | metafield_tag }}{% endcapture %}
                  {% if sk_specs_content_html contains '<ul' or sk_specs_content_html contains '<ol' %}
                    {% assign has_inline_list = true %}
                  {% endif %}
                {% endif %}

                <div class="sk-specs__cell{% if is_rich %} sk-specs__cell--wide{% endif %}{% if has_inline_list %} sk-specs__cell--inline-list{% endif %}">
                  <div class="sk-specs__icon">
                    {% assign icon_img = b.icon.value %}
                    {% if icon_img != blank %}
                      <img
                        src="{{ icon_img | image_url: width: 80 }}"
                        alt=""
                        loading="lazy"
                        width="24"
                        height="24"
                      >
                    {% else %}
                      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
                        <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z"/>
                      </svg>
                    {% endif %}
                  </div>

                  <div class="sk-specs__text">
                    {% if b.title != blank %}
                      <div class="sk-specs__title">{{ b.title }}</div>
                    {% endif %}

                    {% if b.content != blank %}
                      <div class="sk-specs__desc">
                        {{ b.content | metafield_tag }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>

            {% if spec.tech_spec_detailed_description != blank %}
              <details class="sk-specs__details">
                <summary class="sk-specs__summary">
                  <span>Tekniske detaljer</span>
                  <span class="sk-specs__chev" aria-hidden="true"></span>
                </summary>
                <div class="sk-specs__details-body">
                  {{ spec.tech_spec_detailed_description | metafield_tag }}

                  {% if spec.tech_spec_ai_seo != blank %}
                    <div class="visually-hidden">
                      {{ spec.tech_spec_ai_seo | metafield_tag }}
                    </div>
                  {% endif %}
                </div>
              </details>
            {% endif %}
          </div>
        {% elsif spec.tech_spec_detailed_description != blank %}
          <div class="sk-specs__card">
            <details class="sk-specs__details" open>
              <summary class="sk-specs__summary">
                <span>Tekniske detaljer</span>
                <span class="sk-specs__chev" aria-hidden="true"></span>
              </summary>
              <div class="sk-specs__details-body">
                {{ spec.tech_spec_detailed_description | metafield_tag }}

                {% if spec.tech_spec_ai_seo != blank %}
                  <div class="visually-hidden">
                    {{ spec.tech_spec_ai_seo | metafield_tag }}
                  </div>
                {% endif %}
              </div>
            </details>
          </div>
        {% endif %}
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "SK-Tech-spec",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "specification",
      "label": "Product specification (metaobject)",
      "metaobject_type": "product_specification"
    }
  ],
  "presets": [
    {
      "name": "SK-Tech-spec (metaobject)"
    }
  ]
}
{% endschema %}
