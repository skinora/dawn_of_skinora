<style>
  .sk-promotion-logos__container {
    background: {{ section.settings.sk_promotion_bgColor }};
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .sk-promotion-logos {
    margin: 0 1rem;
  }

  .sk-promotion-logos__heading {
    text-align: center;
    margin: 0 0 24px;
    color: rgb(var(--sk-color-heading-text));
  }
</style>

<style>
  .sw-publication-{{ section.id }}{
    margin: clamp(1rem, 2vw, 1.75rem) 0;
    overflow: clip; /* clip instead of hidden — prevents iOS Safari from creating a scrollable container */
    position: relative;
  }
  .sw-publication-{{ section.id }} .sw-publication__scroll-parent {
      position: relative;
      width: 100%;
      height: 10rem;
      overflow: clip; /* clip instead of hidden — prevents iOS touch-scroll through overflowing children */
      margin: 15px 0;
  }

  .sw-publication-{{ section.id }} .sw-publication__scroll-element {
      width: inherit;
      height: inherit;
      position: absolute;
      left: 0%;
      top: 0%;
      display: flex;
      align-items: center;
      justify-content: space-around;
  }
  .sw-publication-{{ section.id }} .sw-publication__scroll-element .sw-publication__card{
      flex: 0 0 100px
  }

  /* SKINORA mellombredder – kan fjernes ────────────────────────────────
     Marqueen har to spor som skal flislegges sømløst: primary går
     0 → -100 %, secondary går 100 % → 0. Begge er `width: inherit`,
     altså 100 % av forelderen — men innholdet er 11 kort à faste 100 px,
     altså 1100 px.

     Er forelderen smalere enn 1100 px, er sporene for smale for sitt eget
     innhold, og slutten av det ene renner inn i starten av det andre.
     Målt 26. aug 2026 ved 1009 px: spor 994 px, innhold 1100 px, 3 kort
     overlapper hverandre synlig.

     Mobilreglene under løser det samme ved å blåse opp forelderen til
     140 % og 208 %. Mellom 750 px og ~1115 px fantes ingen tilsvarende
     regel — seksjonen har ingen breakpoints over 749 px.

     max-content lar sporet være nøyaktig så bredt som kortene krever, så
     translateX(-100%) flytter det nøyaktig én innholdsbredde og flisene
     møtes kant i kant. Merkene beholder sine 100 px; raden ruller, som
     den allerede gjør.

     Over 1150 px får innholdet plass i 100 % og space-around fordeler
     dem jevnt — derfor stopper regelen der. */
  @media screen and (min-width: 750px) and (max-width: 1150px) {
    .sw-publication-{{ section.id }} .sw-publication__scroll-element {
      width: max-content;
    }
  }
  .sw-publication-{{ section.id }} .sw-publication__scroll-element .sw-publication__card img,
  .sw-publication-{{ section.id }} .sw-publication__scroll-element .sw-publication__card svg{
      width:100%;
      height: auto;
      display: block;
  }

  .primary {
      animation: primary 110s linear infinite;
  }

  .secondary {
      animation: secondary 110s linear infinite;
  }

  @keyframes primary {
      from {

          transform: translateX(0);
      }
      to {

          transform: translateX(-100%);
      }
  }

  @keyframes secondary {
      from {

          transform: translateX(100%);
      }
      to {

          transform: translateX(0);
      }
  }



  @media only screen and (max-width: 700px) {
    .sw-publication-{{ section.id }} .sw-publication__scroll-element .sw-publication__card{
      flex: 0 0 74px
    }
    .sw-publication-{{ section.id }} .sw-publication__scroll-parent{
      width: 140%;
      height: 7rem;
    }
  }


  @media only screen and (max-width: 435px) {
    .sw-publication-{{ section.id }} .sw-publication__scroll-element .sw-publication__card{
      flex: 0 0 66px
    }
    .sw-publication-{{ section.id }} .sw-publication__scroll-parent{
      width: 208%;
    }
  }
  @media screen and (max-width: 749px) {
    .sk-section-heading {
      font-size: var(--sk-mobile-heading-size);
      line-height: var(--sk-mobile-heading-line);
    }
  }
</style>

<section class="sw-publication-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="sk-section-heading sk-section-heading--h1 sk-promotion-logos__heading">
      {{ section.settings.heading | escape }}
    </h2>
  {% endif %}
  <div class="sw-publication__scroll-parent">
    <div class="sw-publication__scroll-element primary">
      {% for block in section.blocks %}
        <div class="sw-publication__card ">
          {% if block.settings.sk_promotion_svg != blank %}
            {{ block.settings.sk_promotion_svg }}
          {% elsif block.settings.sk_promotion_img != blank %}
            <img
              src="{{ block.settings.sk_promotion_img | image_url: width: 104, height: 104 }}"
              alt="{{ block.settings.sk_promotion_img.alt }}"
              width="104"
              height="104"
            >
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="sw-publication__scroll-element secondary">
      {% for block in section.blocks %}
        <div class="sw-publication__card">
          {{ block.settings.sk_promotion_svg }}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SK Promotion",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    },
    {
      "type": "color",
      "id": "sk_promotion_bgColor",
      "label": "Background Color",
      "default": "#fff"
    }
  ],
  "blocks": [
    {
      "name": "Logo",
      "type": "Card",
      "settings": [
        {
          "type": "html",
          "id": "sk_promotion_svg",
          "label": "SVG Code",
          "info": "Paste your SVG code here. This will be used instead of the image picker if provided."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK Promotion",
      "category": "Custom"
    }
  ]
}
{% endschema %}
