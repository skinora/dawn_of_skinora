{%- comment -%}
  CLS guard — reserves 100vh for the section wrapper immediately.
  Prevents layout shift from late-applied .sk-dynamic-banner { height:100vh }.
  contain:layout style scopes reflows to this subtree.
{%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} {
    min-height: 100vh;
    contain: layout style;
  }

  /* Vakten må matche heroens FAKTISKE høyde. Under 435px settes heroen til
     80vh, mens wrapperen sto igjen på 100vh – de 20vh differanse ble et tomt
     hvitt felt mellom hero og logostripen. Over 435px er heroen 100vh, så
     vakten stemmer allerede der. */
  @media (max-width: 435px) {
    #shopify-section-{{ section.id }} {
      min-height: 80vh;
    }
  }
</style>

{%- comment -%}
  Preload the LCP background image — media-scoped so each device fetches
  ONLY the variant its CSS breakpoint will actually paint. The previous
  approach (hidden <img> + image_tag preload:true) downloaded all three
  variants on every device because neither the rendered <img> tags nor
  Shopify's injected preload links carry a media condition.
  Media ranges mirror the CSS breakpoints below (700px / 1000px).
{%- endcomment -%}
{%- if section.settings.sk_banner_img_mobile != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ section.settings.sk_banner_img_mobile | image_url: width: 750 }}"
    media="(max-width: 700px)"
    fetchpriority="high"
  >
{%- endif -%}
{%- if section.settings.sk_banner_img_tablet != blank -%}
  <link
    rel="preload"
    as="image"
    href="{{ section.settings.sk_banner_img_tablet | image_url: width: 1200 }}"
    media="(min-width: 700.02px) and (max-width: 1000px)"
    fetchpriority="high"
  >
{%- endif -%}
{%- if section.settings.sk_banner_img_desktop != blank -%}
  {%- comment -%} No tablet image → desktop bg paints from 700px up; widen the preload range to match. {%- endcomment -%}
  {%- if section.settings.sk_banner_img_tablet != blank -%}
    {%- assign desktop_preload_media = '(min-width: 1000.02px)' -%}
  {%- else -%}
    {%- assign desktop_preload_media = '(min-width: 700.02px)' -%}
  {%- endif -%}
  <link
    rel="preload"
    as="image"
    href="{{ section.settings.sk_banner_img_desktop | image_url: width: 1600 }}"
    media="{{ desktop_preload_media }}"
    fetchpriority="high"
  >
{%- endif -%}

<style>
  .sk-dynamic-banner {
    background-image: url('{{ section.settings.sk_banner_img_desktop | image_url: width: 1600 }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    width: 100%;
    height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: clamp(2rem, 5vh, 6rem);
    padding-bottom: clamp(2rem, 5vh, 6rem);
  }

  /* WIDER SECTION WRAPPER */
  .sk-dynamic-banner .page-width {
    max-width: 1800px;
    width: 95%;
    margin-inline: auto;
    padding-left: 0;
    padding-right: 0;
  }

  /* TEXT COLUMN = LEFT THIRD, BUT WIDER */
  .sk-dynamic-banner__container {
    display: grid;
    grid-template-columns: minmax(35rem, 40vw) 1fr;
    column-gap: clamp(2rem, 6vw, 8rem);
    width: 100%;
    align-items: center;
  }

  /* TEXT BLOCK — SHIFTED RIGHT BY 80px (DYNAMIC) */
  .sk-dynamic-banner__content {
    width: 100%;
    max-width: 56rem;
    justify-self: start;
    transform: none;
    display: grid;
    gap: clamp(1.6rem, 2.6vw, 3.2rem);
    padding: 0.6rem;
    /* Reserve minimum space to prevent CLS from font fallback differences */
    min-height: 18rem;
  }

  .sk-dynamic-banner__title {
    font-size: clamp(3.36rem, 9.1vw, 7.28rem);
    color: rgb(var(--sk-color-heading-text));
    font-weight: 400;
    line-height: clamp(1.05, 1.15, 1.2);
    margin-bottom: 0;
    letter-spacing: clamp(-0.05rem, -0.35vw, -0.12rem);
    max-width: min(90vw, 60rem);
    word-break: normal;
    overflow-wrap: normal;
    hyphens: manual;
  }

  .sk-dynamic-banner__description {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: var(--fw-regular);
    color: rgba(var(--color-foreground), 0.85);
    letter-spacing: 0.1rem;
    line-height: clamp(1.2, 1.4, 1.5);
    margin-bottom: 0;
    max-width: clamp(32rem, 60vw, 60rem);
    overflow-wrap: normal;
    word-break: normal;
    hyphens: manual;
  }

  /* Kampanjeetikett – samme uppercase/letter-spacing som annonseringsbaren,
     mindre enn h2, i temaets aksentfarge. Ingen rødt, ingen animasjon. */
  .sk-dynamic-banner__eyebrow {
    margin: 0;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-brand, rgb(var(--sk-color-heading-text)));
  }

  /* Tillitsrad under knappen: stjerner + vurdering + betalingslogoer.
     Flex med wrap, så den aldri brekker midt i en setning. */
  /* Tillitsraden er BEVISST to grupper som hver kan legge seg på egen linje:
     [stjerner + vurdering] og [betalingslogoer]. Tidligere hadde vurderingen
     white-space:nowrap og logoene fast bredde, så raden ble bredere enn
     kolonnen og elementene la seg oppå hverandre. Nå krymper tekstgruppa og
     logoene wrapper ned i stedet. */
  .sk-dynamic-banner__trust {
    margin: 0;
    width: 100%;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.45;
    color: rgba(var(--color-foreground), 0.72);
  }

  /* Sosialt bevis skal BRØLE: større stjerner, full metning og fete tall.
     Dette er heroens sterkeste tillitssignal – det tåler å rope. */
  .sk-dynamic-banner__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    flex: 0 0 auto;
    color: var(--accent-gold, #d4a843);
    line-height: 1;
  }

  .sk-dynamic-banner__stars svg {
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 1px 2px rgba(45, 27, 61, 0.18));
  }

  .sk-dynamic-banner__rating {
    flex: 0 1 auto;
    min-width: 0;
    font-size: 1.45rem;
    color: rgb(var(--color-foreground));
  }

  .sk-dynamic-banner__rating strong {
    font-weight: 700;
    font-size: 1.7rem;
    letter-spacing: -0.01em;
  }

  .sk-dynamic-banner__pay {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex: 0 0 auto;
  }

  .sk-dynamic-banner__pay img {
    display: block;
    width: auto;
    height: 16px;
  }

  .sk-dynamic-banner__button .sk-btn {
    font-size: clamp(1rem, 2vw, 1.3rem);
    padding: clamp(0.65rem, 1.8vw, 0.95rem) clamp(1.6rem, 3vw, 2.6rem);
  }

  .sk-dynamic-banner__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    -webkit-mask-image: none;
    mask-image: none;
  }

  /* TABLET */
  @media (max-width: 1000px) {
    .sk-dynamic-banner {
      {%- if section.settings.sk_banner_img_tablet != blank %}
      background-image: url('{{ section.settings.sk_banner_img_tablet | image_url: width: 1200 }}');
      {%- endif %}
      height: 100vh;
    }

    .sk-dynamic-banner__container {
      grid-template-columns: minmax(28rem, 50vw) 1fr;
    }

    .sk-dynamic-banner__content {
      max-width: 40rem;
      padding-right: 3rem;
      min-height: 16rem;
    }

    .sk-dynamic-banner__title {
      font-size: clamp(3.08rem, 12.6vw, 5.6rem);
      letter-spacing: clamp(-0.04rem, -0.4vw, -0.08rem);
    }
  }

  /* MOBILE */
  @media (max-width: 700px) {
    .sk-dynamic-banner {
      {%- if section.settings.sk_banner_img_mobile != blank %}
      background-image: url('{{ section.settings.sk_banner_img_mobile | image_url: width: 750 }}');
      {%- endif %}
      height: 100vh;
      align-items: flex-end;
    }

    .sk-dynamic-banner .page-width,
    .sk-dynamic-banner__container {
      height: 100%;
    }

    .sk-dynamic-banner__container {
      display: flex;
      flex-direction: column;
      text-align: center;
      gap: 2rem;
    }

    .sk-dynamic-banner__content {
      padding-right: 0;
      max-width: 100%;
      transform: none;
      display: flex;
      flex-direction: column;
      gap: clamp(1.4rem, 4.5vw, 2.4rem);
      margin-top: 0;
      margin-inline: auto;
      min-height: 100%;
    }

    .sk-dynamic-banner__title {
      font-size: clamp(2.59rem, 17.5vw, 3.92rem);
      line-height: 1.2;
      max-width: 100%;
      padding-inline: 0.6rem;
      margin-top: 0;
      margin-bottom: 0;
      text-wrap: balance;
      hyphens: auto;
      overflow-wrap: break-word;
      word-break: normal;
    }

    .sk-dynamic-banner__description {
      font-size: clamp(1.1rem, 3.9vw, 1.5rem);
      line-height: 1.4;
      max-width: 100%;
      /* Push description (and the CTA after it) to the bottom of the
         content column so the description sits next to the button.
         Title remains anchored at the top of the bottom-aligned content. */
      margin-top: auto;
    }
    .sk-dynamic-banner__button .sk-btn {
      width: min(280px, 90vw);
      justify-content: center;
    }

    .sk-dynamic-banner--cta-top {
      align-items: flex-end;
    }

    .sk-dynamic-banner--cta-bottom {
      align-items: flex-end;
    }
  }

  @media (max-width: 560px) {
    .sk-dynamic-banner {
      min-height: 80vh;
      padding-top: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .sk-dynamic-banner__content {
      margin-inline: auto;
      transform: none;
    }

    .sk-dynamic-banner__title {
      font-size: clamp(1.75rem, 12.6vw, 2.8rem);
      letter-spacing: -0.02em;
      text-transform: uppercase;
    }

    .sk-dynamic-banner__description {
      font-size: clamp(1.1rem, 5vw, 1.5rem);
      max-width: 100%;
    }

    .sk-dynamic-banner__button .sk-btn {
      width: 100%;
      padding: clamp(0.6rem, 2vw, 0.9rem) clamp(1.4rem, 4vw, 2rem);
      font-size: clamp(0.95rem, 2.5vw, 1.1rem);
    }
  }

  /* Very small phones: scale down a touch more to avoid mid-word wraps */
  @media (max-width: 420px) {
    .sk-dynamic-banner__title {
      font-size: clamp(1.75rem, 11.9vw, 2.73rem);
      letter-spacing: -0.01em;
      hyphens: auto;
      overflow-wrap: break-word;
      word-break: normal;
    }

    .sk-dynamic-banner__description {
      font-size: clamp(0.98rem, 3.6vw, 1.25rem);
    }
  }

  /*
   * CLS guard — mirror deferred-CSS overrides so they apply at first paint.
   * Keeps the same rules in base-deferred.css for specificity/override safety.
   */
  @media (max-width: 1000px) {
    .sk-dynamic-banner__container {
      flex-direction: column-reverse !important;
    }
  }
  @media (max-width: 700px) {
    .sk-dynamic-banner__img {
      width: 360px;
    }
    .sk-dynamic-banner__img img {
      width: 100%;
      height: auto;
    }
    .sk-dynamic-banner__description {
      font-size: var(--sk-font-size-medium);
      line-height: 28px;
    }
    .sk-dynamic-banner__button {
      width: 30rem;
    }
  }
  @media (max-width: 435px) {
    .sk-dynamic-banner {
      height: 84vh;
    }
    .sk-dynamic-banner__description {
      font-size: var(--sk-font-size-xxs);
      line-height: 20px;
    }
    .sk-dynamic-banner__button {
      width: 25rem;
    }
  }

  /* =====================================================================
     MOBIL OVER FOLDEN (Oppgave 7)
     Etikett + overskrift + pris + knapp + tillitslinje skal alle være
     synlige uten scroll ved 390px. Komprimert i den rekkefølgen som ble
     bedt om: hero-høyde → linjeavstand i h2 → brødtekstens størrelse.
     Tillitslinje og brødtekst beholdes.
     ===================================================================== */
  @media (max-width: 700px) {
    /* Ingen gradient-overlay: bildet er lyst nok til at aubergine tekst leser
       fint direkte oppå, og overlayet la en synlig dis over motivet. */
    .sk-dynamic-banner::after {
      content: none;
    }

    .sk-dynamic-banner .page-width {
      position: relative;
      z-index: 1;
    }

    /* Innholdet samles i TOPPEN, over hodene på modellene – der er bakgrunnen
       rolig. Tidligere dyttet en margin-top:auto teksten ned; da jeg nullstilte
       den ble alt liggende øverst med et stort tomrom under. Nå er plasseringen
       et bevisst valg i stedet for en bieffekt. */
    .sk-dynamic-banner {
      align-items: flex-start;
    }

    /* Innholdskolonnen fyller hele heroen: overskrift/tekst/CTA i toppen,
       mens tillitsraden skyves helt ned med margin-top:auto. Da lander den
       på de hvite t-skjortene nederst i bildet – rolig, lys bakgrunn – i
       stedet for oppå håret, der stjernene forsvant. */
    .sk-dynamic-banner__container {
      height: 100%;
    }

    /* Overskrift + brødtekst i toppen; CTA og tillitsrad skyves ned som ÉN
       gruppe til brysthøyde på modellene, der t-skjortene gir rolig, lys
       bakgrunn. margin-top:auto på CTA-en spiser mellomrommet, og
       padding-bottom løfter gruppa opp fra bildekanten (tillitsraden ble
       ellers klippet nederst). */
    .sk-dynamic-banner__content {
      min-height: 100%;
      justify-content: flex-start;
      padding-bottom: 14vh;
    }

    .sk-dynamic-banner__cta {
      margin-top: auto;
    }

    .sk-dynamic-banner__trust {
      margin-top: 0.9rem;
      padding-bottom: 0;
    }

    /* VENSTRESTILT, IKKE SENTRERT — sentrert stabel er det som gjør at hero
       leser som en mal. Venstrekant gir redaksjonell ro og raskere lesing. */
    .sk-dynamic-banner__container {
      text-align: left;
    }

    .sk-dynamic-banner__content {
      gap: 1.1rem;
      padding-inline: 0.2rem;
      padding-bottom: 0.5rem;
    }

    /* Sentence case i serif — versaler + sperret spacing var hovedgrunnen til
       at den så datert ut. Strammere line-height og et kort mål (16ch) gir
       en overskrift med tyngde i stedet for tre brede versal-linjer. */
    /* hyphens:auto delte «LED-tekno-logi» midt i ordet. Slått av – heller en
       kortere linje enn et brukket fagord. */
    .sk-dynamic-banner__title {
      font-size: clamp(2.8rem, 8.6vw, 3.6rem);
      line-height: 1.06;
      letter-spacing: -0.022em;
      text-transform: none;
      text-align: left;
      max-width: 15ch;
      padding-inline: 0;
      text-wrap: balance;
      hyphens: none;
      overflow-wrap: normal;
      word-break: normal;
    }

    .sk-dynamic-banner__eyebrow {
      font-size: 1.15rem;
      text-align: left;
    }

    /* Brødteksten er støtte, ikke hovedrolle: mindre, dempet, kort mål. */
    .sk-dynamic-banner__description {
      font-size: 1.45rem;
      line-height: 1.45;
      letter-spacing: 0;
      color: rgba(var(--color-foreground), 0.72);
      max-width: 32ch;
      margin-top: 0;
      text-align: left;
    }

    /* CTA i full bredde – tommelvennlig og tydelig endestasjon. */
    .sk-dynamic-banner__cta {
      width: 100%;
      justify-content: flex-start;
    }

    .sk-dynamic-banner__button.sk-btn {
      width: 100%;
      min-height: 54px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.45rem;
      letter-spacing: 0.04em;
    }

    /* Ikke demp tillitsraden på mobil – den skal brøle her også. */
    .sk-dynamic-banner__trust {
      font-size: 1.3rem;
      line-height: 1.4;
      text-align: left;
      color: rgb(var(--color-foreground));
      gap: 0.6rem 1rem;
    }
  }

  @media (max-width: 435px) {
    .sk-dynamic-banner {
      height: 80vh; /* var 84vh – frigjør plass til etikett + tillitslinje */
    }

    .sk-dynamic-banner__content {
      gap: 0.95rem;
    }

    .sk-dynamic-banner__title {
      font-size: clamp(2.7rem, 10.2vw, 3.4rem);
      line-height: 1.03;
    }

    .sk-dynamic-banner__description {
      font-size: 1.35rem;
      line-height: 1.4;
    }

    /* Tillitsraden krympes IKKE på små skjermer – den er heroens sterkeste
       tillitssignal og skal lese tydelig også der. */
    .sk-dynamic-banner__trust {
      font-size: 1.25rem;
    }
  }
</style>

{%- liquid
  # ---- Kampanjebryter (settings.kampanje_aktiv). Alt kampanje-innhold er
  #      betinget; er bryteren av, faller alt tilbake til seksjonens egne
  #      innstillinger og siden er identisk med før. Ingen priser eller
  #      datoer er hardkodet – de kommer fra tema-innstillingene.
  assign kampanje = settings.kampanje_aktiv

  assign hero_title = section.settings.sk_banner_title
  assign hero_desc = section.settings.sk_banner_description
  assign hero_btn = 'SE RADIANCE FACE'
  if kampanje
    assign hero_title = 'Profesjonell LED-terapi hjemme — nå ' | append: settings.kampanje_pris
    assign hero_desc = 'Radiance Face med rødt og nær-infrarødt lys, 1072 nm. Ordinær pris ' | append: settings.kampanje_ordinaerpris | append: '. Gratis frakt fra norsk lager.'
    assign hero_btn = 'KJØP RADIANCE FACE – ' | append: settings.kampanje_pris
  endif

  # Knappen peker på produktet uansett kampanjestatus (samleside → produktside).
  assign hero_link = section.settings.sk_banner_button_link
  if hero_link == blank
    assign hero_link = '/products/skinora-radiance-face'
  endif

  # Tillitslinje: anmeldelsestall fra samme kilde som produktsiden
  # (reviews-metafeltet Okendo synker til), med tema-innstilling som fallback.
  assign hero_product = all_products['skinora-radiance-face']
  assign hero_rc = hero_product.metafields.reviews.rating_count | plus: 0
  if hero_rc > 0
    assign hero_count = hero_rc
  else
    assign hero_count = settings.cart_review_count
  endif
  assign hero_rating = settings.cart_review_rating
  if hero_product.metafields.reviews.rating.value != blank
    assign hero_rating = hero_product.metafields.reviews.rating.value.rating | round: 1 | replace: '.', ','
  endif
-%}

<section class="sk-dynamic-banner sk-dynamic-banner--cta-{{ section.settings.sk_banner_cta_position_mobile }}{% if kampanje %} sk-dynamic-banner--kampanje{% endif %}">
  <h1 class="visually-hidden">Skinora® Norge – LED-ansiktsmasker for well-aging, glød og uren hud</h1>
  <div class="page-width">
    <div class="sk-dynamic-banner__container">
      <div class="sk-dynamic-banner__content">
        {%- if kampanje and settings.kampanje_sluttdato != blank -%}
          <p class="sk-dynamic-banner__eyebrow">Kampanje — til {{ settings.kampanje_sluttdato }}</p>
        {%- endif -%}

        <h2 lang="no" class="sk-header__section sk-dynamic-banner__title">
          {{ hero_title }}
        </h2>

        <p class="sk-section-body sk-dynamic-banner__description">
          {{ hero_desc }}
        </p>

        <div class="sk-dynamic-banner__cta">
          <a
            href="{{ hero_link }}"
            class="sk-dynamic-banner__button sk-btn sk-btn--primary"
          >
            {{ hero_btn }}
            <span class="svg-wrapper sk-btn__icon">
              {{- 'arrow-right.svg' | inline_asset_content -}}
            </span>
          </a>
        </div>

        {%- comment -%}
          Tillitsrad – vises uansett kampanjestatus. Stjerner og betalingslogoer
          som grafikk i stedet for én lang tekstlinje som brakk i to.
        {%- endcomment -%}
        {%- comment -%}
          Vurdering og antall er BEVISST hardkodet her, ikke hentet fra
          reviews-metafeltet: heroen ligger på forsiden og skal vise butikkens
          TOTALE tall, ikke ett produkts. Summen er verifisert 3. aug 2026 mot
          produktsidenes JSON-LD: Radiance Face 79 + Clear 68 + Neck 62 = 209,
          alle 4,8. MÅ oppdateres manuelt når antallet vokser vesentlig –
          tallet skal alltid være sant.
        {%- endcomment -%}
        <div class="sk-dynamic-banner__trust">
          <span class="sk-dynamic-banner__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path d="M10 1.6l2.47 5.3 5.53.62-4.12 3.9 1.1 5.68L10 14.3l-4.98 2.8 1.1-5.68L2 7.52l5.53-.62L10 1.6z"/></svg>
            {%- endfor -%}
          </span>
          <span class="sk-dynamic-banner__rating">
            <strong>4,8</strong> av 5 · <strong>209</strong> anmeldelser
          </span>
          <span class="sk-dynamic-banner__pay" aria-label="Vipps og Klarna">
            <img src="{{ 'icon-vipps.svg' | asset_url }}" alt="" height="16" width="40" loading="lazy">
            <img src="{{ 'klarna-logo.svg' | asset_url }}" alt="" height="16" loading="lazy">
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SK Dynamic Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "sk_banner_img_desktop",
      "label": "Banner Image – Desktop"
    },
    {
      "type": "image_picker",
      "id": "sk_banner_img_tablet",
      "label": "Banner Image – Tablet"
    },
    {
      "type": "image_picker",
      "id": "sk_banner_img_mobile",
      "label": "Banner Image – Mobile"
    },
    {
      "type": "text",
      "id": "sk_banner_title",
      "label": "Title"
    },
    {
      "type": "text",
      "id": "sk_banner_description",
      "label": "Description"
    },
