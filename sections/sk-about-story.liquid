{%- comment -%}
  sk-about-story — grunnleggerfortelling for Om oss.

  Erstatter sk-about-hero-editorial (én stor richtext-blokk) med en
  redaksjonell struktur: portrett-kolonne (sticky) + fortellerkolonne,
  et prinsippbånd og en signatur.

  Blokktyper:
    fact       → rendres i portrett-kolonnen (label/verdi)
    paragraph  → fortellerkolonnen, i rekkefølge
    quote      → fortellerkolonnen, i rekkefølge
    principle  → eget bånd under fortellingen, nummerert 01/02/03
{%- endcomment -%}

{{ 'sk-about-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg = section.settings.background
  assign has_principles = false
  for block in section.blocks
    if block.type == 'principle'
      assign has_principles = true
      break
    endif
  endfor

  assign has_facts = false
  for block in section.blocks
    if block.type == 'fact'
      assign has_facts = true
      break
    endif
  endfor

  assign image_loading = section.settings.image_loading | default: 'lazy'
  assign fetch_priority = 'auto'
  if image_loading == 'eager'
    assign fetch_priority = 'high'
  endif

  assign portrait_alt = section.settings.image_alt | default: section.settings.image_caption | default: section.settings.signature_name
-%}

<section class="sk-story sk-story--{{ bg }}">
  <div class="sk-story__inner">
    {%- comment -%}
      Bevisst <div> og ikke <header>: sk-base.css har en global
      `header:not(.sk-header) { display: flex !important }` under 700px
      som ellers legger eyebrow og overskrift ved siden av hverandre.
    {%- endcomment -%}
    <div class="sk-story__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sk-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="sk-story__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}
    </div>

    <div class="sk-story__body">
      {%- if section.settings.image != blank or has_facts -%}
        <aside class="sk-story__aside">
          <div class="sk-story__aside-inner">
            {%- if section.settings.image != blank -%}
              <figure
                class="sk-story__portrait"
                style="--sk-story-portrait-y: {{ section.settings.image_focus_y }}%;"
              >
                {{
                  section.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '320, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 990px) 320px, 100vw',
                    class: 'sk-story__portrait-img',
                    alt: portrait_alt,
                    loading: image_loading,
                    fetchpriority: fetch_priority
                }}
                {%- if section.settings.image_caption != blank -%}
                  <figcaption class="sk-story__portrait-caption">
                    {{- section.settings.image_caption | escape -}}
                  </figcaption>
                {%- endif -%}
              </figure>
            {%- endif -%}

            {%- if has_facts -%}
              <dl class="sk-story__facts">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'fact' -%}
                    <div class="sk-story__fact" {{ block.shopify_attributes }}>
                      <dt class="sk-story__fact-label">{{ block.settings.label | escape }}</dt>
                      <dd class="sk-story__fact-value">{{ block.settings.value | escape }}</dd>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </dl>
            {%- endif -%}
          </div>
        </aside>
      {%- endif -%}

      <div class="sk-story__narrative">
        {%- if section.settings.lead != blank -%}
          <div class="sk-story__lead">{{ section.settings.lead }}</div>
        {%- endif -%}

        {%- if section.settings.lead_note != blank -%}
          <p class="sk-story__note">{{ section.settings.lead_note | escape }}</p>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'paragraph' -%}
              <div class="sk-story__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'quote' -%}
              <blockquote class="sk-story__quote" {{ block.shopify_attributes }}>
                <p class="sk-story__quote-text">{{ block.settings.text | escape }}</p>
                {%- if block.settings.note != blank -%}
                  <footer class="sk-story__quote-note">{{ block.settings.note | escape }}</footer>
                {%- endif -%}
              </blockquote>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if has_principles -%}
      <div class="sk-story__principles">
        {%- if section.settings.principles_title != blank -%}
          <h2 class="sk-story__principles-title">{{ section.settings.principles_title | escape }}</h2>
        {%- endif -%}

        <ol class="sk-story__principle-list">
          {%- assign principle_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'principle' -%}
              {%- assign principle_index = principle_index | plus: 1 -%}
              <li class="sk-story__principle" {{ block.shopify_attributes }}>
                <span class="sk-story__principle-num" aria-hidden="true">
                  {{- principle_index | prepend: '0' | slice: -2, 2 -}}
                </span>
                {%- if block.settings.title != blank -%}
                  <h3 class="sk-story__principle-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="sk-story__principle-text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    <div class="sk-story__sign">
      {%- if section.settings.closing != blank -%}
        <div class="sk-story__closing">{{ section.settings.closing }}</div>
      {%- endif -%}

      {%- if section.settings.signature_image != blank -%}
        {{
          section.settings.signature_image
          | image_url: width: 600
          | image_tag:
            widths: '200, 300, 400, 600',
            sizes: '220px',
            class: 'sk-story__signature-img',
            alt: section.settings.signature_name,
            loading: 'lazy'
        }}
      {%- elsif section.settings.signature_name != blank -%}
        <p class="sk-story__signature">{{ section.settings.signature_name | escape }}</p>
      {%- endif -%}

      {%- if section.settings.signature_role != blank -%}
        <p class="sk-story__signature-role">{{ section.settings.signature_role | escape }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a class="sk-story__cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SK About Story",
  "tag": "section",
  "class": "sk-story-section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Bakgrunn",
      "options": [
        { "value": "paper", "label": "Hvit" },
        { "value": "cream", "label": "Varm krem" },
        { "value": "cool", "label": "Kjølig grå" }
      ],
      "default": "paper"
    },
    {
      "type": "header",
      "content": "Toppen"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Historien bak Skinora"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Det begynte med en lånt maske"
    },
    {
      "type": "richtext",
      "id": "lead",
      "label": "Ingress",
      "default": "<p>Jeg heter Anastasia, og jeg står bak Skinora. For fire år siden lånte jeg LED-masken til en venninne – mest av nysgjerrighet. Etter to uker med jevnlig bruk så jeg forskjell i mitt eget speil. Det var nok til at jeg ville forstå hva som faktisk lå bak lyset.</p>"
    },
    {
      "type": "text",
      "id": "lead_note",
      "label": "Liten merknad under ingressen",
      "info": "Brukes til å understreke at dette er en personlig erfaring, ikke et løfte.",
      "default": "Min egen erfaring. Resultater varierer fra person til person."
    },
    {
      "type": "header",
      "content": "Portrett"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Portrett"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt-tekst"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Bildetekst",
      "default": "Anastasia, grunnlegger av Skinora"
    },
    {
      "type": "range",
      "id": "image_focus_y",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Vertikalt bildefokus",
      "info": "Lav verdi holder toppen av bildet og beskjærer mer fra bunnen. 50 % = midtstilt.",
      "default": 30
    },
    {
      "type": "select",
      "id": "image_loading",
      "label": "Bildelasting",
      "options": [
        { "value": "lazy", "label": "Lazy" },
        { "value": "eager", "label": "Eager" }
      ],
      "default": "eager"
    },
    {
      "type": "header",
      "content": "Prinsipper"
    },
    {
      "type": "text",
      "id": "principles_title",
      "label": "Overskrift over prinsippene",
      "default": "Tre ting vi ikke går på akkord med"
    },
    {
      "type": "header",
      "content": "Avslutning og signatur"
    },
    {
      "type": "richtext",
      "id": "closing",
      "label": "Avslutning",
      "default": "<p>Skinora er ikke laget for hype. Det er laget for deg som vil vite hva du kjøper – og som heller vil ha en rutine som varer enn et løfte som ikke gjør det.</p>"
    },
    {
      "type": "image_picker",
      "id": "signature_image",
      "label": "Signaturbilde (valgfritt)",
      "info": "Skannet signatur som transparent PNG, gjerne kvadratisk (1:1). Bildet vises i sitt eget format og uten marger – luften rundt signaturen må ligge i selve filen. Uten bilde vises navnet i kursiv serif."
    },
    {
      "type": "text",
      "id": "signature_name",
      "label": "Navn",
      "default": "Anastasia"
    },
    {
      "type": "text",
      "id": "signature_role",
      "label": "Rolle",
      "default": "Grunnlegger, Skinora®"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Lenketekst",
      "default": "Se maskene våre →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Lenke"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Avsnitt",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>Skriv et avsnitt av historien her.</p>"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Sitat",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Sitat",
          "default": "Hvorfor må man velge mellom noe man ikke tør stole på, og noe man ikke tør å angre på?"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Undertekst (valgfritt)"
        }
      ]
    },
    {
      "type": "principle",
      "name": "Prinsipp",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tittel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Tekst"
        }
      ]
    },
    {
      "type": "fact",
      "name": "Faktalinje",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Etikett"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Verdi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK About Story",
      "blocks": [
        { "type": "fact" },
        { "type": "fact" },
        { "type": "fact" },
        { "type": "paragraph" },
        { "type": "paragraph" },
        { "type": "quote" },
        { "type": "paragraph" },
        { "type": "principle" },
        { "type": "principle" },
        { "type": "principle" }
      ]
    }
  ]
}
{% endschema %}
