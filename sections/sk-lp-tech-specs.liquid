{%- comment -%}
  sk-lp-tech-specs.liquid
  Technical specifications section for Skinora Radiance Face.
{%- endcomment -%}

{%- comment -%}
  Delt LP-stilark. På landingssidene lastes det ÉN gang fra theme.liquid:
  17 seksjoner emitterte hver sin kopi, og den samme 15,7 kB-filen ble
  parset elleve ganger på samme side (målt 13.09.2026). Utenfor
  landingssidene — f.eks. denne seksjonen på forsiden — må den fortsatt
  lastes her.
{%- endcomment -%}
{%- unless template.suffix contains 'sk-lp' -%}{{ 'section-sk-lp-radiance-face.css' | asset_url | stylesheet_tag }}{%- endunless -%}
{%- comment -%}
  Ikke-blokkerende: seksjonen står under folden, så stilarket rakk aldri
  å påvirke første maling — men det blokkerte gjengivelsen av alt som kom
  etter det i dokumentet. Målt 13.09.2026: 31 blokkerende stilark,
  gjengivelsesforsinkelse 2 060 ms.

  media="print" lastes uten å blokkere; onload flipper til all så snart
  fila er nede. Samme mønster som header.liquid og kurv-skuffen bruker.
  noscript-kopien dekker nettlesere uten JS.
{%- endcomment -%}
<link rel="stylesheet" href="{{ 'section-sk-lp-tech-specs.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'section-sk-lp-tech-specs.css' | asset_url }}"></noscript>

<!-- SECTION: Technical Specifications -->
<div class="sk-lp">
  <section class="sk-tech-specs">
    <div class="sk-tech-specs__container">
      <h2 class="lp-section-heading">{{ section.settings.heading }}</h2>
      <table class="sk-tech-specs__table">
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <td>{{ block.settings.label }}</td>
              <td>{{ block.settings.value }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "LP Tech Specs",
  "tag": "section",
  "class": "sk-lp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Tekniske spesifikasjoner"
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spesifikasjon",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Egenskap"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Verdi"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP Tech Specs",
      "blocks": [
        {
          "type": "spec",
          "settings": { "label": "LED-bølgelengder", "value": "630 nm (rødt) + 830 nm (nær-infrarødt)" }
        },
        { "type": "spec", "settings": { "label": "Antall LED-er", "value": "[CONFIRM]" } },
        { "type": "spec", "settings": { "label": "Behandlingstid", "value": "10 minutter per økt" } },
        {
          "type": "spec",
          "settings": { "label": "Batteri", "value": "USB-C oppladbart, ca. 20 behandlinger per lading" }
        },
        { "type": "spec", "settings": { "label": "Sertifisering", "value": "CE" } },
        { "type": "spec", "settings": { "label": "Materiale", "value": "Medisinsk silikon" } },
        { "type": "spec", "settings": { "label": "Vekt", "value": "[CONFIRM]" } }
      ]
    }
  ]
}
{% endschema %}
