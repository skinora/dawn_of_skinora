{%- comment -%}
  sk-lp-faq.liquid
  FAQ accordion for landing pages. Each Q&A pair is a block.
{%- endcomment -%}

{{ 'section-sk-lp-radiance-face.css' | asset_url | stylesheet_tag }}
{{ 'section-sk-lp-faq.css' | asset_url | stylesheet_tag }}

<!-- SECTION: FAQ -->
<div class="sk-lp">
  <section class="lp-faq">
    <div class="lp-container">
      <h2 class="lp-section-heading">{{ section.settings.heading }}</h2>

      {%- if section.blocks.size > 0 -%}
        <div class="lp-faq__list" data-lp-faq>
          {%- for block in section.blocks -%}
            {%- comment -%}
              Spørsmål og svar kan inneholde [pris], [klarna] og [behandlinger].
              De byttes ut fra produktet i seksjonsinnstillingen (sk-lp-pricing),
              både her og i FAQ-schemaet under, så Google og kunden alltid ser
              samme tall. Blir spørsmål eller svar tomt etter utbytting (produkt
              mangler), hoppes hele elementet over — ingen tomme knapper.
            {%- endcomment -%}
            {%- capture faq_vq -%}{%- render 'sk-lp-pricing', product: section.settings.product, text: block.settings.question -%}{%- endcapture -%}
            {%- capture faq_va -%}{%- render 'sk-lp-pricing', product: section.settings.product, text: block.settings.answer -%}{%- endcapture -%}
            {%- if faq_vq != blank and faq_va != blank -%}
              <div class="lp-faq__item" {{ block.shopify_attributes }}>
                <button class="lp-faq__question" type="button" aria-expanded="false">
                  {{ faq_vq }}
                  <span class="lp-faq__icon">+</span>
                </button>
                <div class="lp-faq__answer">
                  <div class="lp-faq__answer-inner">
                    {{ faq_va }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
</div>

{%- comment -%} FAQPage JSON-LD structured data {%- endcomment -%}
{%- comment -%}
  Telles på utbyttet tekst, ikke rå innstillinger — ellers kunne et spørsmål
  som ble tomt (produkt mangler) gitt en hengende komma i JSON-en.
{%- endcomment -%}
{%- assign faq_ld_count = 0 -%}
{%- for block in section.blocks -%}
  {%- capture faq_cq -%}{%- render 'sk-lp-pricing', product: section.settings.product, text: block.settings.question -%}{%- endcapture -%}
  {%- capture faq_ca -%}{%- render 'sk-lp-pricing', product: section.settings.product, text: block.settings.answer -%}{%- endcapture -%}
  {%- if faq_cq != blank and faq_ca != blank -%}
    {%- assign faq_ld_count = faq_ld_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}
{%- if faq_ld_count > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign faq_ld_idx = 0 -%}
        {%- for block in section.blocks -%}
          {%- capture faq_q -%}{%- render 'sk-lp-pricing', product: section.settings.product, text: block.settings.question -%}{%- endcapture -%}
          {%- capture faq_a -%}{%- render 'sk-lp-pricing', product: section.settings.product, text: block.settings.answer -%}{%- endcapture -%}
          {%- if faq_q != blank and faq_a != blank -%}
            {%- assign faq_ld_idx = faq_ld_idx | plus: 1 -%}
            {
              "@type": "Question",
              "name": {{ faq_q | strip_html | strip | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq_a | strip_html | strip_newlines | strip | json }}
              }
            }{%- if faq_ld_idx < faq_ld_count -%},{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

<script>
  (function initLpFaqAccordion() {
    var lists = document.querySelectorAll('[data-lp-faq]');
    lists.forEach(function (list) {
      var items = list.querySelectorAll('.lp-faq__item');
      items.forEach(function (item) {
        var btn = item.querySelector('.lp-faq__question');
        btn.addEventListener('click', function () {
          var isOpen = item.classList.contains('is-open');
          items.forEach(function (i) {
            i.classList.remove('is-open');
            i.querySelector('.lp-faq__question').setAttribute('aria-expanded', 'false');
          });
          if (!isOpen) {
            item.classList.add('is-open');
            btn.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "LP FAQ",
  "tag": "section",
  "class": "sk-lp-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Ofte stilte spørsmål"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Produkt (for priser i svarene)",
      "info": "Spørsmål og svar kan bruke [pris], [klarna] og [behandlinger] — tallene hentes fra dette produktet. Uten produkt skjules spørsmål som inneholder plassholdere."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ-spørsmål",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Spørsmål"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Svar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "Hvor ofte bør jeg bruke masken?",
            "answer": "Vi anbefaler 3–5 økter i uken, à 10 minutter. Du kan bruke den morgen eller kveld – det som passer best for deg."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Når kan jeg forvente å se resultater?",
            "answer": "De fleste merker forbedring i glød og hudtone etter 2–4 uker. For mer synlige resultater som jevnere tekstur og reduserte pigmentflekker, anbefaler vi minst 6–8 uker med jevnlig bruk."
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Er LED-lys trygt for huden?",
            "answer": "Ja. LED-terapi er en ikke-invasiv teknologi som er grundig testet og brukes av hudterapeuter verden over. Den inneholder ingen UV-stråler og er skånsom mot alle hudtyper."
          }
        }
      ]
    }
  ]
}
{% endschema %}
