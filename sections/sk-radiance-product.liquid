<link rel="stylesheet" href="{{ 'sk-pdp-overrides.css' | asset_url }}" media="print" onload="this.media='all'">

{{ 'section-sk-radiance-product.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign product_info_reference = product.metafields.custom.product_info
  | default: product.metafields.product_info
-%}
{%- assign product_info = product_info_reference.value -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign media_images = product.media | where: 'media_type', 'image' -%}

{%- comment -%}
  Bundle wiring (IMPORTANT):
  Create a Product reference metafield on the BASE product:
  - custom.bundle_product (type: Product)
  Select your "Bundler standalone bundle product" there.
{%- endcomment -%}

{%- assign bundle_product_ref = product.metafields.custom.bundle_product.value -%}
{%- assign bundle_handle = '' -%}
{%- assign bundle_title = '' -%}
{%- if bundle_product_ref != blank -%}
  {%- assign bundle_handle = bundle_product_ref.handle -%}
  {%- assign bundle_title = bundle_product_ref.title -%}
{%- endif -%}
{%- assign base_variant = product.selected_or_first_available_variant -%}
{%- assign bundle_variant = bundle_product_ref.first_available_variant -%}
{%- if bundle_variant == blank -%}
  {%- assign bundle_variant = bundle_product_ref.variants.first -%}
{%- endif -%}
{%- assign single_image_alt = product.featured_image.alt | default: product.title -%}
{%- assign bundle_image_obj = bundle_product_ref.featured_image -%}
{%- if bundle_image_obj == blank -%}
  {%- assign bundle_image_obj = product.featured_image -%}
{%- endif -%}
{%- if bundle_image_obj != blank -%}
  {%- assign bundle_image_alt = bundle_image_obj.alt | default: bundle_title | default: product.title -%}
{%- else -%}
  {%- assign bundle_image_alt = bundle_title | default: product.title -%}
{%- endif -%}

{%- comment -%}
  Pills: robust detection using JSON output.
  - Array -> json starts with [
  - String -> json starts with "
{%- endcomment -%}
{%- assign pills_raw = product_info.radiance_pills.value | default: blank -%}
{%- assign pills_list = blank -%}
{%- if pills_raw != blank -%}
  {%- assign pills_json = pills_raw | json -%}
  {%- assign pills_json_first = pills_json | slice: 0, 1 -%}
  {%- if pills_json_first == '[' -%}
    {%- assign pills_list = pills_raw -%}
  {%- else -%}
    {%- assign pills_clean = pills_raw | strip -%}
    {%- if pills_clean contains '[' and pills_clean contains ']' -%}
      {%- assign pills_clean = pills_clean | remove: '[' | remove: ']' -%}
      {%- assign pills_clean = pills_clean
        | replace: '","', '|||'
        | replace: '", "', '|||'
        | replace: '",', '|||'
        | replace: ',"', '|||'
      -%}
      {%- assign pills_clean = pills_clean | replace: '"', '' -%}
      {%- assign pills_list = pills_clean | split: '|||' -%}
    {%- elsif pills_clean contains '\n' -%}
      {%- assign pills_list = pills_clean | split: '\n' -%}
    {%- else -%}
      {%- assign pills_list = pills_clean | split: '|||' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<product-info
  id="MainProduct-{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-url="{{ product.url }}"
>
  <div class="page-width">
    <section
      class="sk-product-hero"
      id="sk-radiance-product-hero-{{ section.id }}"
      data-base-handle="{{ product.handle | handleize }}"
      data-base-product-id="{{ product.id }}"
      data-base-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-base-available="{% if product.selected_or_first_available_variant.available %}true{% else %}false{% endif %}"
      data-bundle-handle="{{ bundle_handle | handleize }}"
      data-bundle-title="{{ bundle_title | escape }}"
      data-money-format="{{ shop.money_without_trailing_zeros_format | escape }}"
    >
      <div class="sk-hero-grid">
        <!-- ================= LEFT: CANONICAL MEDIA ================= -->
        <div class="sk-hero-media">
          {% if media_images.size > 0 %}
            <div class="sk-hero-media-main">
              <div class="sk-hero-media-swiper swiper">
                <div class="swiper-wrapper">
                  {% for image in media_images %}
                    <div class="swiper-slide">
                      {%- comment -%}
                        format: 'webp' er eksplisitt. Uten den leverer Shopify
                        kildeformatet, og hero-bildet er en PNG — et format for
                        strektegninger og gjennomsiktighet, ikke for fotografi.
                        Samme motiv som webp er typisk 60-70 % mindre.

                        ADVARSEL: denne kommentaren maa staa UTENFOR img-taggen.
                        En Liquid-kommentar med bindestrek spiser linjeskiftet
                        foran seg. Staar den rett etter selve taggaapningen,
                        limes taggnavnet sammen med foerste attributt, og
                        nettleseren parser et ukjent element helt uten bilde.
                        Mellom to attributter er det ufarlig — HTML-parseren
                        kommer seg etter det — men aldri rett etter aapningen.
                      {%- endcomment -%}
                      <img
                        src="{{ image | image_url: width: 900, format: 'webp' }}"
                        srcset="{{ image | image_url: width: 400, format: 'webp' }} 400w, {{ image | image_url: width: 600, format: 'webp' }} 600w, {{ image | image_url: width: 900, format: 'webp' }} 900w, {{ image | image_url: width: 1200, format: 'webp' }} 1200w, {{ image | image_url: width: 1600, format: 'webp' }} 1600w"
                        {%- comment -%}
                          sizes matcher faktisk rendret bredde av .sk-hero-media-main, utledet fra
                          .page-width (max-width 1600px, padding 40px/side ved >=889px viewport) og
                          .sk-hero-grid sin 45/55-kolonnedeling med 6rem (60px) gap ved >=990px:
                          kolonnebredde = 45vw - 63px, med tak 693px når 100vw-80px når 1600px (vw=1680).
                          769-989px er énkolonne (60vw), <=768px er full-bleed (100vw).
                        {%- endcomment -%}
                        sizes="(max-width: 768px) 100vw, (max-width: 989px) 60vw, (min-width: 1680px) 693px, calc(45vw - 63px)"
                        alt="{{ image.alt | default: product.title | escape }}"
                        width="900"
                        height="900"
                        {%- comment -%}
                          KUN slide 1 er eager. Bilde 2 var ogsaa eager — en rest
                          fra peek-kanten paa mobil, der 47 px av neste slide var
                          synlig og et lazy bilde derfor etterlot en tom hvit
                          flate. Den peek-en er rullet tilbake (den kuttet tekst
                          i bildene), saa bilde 2 er ikke lenger synlig ved
                          foerste paint — men det ble fortsatt hentet.

                          To eager-bilder stablet paa samme posisjon konkurrerer
                          om den foerste malingen, og nettleseren kan ikke vite
                          hvilket som er LCP. Ett eager-bilde, med hoey prioritet
                          og ingen konkurrent, er hele poenget med fetchpriority.
                        {%- endcomment -%}
                        {% if forloop.first %}
                          loading="eager" fetchpriority="high" decoding="sync"
                        {% else %}
                          loading="lazy" decoding="async"
                        {% endif %}
                      >
                    </div>
                  {% endfor %}
                </div>
                {% if media_images.size > 1 %}
                  <button class="sk-hero-arrow sk-hero-arrow--prev" type="button" aria-label="Forrige bilde">
                    ‹
                  </button>
                  <button class="sk-hero-arrow sk-hero-arrow--next" type="button" aria-label="Neste bilde">
                    ›
                  </button>
                {% endif %}
              </div>
            </div>

            <div class="sk-hero-gallery-wrapper">
              <div class="sk-hero-gallery">
                {% for image in media_images %}
                  <div class="sk-hero-thumb">
                    <img
                      src="{{ image | image_url: width: 240 }}"
                      srcset="
                        {{ image | image_url: width: 120 }} 120w,
                        {{ image | image_url: width: 240 }} 240w,
                        {{ image | image_url: width: 360 }} 360w,
                        {{ image | image_url: width: 480 }} 480w
                      "
                      sizes="(max-width: 768px) 48px, 120px"
                      alt="{{ image.alt | default: product.title }}"
                      width="120"
                      height="120"
                      loading="lazy"
                    >
                  </div>
                {% endfor %}
              </div>
              {% if media_images.size > 1 %}
                <div class="sk-hero-gallery-controls" aria-hidden="true">
                  <button class="sk-hero-arrow sk-hero-arrow--prev" type="button" aria-label="Rull galleriet til venstre">
                    ‹
                  </button>
                  <button class="sk-hero-arrow sk-hero-arrow--next" type="button" aria-label="Rull galleriet til høyre">
                    ›
                  </button>
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>

        <!-- ================= RIGHT: METAOBJECT CONTENT ================= -->
        <div class="sk-hero-content">
          {% if product_info.radiance_eyebrow.value != blank %}
            <p class="sk-eyebrow">{{ product_info.radiance_eyebrow.value }}</p>
          {% endif %}

          {%- comment -%}
            H1 = merkenavn + produkttype. Merkenavnet står stort som før;
            produkttypen (metafelt custom.h1_produkttype, f.eks. «LED-maske mot
            akne og problemhud») ligger i samme H1 som en mindre linje under,
            så søkeordet er en del av overskriften uten å gjøre tittelen lang.
            Tomt felt = kun merkenavnet, som før.
          {%- endcomment -%}
          {%- comment -%} H1-undertittel: custom.h1_suffix vinner, deretter custom.h1_produkttype. Tomt = kun produkttittel. {%- endcomment -%}
          {%- assign sk_h1_type = product.metafields.custom.h1_suffix.value | default: product.metafields.custom.h1_produkttype.value | strip -%}
          <h1 class="sk-product-title">
            {{ product_info.radiance_heading.value | default: product.title }}
            {%- if sk_h1_type != blank -%}
              <span class="sk-product-title__type"><span class="visually-hidden"> – </span>{{ sk_h1_type | escape }}</span>
            {%- endif -%}
          </h1>

          {% if product_info.radiance_subheading.value != blank %}
            <p class="sk-product-subtitle">{{ product_info.radiance_subheading.value }}</p>
          {% endif %}

          {%- liquid
            comment
              Gloedens palett (pills) foelger maskens egen boelgelengde.
              1) metafeltet custom.led_glow ("blue" eller "red") vinner
              2) ellers utledes den av handle — Clear er blaatt lys,
                 Radiance er roedt og naer-infraroedt
              Faller alltid tilbake til roedt, som er flertallet.
            endcomment
            assign glow_kind = product.metafields.custom.led_glow.value | default: product.metafields.custom.led_glow | downcase | strip
            if glow_kind == blank
              if product.handle contains 'clear'
                assign glow_kind = 'blue'
              else
                assign glow_kind = 'red'
              endif
            endif
            assign pills_glow_class = ''
            if glow_kind == 'blue'
              assign pills_glow_class = ' sk-radiance-pills--blue'
            endif
          -%}
          {%- comment -%}
            Anmeldelsene staar FOER pågang-linjen: vurderingen svarer paa
            "er den bra", knappheten paa "maa jeg bestemme meg naa". Det
            foerste spoerdmaalet kommer foerst, og et hastesignal foer
            produktet er vurdert leser som press.
          {%- endcomment -%}
          {%- comment -%}
            Anmeldelses-widgeten er en app-blokk (Klaviyo Reviews). Har
            seksjonen ingen app-blokk — tilfellet etter at Okendos
            stjerneblokk ble fjernet — rendrer vi temaets egne stjerner fra
            reviews-metafeltene i stedet: samme komponent som produktkortene,
            uten JS og uten CLS. Begge anmeldelses-appene skriver til de
            samme metafeltene, saa denne fallbacken overlever appbytter.
          {%- endcomment -%}
          {%- liquid
            assign sk_has_app_block = false
            for block in section.blocks
              if block.type == '@app'
                assign sk_has_app_block = true
              endif
            endfor
          -%}
          <div class="sk-product-reviews">
            {%- if sk_has_app_block -%}
              {% for block in section.blocks %}
                {% if block.type == '@app' %}
                  {% render block %}
                {% endif %}
              {% endfor %}
            {%- else -%}
              {%- comment -%}
                sr_trigger: stjernene åpner anmeldelses-modalen. Klaviyo-
                widgeten ligger ~82 % ned på siden, og bare 3–4 % av
                mobilbesøkende kommer dit. Modalen har lenken videre.
              {%- endcomment -%}
              {% render 'sk-star-rating', sr_product: product, sr_trigger: true %}
            {%- endif -%}
          </div>

          {%- assign sk_demand_text = section.settings.demand_text | strip -%}
          {%- if section.settings.demand_show and sk_demand_text != blank -%}
            {%- comment -%}
              Delen foer « – » settes i halvfet: «Stor pågang» er signalet,
              resten er forklaringen.
            {%- endcomment -%}
            {%- assign sk_demand_parts = sk_demand_text | split: ' – ' -%}
            <p class="sk-demand">
              <span class="sk-demand__dot" aria-hidden="true"></span>
              <span class="sk-demand__text">
                {%- if sk_demand_parts.size > 1 -%}
                  <strong>{{ sk_demand_parts.first }}</strong> – {{ sk_demand_text | remove_first: sk_demand_parts.first | remove_first: ' – ' }}
                {%- else -%}
                  {{ sk_demand_text }}
                {%- endif -%}
              </span>
            </p>
          {%- endif -%}

          {%- comment -%}
            PILLS — produktfakta fra metafeltet, pluss sertifiseringen til slutt.

            CE staar som seksjonsinnstilling og ikke i metafeltet: merkingen
            gjelder alle produktene likt, saa den skal settes ett sted. Den er
            ogsaa plassert sist med vilje — produktfaktaene svarer «hva er
            dette», sertifiseringen svarer «toer jeg».

            Vilkaaret dekker ogsaa tilfellet der et produkt mangler pills:
            da rendres raden likevel, med bare sertifiseringen.
          {%- endcomment -%}
          {% if pills_list != blank or section.settings.ce_text != blank %}
            <div class="sk-radiance-pills{{ pills_glow_class }}">
              {% for pill in pills_list %}
                {% assign pill_text = pill | strip %}
                {% if pill_text != blank %}
                  {%- comment -%}
                    Prikken vandrer gjennom --glow-1/2/3 og begynner forfra
                    naar de er brukt opp. Fargene bytter med masken, saa raden
                    lyser i det spekteret produktet faktisk sender ut.
                  {%- endcomment -%}
                  {%- assign dot_index = forloop.index0 | modulo: 3 | plus: 1 -%}
                  <span class="sk-pill" style="--sk-dot: var(--glow-{{ dot_index }})">
                    {{- pill_text -}}
                  </span>
                {% endif %}
              {% endfor %}

              {% if section.settings.ce_text != blank %}
                <span class="sk-pill sk-pill--cert">{{ section.settings.ce_text }}</span>
              {% endif %}
            </div>
          {% endif %}

          <!-- OFFER SELECTOR (Single vs Bundle) -->
          <div class="sk-offer-cards" data-sk-offer-cards>
            <!-- SINGLE -->
            <label class="sk-offer-card" data-sk-offer-card="single">
              <input type="radio" name="sk-offer" value="single" checked>
              <div class="sk-offer-card__inner">
                <div class="sk-offer-card__image-wrapper">
                  <img
                    src="{{ product.featured_image | image_url: width: 640 }}"
                    alt="{{ single_image_alt | escape }}"
                    class="sk-offer-card__image"
                    width="640"
                    height="640"
                    loading="lazy"
                  >
                </div>
                <div class="sk-offer-card__content">
                  <div>
                    <div class="sk-offer-card__title">{{ product.title }}</div>
                  </div>
                  <div class="sk-offer-card__price" data-sk-card-price="single">
                    <div class="sk-price">
                      <span class="sk-price__value">
                        {%- if base_variant.compare_at_price and base_variant.compare_at_price > base_variant.price -%}
                          {{ base_variant.compare_at_price | money_without_trailing_zeros }}
                        {%- endif -%}
                      </span>
                      <span class="sk-price__current">
                        {{ base_variant.price | money_without_trailing_zeros }}
                      </span>
                      {%- if base_variant.compare_at_price and base_variant.compare_at_price > base_variant.price -%}
                        {%- assign savings_pct = base_variant.compare_at_price
                          | minus: base_variant.price
                          | times: 100
                          | divided_by: base_variant.compare_at_price
                        -%}
                        <span class="sk-price__badge">Spar {{ savings_pct }}%</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                <div class="sk-offer-card__footer" aria-hidden="true"></div>
                <span class="sk-offer-card__check" aria-hidden="true"></span>
                {%- comment -%}
                  Render notify-lenken KUN når varianten faktisk er utsolgt.
                  Ellers ligger «Gi beskjed når tilgjengelig» i rå-HTML (bare
                  CSS-skjult) og får AI/bots til å tro produktet er utsolgt —
                  i strid med JSON-LD (InStock). is-visible gjør den synlig
                  uten å vente på JS.
                {%- endcomment -%}
                {%- if base_variant.available == false -%}
                  <a
                    href="#"
                    class="sk-offer-card__notify is-visible"
                    data-sk-card-notify-button
                    data-klaviyo-backinstock
                    data-variant-id="{{ base_variant.id }}"
                    aria-label="Gi beskjed når tilgjengelig"
                  >
                    Gi beskjed når tilgjengelig
                  </a>
                {%- endif -%}
              </div>
            </label>

            <!-- BUNDLE -->
            <label
              class="sk-offer-card"
              data-sk-offer-card="bundle"
              data-sk-bundle-card
              {% if bundle_handle == blank %}
                style="display:none"
              {% endif %}
            >
              <input type="radio" name="sk-offer" value="bundle">
              <div class="sk-offer-card__inner">
                <span class="sk-offer-card__badge">Best verdi</span>
                <div class="sk-offer-card__image-wrapper">
                  <img
                    src="{{ bundle_image_obj | image_url: width: 640 }}"
                    alt="{{ bundle_image_alt | escape }}"
                    class="sk-offer-card__image"
                    width="640"
                    height="640"
                    loading="lazy"
                  >
                </div>
                <div class="sk-offer-card__content">
                  <div>
                    <div class="sk-offer-card__title">{{ bundle_title | default: 'Face + Neck Kit' }}</div>
                  </div>
                  <div class="sk-offer-card__price" data-sk-card-price="bundle">
                    <div class="sk-price">
                      <span class="sk-price__value">
                        {%- if bundle_variant.compare_at_price and bundle_variant.compare_at_price > bundle_variant.price -%}
                          {{ bundle_variant.compare_at_price | money_without_trailing_zeros }}
                        {%- endif -%}
                      </span>
                      <span class="sk-price__current">
                        {%- if bundle_variant and bundle_variant.price -%}
                          {{ bundle_variant.price | money_without_trailing_zeros }}
                        {%- else -%}
                          —
                        {%- endif -%}
                      </span>
                      {%- if bundle_variant.compare_at_price and bundle_variant.compare_at_price > bundle_variant.price -%}
                        {%- assign bundle_savings_pct = bundle_variant.compare_at_price
                          | minus: bundle_variant.price
                          | times: 100
                          | divided_by: bundle_variant.compare_at_price
                        -%}
                        <span class="sk-price__badge">Spar {{ bundle_savings_pct }}%</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                <div class="sk-offer-card__footer" aria-hidden="true"></div>
                <span class="sk-offer-card__check" aria-hidden="true"></span>
                {%- comment -%} Se kommentar over: kun ved faktisk utsolgt bundle. {%- endcomment -%}
                {%- if bundle_variant.available == false -%}
                  <a
                    href="#"
                    class="sk-offer-card__notify is-visible"
                    data-sk-card-notify-button
                    data-klaviyo-backinstock
                    data-variant-id="{{ bundle_variant.id }}"
                    aria-label="Gi beskjed når tilgjengelig"
                  >
                    Gi beskjed når tilgjengelig
                  </a>
                {%- endif -%}
              </div>
            </label>
          </div>

          <!-- SHARED PRICE SLOT (changes with offer) -->
          <div class="sk-shared-price" data-sk-shared-price>
            {% render 'sk-radiance-price', product: product, section: section, show_badges: false %}
          </div>

          {%- comment -%}
            SKINORA PDP – kan fjernes
            RISIKOAVLASTNING rett under prisen.

            Garantien lå tidligere i .sk-trust-inline under kjøpsknappen, på
            13px versaler i #6c6c6c — og på mobil på order: 9, altså etter
            tilbudskortene og langt under folden. En førstegangskjøper som
            skal bruke 3 690 kr hos et ukjent merke så den aldri.

            Plassert rett etter prisen med vilje: innvendingen «det er dyrt»
            oppstår i det øyeblikket tallet leses, og svaret skal komme der,
            ikke fire skjermhøyder senere.

            Ikonene er de samme to som sto i trust-raden. «Trygg betaling»
            blir stående der den var.
          {%- endcomment -%}
          <div class="sk-risk-reversal">
            <p class="sk-risk-reversal__primary">
              <svg class="sk-risk-reversal__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              <span>Prøv hjemme i 30 dager &ndash; pengene tilbake</span>
            </p>
            <p class="sk-risk-reversal__secondary">
              <svg class="sk-risk-reversal__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
              <span>Gratis frakt i Norge</span>
            </p>
          </div>

          {%- comment -%} Lenke til guiden. Ikke på landingssidene (noindex, skal ikke røres). {%- endcomment -%}
          {%- unless template.suffix contains 'sk-lp' -%}
            <p class="sk-compare-link"><a href="/collections/rodlysmaske">Usikker på hvilken? Sammenlign maskene →</a></p>
          {%- endunless -%}

          {%- comment -%}
            ÆRLIG PRIS — skjules mens kampanjen går. «Ingen rabattkupp. Ingen
            falske «før»-priser.» rett over en strøket førpris er en direkte
            selvmotsigelse. Betinget i stedet for slettet, så budskapet kommer
            tilbake av seg selv når bryteren slås av.

            Gates nå på BÅDE kampanjestatus og produktets egne priser: har
            produktet en «Sammenlign med»-pris over prisen, vises en strøket
            førpris på siden uansett bryter — og da er «ingen falske
            før-priser» like selvmotsigende.
          {%- endcomment -%}
          {%- capture honesty_campaign -%}{%- render 'sk-campaign-live' -%}{%- endcapture -%}
          {%- assign honesty_on_sale = false -%}
          {%- if product.compare_at_price > product.price -%}{%- assign honesty_on_sale = true -%}{%- endif -%}
          {%- if section.settings.honesty_show and honesty_on_sale == false and honesty_campaign == blank -%}
            <div class="sk-price-honesty">
              {%- if section.settings.honesty_heading != blank -%}
                <p class="sk-price-honesty__title">{{ section.settings.honesty_heading }}</p>
              {%- endif -%}
              {%- if section.settings.honesty_body != blank -%}
                {%- comment -%}
                  [pris]-token i body-teksten erstattes dynamisk med produktets aktuelle pris.
                  Slik følger teksten produktet (Clear: 4 390 kr, Radiance: 4 690 kr) uten
                  manuell oppdatering, og du slipper troverdighetsbrudd hvis pris endres.
                {%- endcomment -%}
                {%- assign sk_formatted_price = product.price | money_without_trailing_zeros -%}
                {%- assign sk_honesty_body = section.settings.honesty_body | replace: '[pris]', sk_formatted_price -%}
                <div class="sk-price-honesty__body">{{ sk_honesty_body }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%}
            Kampanjestripe – vises kun når tema-innstillingen «Kampanje aktiv»
            er på. Besparelsen regnes fra produktets egen pris vs «sammenlign
            med»-pris, så hver produktside viser sitt eget, korrekte tall.
          {%- endcomment -%}
          {% render 'sk-campaign-banner', product: product, layout: 'inline' %}

          <!-- PURCHASE -->
          <div class="sk-purchase">
            <!-- Buy buttons wrapper (we toggle this) -->
            <div data-sk-buy-wrapper>
              {% if shop.enabled_payment_types.size > 0 %}
                {%- assign excluded_payment_types = 'american_express,unionpay' | split: ',' -%}
                <div class="payment-icons">
                  <ul class="payment-icons__list">
                    {% for type in shop.enabled_payment_types %}
                      {%- unless excluded_payment_types contains type -%}
                        <li class="payment-icons__item">
                          {{ type | payment_type_svg_tag }}
                        </li>
                      {%- endunless -%}
                    {% endfor %}
                    {%- comment -%} Vipps - Third-party payment gateway not in Shopify's native list {%- endcomment -%}
                    {% if settings.show_vipps_payment_icon %}
                      <li class="payment-icons__item">
                        <img src="{{ 'icon-vipps.svg' | asset_url }}" alt="Vipps" height="22" width="55">
                      </li>
                    {% endif %}
                  </ul>
                </div>
              {% endif %}
              {% render 'sk-radiance-buy-buttons',
                product: product,
                product_form_id: product_form_id,
                section_id: section.id
              %}
            </div>

            {%- comment -%}
              SKINORA PDP – kan fjernes
              «Gratis frakt i Norge» og «Prøv hjemme i 30 dager» er flyttet
              herfra til .sk-risk-reversal rett under prisen. «Trygg betaling»
              står igjen — den er en kvittering på kjøpsøyeblikket og hører
              hjemme ved knappen, ikke ved prisen.
            {%- endcomment -%}
            <div class="sk-trust-inline">
              <span class="sk-trust-inline__item">
                <svg class="sk-trust-inline__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>Trygg betaling</span>
              </span>
            </div>

            {% assign trust_badges_source = product_info.trust_badges | default: blank %}
            {% assign trust_badges_value = trust_badges_source.value | default: trust_badges_source %}
            {% assign trust_badges_size = trust_badges_value | size %}
            {% if trust_badges_value != blank and trust_badges_size > 0 %}
              <div class="sk-payment sk-trust-icons">
                {% for badge in trust_badges_value %}
                  {% assign badge_img = badge.url | default: badge.image | default: badge.src | default: badge %}
                  {% assign badge_alt = badge.alt | default: badge.alt_text | default: 'Trust badge' %}
                  {% if badge_img != blank %}
                    <span class="sk-trust-icon">
                      <img
                        src="{{ badge_img | image_url: width: 60 }}"
                        alt="{{ badge_alt }}"
                        width="60"
                        height="22"
                        loading="lazy"
                      >
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if product_info.radiance_content.value != blank %}
              <div class="sk-hero-info">
                {{ product_info.radiance_content | metafield_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  </div>

  {% if media_images.size > 0 %}
    <div
      id="sk-hero-lightbox-{{ section.id }}"
      class="sk-hero-lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="{{ product.title | escape }} – bildegalleri"
      hidden
    >
      <div class="sk-hero-lightbox__stage">
        {% for image in media_images %}
          <div class="sk-hero-lightbox__slide" data-lightbox-index="{{ forloop.index0 }}">
            <img
              src="{{ image | image_url: width: 1200 }}"
              srcset="{{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 2048 }} 2048w"
              sizes="100vw"
              alt="{{ image.alt | default: product.title | escape }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              loading="lazy"
            >
          </div>
        {% endfor %}
      </div>
      <button class="sk-hero-lightbox__close" type="button" aria-label="Lukk bildegalleri">&times;</button>
      {% if media_images.size > 1 %}
        <button class="sk-hero-lightbox__nav sk-hero-lightbox__nav--prev" type="button" aria-label="Forrige bilde">‹</button>
        <button class="sk-hero-lightbox__nav sk-hero-lightbox__nav--next" type="button" aria-label="Neste bilde">›</button>
        <div class="sk-hero-lightbox__counter" aria-live="polite"></div>
      {% endif %}
    </div>
  {% endif %}

  {% render 'sk-radiance-sticky-bar', section: section, product: product, product_form_id: product_form_id %}

  {%- comment -%}
    Måler om kjøpsknappen i det hele tatt blir sett. Se snippeten for hvorfor
    dette ikke er det samme som konverteringsraten.
  {%- endcomment -%}
  {%- render 'sk-atc-visibility-tracking' -%}

  {%- comment -%} Seksjonen viser «Gratis frakt i Norge», saa JSON-LD kan si det samme. {%- endcomment -%}
  {%- render 'sk-product-jsonld', pj_free_shipping: true -%}

  <script>
    document.addEventListener('DOMContentLoaded', async function () {
      // =========================
      // HERO SWIPER
      // =========================
      (function initHeroSwiper() {
        if (typeof Swiper === 'undefined') return;

        const sectionEl = document.getElementById('sk-radiance-product-hero-{{ section.id }}');
        if (!sectionEl) return;

        const swiperRoot = sectionEl.querySelector('.sk-hero-media-swiper');
        if (!swiperRoot) return;

        const swiperElement = swiperRoot.querySelector('.swiper') || swiperRoot;
        if (!swiperElement) return;

        const prevButton = swiperRoot.querySelector('.sk-hero-arrow--prev');
        const nextButton = swiperRoot.querySelector('.sk-hero-arrow--next');
        const thumbnails = sectionEl.querySelectorAll('.sk-hero-thumb img');
        const galleryPrevButton = sectionEl.querySelector('.sk-hero-gallery-controls .sk-hero-arrow--prev');
        const galleryNextButton = sectionEl.querySelector('.sk-hero-gallery-controls .sk-hero-arrow--next');
        const galleryRow = sectionEl.querySelector('.sk-hero-gallery');

        const slideCount = thumbnails.length || swiperElement.querySelectorAll('.swiper-slide').length;
        const shouldLoop = slideCount > 1;

        /* slidesPerView: 1 — IKKE endre til en broekdel her.
           Et forsoek paa peek-kant (1.08, senere 1.18) ble rullet tilbake:
           hero-bildene har tekst bakt inn i selve filen ("UKE 4-6",
           "JEVNERE HUDTONE" osv.), og siden slidene bruker
           object-fit: cover, beskjaerer en smalere slide teksten bort.
           Paa 375px krympet sliden fra 375 til 316 px og kuttet ordene i
           begge kanter.

           Peek er dessuten feil virkemiddel for dette galleriet: kantene av
           produktbildene er samme flate krem (maalt rgb(244,236,228) paa
           begge sider), saa selv en bred kant hadde ingenting aa vise.
           Karusellene som TAALER peek er sk-before-after og
           sk-led-light-work — der er kortene innholdsrike helt ut i kanten. */
        const swiperOptions = {
          slidesPerView: 1,
          loop: shouldLoop,
          allowTouchMove: true,
          speed: 400,
        };
        if (prevButton && nextButton) swiperOptions.navigation = { prevEl: prevButton, nextEl: nextButton };

        const heroSwiper = new Swiper(swiperElement, swiperOptions);

        /* Ruller kun raden sidelengs. scrollIntoView ville ogsaa flyttet
           selve siden naar raden ligger utenfor skjermen. */
        function centerThumbInRow(thumb) {
          if (!galleryRow || !thumb) return;
          const rowRect = galleryRow.getBoundingClientRect();
          const thumbRect = thumb.getBoundingClientRect();
          if (!rowRect.width) return;
          const left = galleryRow.scrollLeft + (thumbRect.left - rowRect.left) - (rowRect.width - thumbRect.width) / 2;
          galleryRow.scrollTo({ left: left, behavior: 'smooth' });
        }

        function updateActiveThumb(index) {
          thumbnails.forEach((thumb, thumbIndex) => {
            thumb.classList.toggle('is-active', thumbIndex === index);
          });
          centerThumbInRow(thumbnails[index]);
        }

        updateActiveThumb(typeof heroSwiper.realIndex === 'number' ? heroSwiper.realIndex : heroSwiper.activeIndex || 0);

        heroSwiper.on('slideChange', function () {
          const index = typeof heroSwiper.realIndex === 'number' ? heroSwiper.realIndex : heroSwiper.activeIndex;
          updateActiveThumb(index);
        });

        thumbnails.forEach((thumb, index) => {
          thumb.addEventListener('click', function () {
            if (shouldLoop && typeof heroSwiper.slideToLoop === 'function') {
              heroSwiper.slideToLoop(index);
              return;
            }
            heroSwiper.slideTo(index);
          });
        });

        function scrollGallery(direction) {
          if (!galleryRow) return;
          const step = Math.max(150, galleryRow.clientWidth * 0.6);
          galleryRow.scrollBy({ left: direction === 'next' ? step : -step, behavior: 'smooth' });
        }

        if (galleryPrevButton) galleryPrevButton.addEventListener('click', () => scrollGallery('prev'));
        if (galleryNextButton) galleryNextButton.addEventListener('click', () => scrollGallery('next'));

        // ---- Lightbox: klikk på hero-bilde forstørrer galleriet ----
        const lightbox = document.getElementById('sk-hero-lightbox-{{ section.id }}');
        if (lightbox) {
          const lbSlides = Array.from(lightbox.querySelectorAll('.sk-hero-lightbox__slide'));
          const lbCounter = lightbox.querySelector('.sk-hero-lightbox__counter');
          const lbClose = lightbox.querySelector('.sk-hero-lightbox__close');
          const lbPrev = lightbox.querySelector('.sk-hero-lightbox__nav--prev');
          const lbNext = lightbox.querySelector('.sk-hero-lightbox__nav--next');
          let lbIndex = 0;
          let lastFocused = null;

          function lbSetActive(index) {
            lbIndex = (index + lbSlides.length) % lbSlides.length;
            lbSlides.forEach((slide, i) => slide.classList.toggle('is-active', i === lbIndex));
            if (lbCounter) lbCounter.textContent = lbIndex + 1 + ' / ' + lbSlides.length;
          }

          function lbOnKeydown(e) {
            if (e.key === 'Escape') closeLightbox();
            else if (e.key === 'ArrowLeft') lbSetActive(lbIndex - 1);
            else if (e.key === 'ArrowRight') lbSetActive(lbIndex + 1);
          }

          function openLightbox(index) {
            lastFocused = document.activeElement;
            lbSetActive(index);
            lightbox.hidden = false;
            document.body.style.overflow = 'hidden';
            document.addEventListener('keydown', lbOnKeydown);
            if (lbClose) lbClose.focus();
          }

          function closeLightbox() {
            lightbox.hidden = true;
            document.body.style.overflow = '';
            document.removeEventListener('keydown', lbOnKeydown);
            if (shouldLoop && typeof heroSwiper.slideToLoop === 'function') heroSwiper.slideToLoop(lbIndex);
            else heroSwiper.slideTo(lbIndex);
            if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
          }

          swiperElement.addEventListener('click', function (e) {
            if (!e.target.closest('.swiper-slide img')) return;
            const index = typeof heroSwiper.realIndex === 'number' ? heroSwiper.realIndex : heroSwiper.activeIndex || 0;
            openLightbox(index);
          });

          if (lbClose) lbClose.addEventListener('click', closeLightbox);
          if (lbPrev) lbPrev.addEventListener('click', () => lbSetActive(lbIndex - 1));
          if (lbNext) lbNext.addEventListener('click', () => lbSetActive(lbIndex + 1));

          // Klikk på bakgrunnen (utenfor selve bildet) lukker
          lightbox.addEventListener('click', function (e) {
            if (
              e.target.classList.contains('sk-hero-lightbox__slide')
              || e.target.classList.contains('sk-hero-lightbox__stage')
            ) {
              closeLightbox();
            }
          });

          // Swipe på mobil
          let lbStartX = 0;
          let lbSwiping = false;
          lightbox.addEventListener(
            'touchstart',
            function (e) {
              if (!e.touches || e.touches.length !== 1) return;
              lbStartX = e.touches[0].clientX;
              lbSwiping = true;
            },
            { passive: true }
          );
          lightbox.addEventListener('touchend', function (e) {
            if (!lbSwiping || !e.changedTouches || e.changedTouches.length !== 1) return;
            const deltaX = e.changedTouches[0].clientX - lbStartX;
            if (Math.abs(deltaX) > 40) lbSetActive(deltaX < 0 ? lbIndex + 1 : lbIndex - 1);
            lbSwiping = false;
          });
        }
      })();

      // =========================
      // OFFER SWITCHING (Single vs Bundle)
      // - Updates: hidden variant id, shared price, buy/notify, card prices, sold-out state
      // =========================
      const root = document.getElementById('sk-radiance-product-hero-{{ section.id }}');
      if (!root) return;

      const baseHandle = root.dataset.baseHandle;
      const bundleHandleFromMeta = root.dataset.bundleHandle;
      const moneyFormat = root.dataset.moneyFormat || '{{ shop.money_format | escape }}';
      const baseTitle = {{ product.title | json }};
      const bundleTitleFallback = {{ bundle_title | default: product.title | json }};

      // If you do NOT use metafield custom.bundle_product, put your bundle handle here:
      const fallbackBundleHandle = '';
      const bundleHandle = bundleHandleFromMeta || fallbackBundleHandle;

      const baseVariant = {
        id: {{ product.selected_or_first_available_variant.id | json }},
        price: {{ product.selected_or_first_available_variant.price | json }},
        compare_at_price: {{ product.selected_or_first_available_variant.compare_at_price | json }},
        available: {{ product.selected_or_first_available_variant.available | json }}
      };

      const offerRadios = root.querySelectorAll('input[name="sk-offer"]');
      const bundleCard = root.querySelector('[data-sk-bundle-card]');
      const singleCard = root.querySelector('[data-sk-offer-card="single"]');
      const bundleCardWrap = root.querySelector('[data-sk-offer-card="bundle"]');

      const hiddenVariantInput = root.querySelector('[data-sk-selected-variant-id]');
      const sharedPriceEl = root.querySelector('[data-sk-shared-price]');
      const buyWrapper = root.querySelector('[data-sk-buy-wrapper]');
      const notifyWrapper = root.querySelector('[data-sk-notify-wrapper]');
      const notifyBtn = root.querySelector('[data-sk-notify-button]');

      const cardPriceBundle = root.querySelector('[data-sk-card-price="bundle"]');

      const productForm =
        root.querySelector('form[action^="/cart/add"]') ||
        root.querySelector('form[action*="/cart/add"]') ||
        document.querySelector('form[action^="/cart/add"]') ||
        document.querySelector('form[action*="/cart/add"]');

      const mainProductSection = document.getElementById('MainProduct-{{ section.id }}');

      const applyVariantToInput = (input, variantId) => {
        if (!input || !variantId) return;
        const nextValue = String(variantId);
        input.value = nextValue;
        input.setAttribute('value', nextValue);
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      };

      const getVariantInputs = () => {
        const inputs = [];

        if (productForm) {
          inputs.push(...productForm.querySelectorAll('input[name="id"]'));
          inputs.push(...productForm.querySelectorAll('.product-variant-id'));
        }

        inputs.push(...root.querySelectorAll('input[name="id"]'));
        inputs.push(...root.querySelectorAll('.product-variant-id'));

        return Array.from(new Set(inputs));
      };
      window.__SK_ACTIVE_VARIANT_ID = window.__SK_ACTIVE_VARIANT_ID || baseVariant.id;
      window.__SK_ACTIVE_OFFER = window.__SK_ACTIVE_OFFER || 'single';

      const clearProductFormErrors = () => {
        document.querySelectorAll('.product-form__error-message-wrapper').forEach((wrap) => {
          wrap.hidden = true;
          wrap.style.display = 'none';
          const msg = wrap.querySelector('.product-form__error-message');
          if (msg) msg.textContent = '';
        });

        document
          .querySelectorAll('[data-product-form-error], .form__message, .product-form__error')
          .forEach((el) => {
            el.hidden = true;
            el.style.display = 'none';
            if (el.tagName === 'P' || el.tagName === 'DIV') el.textContent = '';
          });
      };

      const setActiveVariantId = (variantId, offer = 'single') => {
        if (!variantId) return [];

        window.__SK_ACTIVE_VARIANT_ID = variantId;
        window.__SK_ACTIVE_OFFER = offer;

        applyVariantToInput(hiddenVariantInput, variantId);

        const inputs = getVariantInputs();

        inputs.forEach((input) => applyVariantToInput(input, variantId));

        // Force-update any other common id inputs (dynamic checkout / buy-now patterns)
        root.querySelectorAll('input[name="id"], input[name="items[0][id]"]').forEach((el) => {
          applyVariantToInput(el, variantId);
        });

        /* Seksjonen «Hva kan du forvente» rendrer sin egen form.lp-cta-form
           UTENFOR denne seksjonen, så ingen av selektorene over treffer den.
           Målt 22. aug: skjemaet beholdt base-varianten selv når kunden hadde
           valgt Face + Neck.

           sk-lp-cart-add.js leser nå window.__SK_ACTIVE_VARIANT_ID og legger
           riktig variant i kurven uansett, så dette er ikke lenger en aktiv
           feil. Men skjemaet skal ikke stå igjen med feil verdi: svikter
           globalen, faller skriptet tilbake på nettopp dette feltet — og da er
           den gamle feilen stille tilbake.

           Selektoren er bevisst smal. Et document-wide input[name="id"] ville
           truffet handlekurvskuffen og produktkort. */
        document.querySelectorAll('form.lp-cta-form input[name="id"]').forEach((el) => {
          applyVariantToInput(el, variantId);
        });

        if (mainProductSection) {
          mainProductSection
            .querySelectorAll(
              'form[action^="/cart/add"], form[action*="/cart/add"], form[action^="/cart"], form[action*="/cart"]'
            )
            .forEach((form) => {
              form.querySelectorAll('input[name="id"], .product-variant-id, [data-sk-selected-variant-id]').forEach((el) => {
                applyVariantToInput(el, variantId);
              });
            });
        }

        clearProductFormErrors();

        return inputs;
      };


      const normalizeMoneyString = (value) =>
        typeof value === 'string' ? value.trim() : value;

      const defaultMoneyFormat = moneyFormat || '{% raw %}{{ amount }}{% endraw %}';

      const formatWithDelimiters = (amountInCents, precision = 2, thousands = ',', decimal = '.') => {
        if (amountInCents == null || isNaN(amountInCents)) return '0';

        const negative = amountInCents < 0 ? '-' : '';
        const base = Math.abs(amountInCents / 100).toFixed(Math.max(precision, 0));
        const [integerPart, decimalPart = ''] = base.split('.');
        const formattedInteger = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, thousands);

        if (precision === 0) {
          return `${negative}${formattedInteger}`;
        }

        return `${negative}${formattedInteger}${decimal}${decimalPart}`;
      };

      const formatMoneyFallback = (cents, formatString = defaultMoneyFormat) => {
        let value = typeof cents === 'string' ? cents.replace('.', '') : cents;
        value = isNaN(value) ? 0 : Number(value);

        const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        const formatMatch = formatString.match(placeholderRegex);
        const placeholder = formatMatch ? formatMatch[1] : 'amount';
        let formattedValue = '';

        switch (placeholder) {
          case 'amount_no_decimals':
            formattedValue = formatWithDelimiters(value, 0);
            break;
          case 'amount_with_comma_separator':
            formattedValue = formatWithDelimiters(value, 2, '.', ',');
            break;
          case 'amount_no_decimals_with_comma_separator':
            formattedValue = formatWithDelimiters(value, 0, '.', ',');
            break;
          case 'amount_no_decimals_with_space_separator':
            formattedValue = formatWithDelimiters(value, 0, ' ', ',');
            break;
          case 'amount_no_decimals_with_apostrophe_separator':
            formattedValue = formatWithDelimiters(value, 0, "'", '.');
            break;
          case 'amount':
          default:
            formattedValue = formatWithDelimiters(value, 2);
        }

        return formatString.replace(placeholderRegex, formattedValue);
      };

      const formatMoney = (cents) => {
        try {
          if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
            return normalizeMoneyString(window.Shopify.formatMoney(cents, moneyFormat));
          }
        } catch (e) {}
        return normalizeMoneyString(formatMoneyFallback(cents));
      };

      const fetchProductJson = async (handle) => {
        const safeHandle = encodeURIComponent(String(handle || '').trim());
        const res = await fetch(`/products/${safeHandle}.js`, { credentials: 'same-origin' });
        if (!res.ok) throw new Error(`Failed to load product JSON: ${handle}`);
        return await res.json();
      };

      const calcSavingsPercent = (compareAt, price) => {
        if (!compareAt || !price || compareAt <= price) return 0;
        return Math.round(((compareAt - price) / compareAt) * 100);
      };

      const ensureBadgeEl = (container) => {
        let badge = container.querySelector('.sk-price__badge');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'sk-price__badge';
          container.appendChild(badge);
        }
        return badge;
      };

      const pickDefaultVariant = (productJson) => {
        if (!productJson || !productJson.variants) return null;
        return productJson.variants.find((v) => v.available) || productJson.variants[0] || null;
      };

      const replaceSharedPrice = (variant) => {
        if (!sharedPriceEl || !variant) return;

        const valueEl = sharedPriceEl.querySelector('.sk-price__value');
        const currentEl = sharedPriceEl.querySelector('.sk-price__current');
        if (!currentEl) return;

        const priceContainer = currentEl.closest('.sk-price') || sharedPriceEl;
        const badgeEl = ensureBadgeEl(priceContainer);

        const compareAt = variant.compare_at_price;
        const price = variant.price;

        const shouldShowCompare = compareAt && compareAt > price;
        const pct = calcSavingsPercent(compareAt, price);

        if (valueEl) {
          valueEl.textContent = shouldShowCompare ? formatMoney(compareAt) : '';
          valueEl.removeAttribute('hidden');
          valueEl.style.visibility = shouldShowCompare ? 'visible' : 'hidden';
        }

        badgeEl.textContent = shouldShowCompare && pct > 0 ? `Spar ${pct}%` : '';

        currentEl.textContent = formatMoney(price);
      };

      const setAvailabilityUI = (available) => {
        if (buyWrapper) buyWrapper.style.display = available ? '' : 'none';
        if (notifyWrapper) notifyWrapper.style.display = available ? 'none' : 'block';
      };

      const setSubmitAvailabilityUI = (available) => {
        const scope = mainProductSection || root;
        if (!scope) return;

        const forms = Array.from(
          scope.querySelectorAll('form[action^="/cart/add"], form[action*="/cart/add"]')
        );
        if (!forms.length && productForm) forms.push(productForm);

        forms.forEach((form) => {
          const productFormEl = form.closest('product-form') || form;
          const submitBtn = productFormEl.querySelector('button[type="submit"], input[type="submit"]');
          if (!submitBtn) return;

          if (available) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('aria-disabled');
          } else {
            submitBtn.setAttribute('disabled', 'disabled');
            submitBtn.setAttribute('aria-disabled', 'true');
          }

          const soldOutMessage = submitBtn.querySelector('.sold-out-message');
          const submitText = submitBtn.querySelector('span');
          if (soldOutMessage && submitText) {
            soldOutMessage.classList.toggle('hidden', !!available);
            submitText.classList.toggle('hidden', !available);
          }
        });
      };

      const setCardUnavailable = (cardEl, isUnavailable, variantId) => {
        if (!cardEl) return;
        cardEl.classList.toggle('is-unavailable', !!isUnavailable);
        cardEl.setAttribute('aria-disabled', isUnavailable ? 'true' : 'false');
        const cardNotifyBtn = cardEl.querySelector('[data-sk-card-notify-button]');
        if (cardNotifyBtn) {
          if (variantId) {
            cardNotifyBtn.setAttribute('data-variant-id', variantId);
          }
          cardNotifyBtn.classList.toggle('is-visible', !!isUnavailable);
        }
        const radioInput = cardEl.querySelector('input[type="radio"]');
        if (radioInput) {
          radioInput.disabled = !!isUnavailable;
        }
      };

      const setNotifyVariant = (variantId) => {
        if (!notifyBtn) return;
        notifyBtn.setAttribute('data-variant-id', variantId);
      };

      const openNotifyFlow = (variantId) => {
        if (!notifyWrapper) return;
        if (variantId) setNotifyVariant(variantId);
        notifyWrapper.style.display = 'block';
        notifyWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (notifyBtn) notifyBtn.click();
      };

      const cardNotifyButtons = root.querySelectorAll('[data-sk-card-notify-button]');
      cardNotifyButtons.forEach((btn) => {
        btn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          openNotifyFlow(btn.dataset.variantId || root.dataset.baseVariantId);
        });
      });

      const setBundleCardPrice = (variant) => {
        if (!cardPriceBundle || !variant) return;
        const valueEl = cardPriceBundle.querySelector('.sk-price__value');
        const currentEl = cardPriceBundle.querySelector('.sk-price__current');
        const priceContainer = (currentEl && currentEl.closest('.sk-price')) || cardPriceBundle;
        const badgeEl = ensureBadgeEl(priceContainer);

        const pct = calcSavingsPercent(variant.compare_at_price, variant.price);

        if (valueEl) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            valueEl.textContent = formatMoney(variant.compare_at_price);
          } else {
            valueEl.textContent = '';
          }
        }
        badgeEl.textContent = pct > 0 ? `Spar ${pct}%` : '';
        if (currentEl) {
          currentEl.textContent = formatMoney(variant.price);
        }
      };

      const hydrateBundleCard = async () => {
        if (!bundleHandle) {
          if (bundleCard) bundleCard.style.display = 'none';
          return null;
        }

        try {
          const bundleJson = await fetchProductJson(bundleHandle);
          const bundleVariant = pickDefaultVariant(bundleJson);
          if (!bundleVariant) return null;

          setBundleCardPrice(bundleVariant);
          setCardUnavailable(bundleCardWrap, !bundleVariant.available, bundleVariant.id);

          return { product: bundleJson, variant: bundleVariant };
        } catch (e) {
          if (bundleCard) bundleCard.style.display = 'none';
          return null;
        }
      };

      const applyOffer = async (offerType, bundleData) => {
        let activeVariant = null;
        let activeProductId = null;

        if (offerType === 'single') {
          activeVariant = baseVariant;
          activeProductId = root.dataset.baseProductId;
        }

        if (offerType === 'bundle') {
          if (!bundleData || !bundleData.variant) return;
          activeVariant = bundleData.variant;
          activeProductId = bundleData.product?.id;
        }

        if (!activeVariant) return;

        setActiveVariantId(activeVariant.id, offerType);
        setNotifyVariant(activeVariant.id);
        
        // Update product-id input if it exists
        const productIdInputs = document.querySelectorAll('input[name="product-id"]');
        if (productIdInputs.length && activeProductId) {
          productIdInputs.forEach(input => {
            input.value = activeProductId;
          });
        }
        
        replaceSharedPrice(activeVariant);
        setAvailabilityUI(!!activeVariant.available);
        setSubmitAvailabilityUI(!!activeVariant.available);

        setCardUnavailable(singleCard, offerType === 'single' && !activeVariant.available, baseVariant.id);
        setCardUnavailable(bundleCardWrap, offerType === 'bundle' && !activeVariant.available, (bundleData && bundleData.variant) ? bundleData.variant.id : null);

        const offerTitle = offerType === 'bundle'
          ? (bundleData && bundleData.product && bundleData.product.title) || bundleTitleFallback || baseTitle
          : baseTitle;

        const priceText = formatMoney(activeVariant.price);
        const savingsPct = calcSavingsPercent(activeVariant.compare_at_price, activeVariant.price);
        const compareText =
          activeVariant.compare_at_price && activeVariant.compare_at_price > activeVariant.price
            ? formatMoney(activeVariant.compare_at_price)
            : '';
        const badgeText = savingsPct > 0 ? `Spar ${savingsPct}%` : '';
        document.dispatchEvent(new CustomEvent('sk:offerchange', {
          detail: {
            offer: offerType,
            variantId: activeVariant.id,
            price: activeVariant.price,
            compare_at_price: activeVariant.compare_at_price,
            priceText,
            compareText,
            badgeText,
            available: activeVariant.available,
            handle: offerType === 'single' ? baseHandle : bundleHandle,
            title: offerTitle
          }
        }));
      };

      const handleOfferChangeEvent = (event) => {
        const detail = event && event.detail;
        if (!detail || !detail.variantId) return;
        setActiveVariantId(detail.variantId, detail.offer || 'single');
      };

      document.addEventListener('sk:offerchange', handleOfferChangeEvent);

      // 1) Hydrate bundle card + store data
      const bundleData = await hydrateBundleCard();

      // 2) Listen to offer changes
      offerRadios.forEach((radio) => {
        radio.addEventListener('change', async function () {
          if (!this.checked) return;

          try {
            if (this.value === 'bundle') {
              await applyOffer('bundle', bundleData);
            } else {
              await applyOffer('single', bundleData);
            }
          } catch (e) {
            // fail safe: revert to single
            offerRadios.forEach((r) => {
              if (r.value === 'single') r.checked = true;
            });
            await applyOffer('single', bundleData);
          }
        });
      });

      // 3) Ensure initial offer is applied AND sticky bar is hydrated
      clearProductFormErrors();
      await applyOffer('single', bundleData);
    });
  </script>
</product-info>

