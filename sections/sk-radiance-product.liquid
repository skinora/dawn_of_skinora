<link rel="stylesheet" href="{{ 'sk-pdp-overrides.css' | asset_url }}" media="print" onload="this.media='all'">

<style>
    /* =============================
       BASE LAYOUT
    ============================= */

    .sk-product-hero {
      --sk-brand: var(--color-brand, var(--ink-900));
      --sk-border: var(--color-border, #e7e7ed);
      --sk-pill-border: var(--color-border-light, #d4d4dc);
      --sk-neutral-contrast: var(--color-neutral-2, #7a7a85);
      --sk-hero-muted: rgba(var(--color-brand-rgb), 0.06);
      --sk-info-divider: var(--color-bg-light, #f1eff4);
      --sk-info-muted: var(--color-neutral-4, #8c8c95);
      padding: 2rem 0 3rem;
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
    }

    .sk-hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sk-product-hero,
    .sk-hero-grid,
    .sk-hero-media,
    .sk-hero-content {
      width: 100%;
      box-sizing: border-box;
      min-width: 0;
      max-inline-size: 100%;
    }

    @media (min-width: 990px) {
      .sk-hero-grid {
        grid-template-columns: minmax(0, 45%) minmax(0, 55%);
        align-items: start;
        gap: 6rem;
      }
    }

    /* =============================
       MEDIA
    ============================ */

    .sk-hero-media {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .sk-hero-media-main {
      width: min(clamp(280px, 60vw, 750px), 100%);
      aspect-ratio: 1 / 1;
      overflow: hidden;
      border-radius: 0;
    }

    .sk-hero-media-swiper {
      width: 100%;
      height: 100%;
      position: relative;
    }

    /* ── LAGERSTATUS ──
       Foerste utkast var en tynn linje i --accent-gold. Den forsvant:
       gull paa hvitt gir 2,2:1 i kontrast, saa prikken var praktisk talt
       usynlig, og hele linja leste som en fotnote.

       Naa et fylt baand i --ink-900 over hele infokolonnen. Auberginé og
       ikke roedt med vilje: et roedt baand leser som lavprisbutikk, mens
       merkevarefargen leser som noe butikken selv har bestemt. Tallet er
       satt stort i serif — samme grep som boelgelengdene i
       sk-led-light-work: tallet ER budskapet, saa det faar baere flaten.
       Skarpe hjoerner som resten av huset. Ingen animasjon. */
    /* Diffus flate i stedet for fylt boks. To radiale gradienter i lilla og
       auberginé som toner ut i gjennomsiktig, og som deretter gjoeres uskarpe.
       Resultatet har ingen kant i det hele tatt - den bare oppstaar og
       forsvinner. backdrop-filter ville ikke gitt noe her: det er hvitt bak
       elementet, og uskarphet paa hvitt er hvitt. */
    /* Frostet glass. Samme teknikk som glass-chipsene i sk-led-stats, men
       her paa lys bakgrunn.
       Nokkelen: backdrop-filter trenger noe BAK seg for aa ha effekt, og
       siden er hvit. Derfor ligger en iriserende, uskarp fargeflate i
       ::before under panelet — det er DEN glasset gjoer uskarpt. Uten den
       ville frostingen vaert usynlig.
       Fargene er merkevarens egne: lilla, clay og gull i et varmt sveip. */
    /* Standard: roedt og naer-infraroedt (Radiance). */
    .sk-stock {
      --glow-1: var(--led-rose);
      --glow-2: var(--led-magenta);
      --glow-3: var(--led-violet);
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: var(--space-3);
      margin: var(--space-4) 0 0;
      padding: var(--space-3) var(--space-4);
      border-radius: 14px;
      background: color-mix(in srgb, var(--paper-0) 52%, transparent);
      backdrop-filter: blur(20px) saturate(170%);
      -webkit-backdrop-filter: blur(20px) saturate(170%);
      border: 1px solid color-mix(in srgb, var(--paper-0) 72%, transparent);
      box-shadow:
        0 22px 44px -28px color-mix(in srgb, var(--ink-900) 55%, transparent),
        inset 0 1px 0 color-mix(in srgb, var(--paper-0) 85%, transparent);
      color: var(--ink-900);
    }

    /* Den iriserende flaten glasset hviler paa. */
    .sk-stock::before {
      content: '';
      position: absolute;
      inset: -14px;
      z-index: -1;
      border-radius: 28px;
      /* Gloeden lyser i produktets EGEN boelgelengde. Fargene settes av
         --glow-1/2/3 paa .sk-stock, saa denne regelen er den samme uansett
         maske — bare paletten byttes. Verdiene kommer fra LED-spekteret i
         typography.css, som igjen stammer fra sk-lp-mechanism. */
      background:
        radial-gradient(
          58% 120% at 10% 45%,
          color-mix(in srgb, var(--glow-1) 82%, transparent),
          transparent 70%
        ),
        radial-gradient(
          54% 115% at 52% 100%,
          color-mix(in srgb, var(--glow-2) 55%, transparent),
          transparent 68%
        ),
        radial-gradient(
          62% 125% at 90% 12%,
          color-mix(in srgb, var(--glow-3) 68%, transparent),
          transparent 70%
        );
      filter: blur(22px);
      opacity: 0.9;
    }

    /* Blaatt lys (Clear). Kaldere sveip: periwinkle -> indigo -> blaa. */
    .sk-stock--blue {
      --glow-1: var(--led-violet);
      --glow-2: var(--led-indigo);
      --glow-3: var(--led-blue);
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .sk-stock {
        background: color-mix(in srgb, var(--paper-0) 88%, transparent);
      }
    }

    /* Tallet baerer flaten. */
    .sk-stock__count {
      font-family: var(--ff-serif);
      font-size: var(--fs-2xl);
      font-weight: var(--fw-regular);
      line-height: 0.82;
      letter-spacing: var(--tracking-tight);
      color: var(--ink-900);
    }

    /* Etikett og leveringstekst paa samme linje naar det er plass, ikke
       stablet. Sparer en hel tekstlinje over fold; brekker av seg selv
       paa smale skjermer. */
    .sk-stock__body {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: var(--space-2);
      row-gap: 2px;
      min-width: 0;
    }

    .sk-stock__label {
      font-family: var(--ff-sans);
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--tracking-wider);
      text-transform: uppercase;
      color: var(--ink-500);
    }

    .sk-stock__restock {
      font-family: var(--ff-sans);
      font-size: var(--fs-sm);
      font-weight: var(--fw-regular);
      line-height: var(--lh-snug);
      color: var(--ink-900);
    }

    .sk-hero-media-swiper .swiper {
      width: 100%;
      height: 100%;
    }

    /* Full containerbredde. Dette laaser samtidig slidene mot broekdels
       slidesPerView, som er med vilje: se kommentaren ved swiperOptions
       om hvorfor peek ikke skal brukes i dette galleriet. Regelen er ogsaa
       sikringen hvis Swiper ikke initialiserer — uten den faar slidene
       ingen bredde og galleriet kollapser. */
    .sk-hero-media-swiper .swiper-slide {
      width: 100%;
      height: 100%;
    }

    .sk-hero-media-main img,
    .sk-hero-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .sk-hero-gallery-wrapper {
      width: min(clamp(240px, 65vw, 750px), 100%);
      margin-top: 0.75rem;
      position: relative;
    }

    /* IMPORTANT: allow horizontal scroll */
    .sk-hero-gallery {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 110px;
      gap: clamp(0.5rem, 1vw, 0.75rem);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding: 0.25rem 0;
      scrollbar-width: thin;
      scrollbar-color: rgba(var(--color-foreground), 0.4) transparent;
    }

    .sk-hero-gallery::-webkit-scrollbar {
      height: 8px;
    }

    .sk-hero-gallery::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.15);
      border-radius: 999px;
    }

    .sk-hero-thumb {
      width: 100%;
      aspect-ratio: 1 / 1;
      scroll-snap-align: start;
    }

    .sk-hero-thumb img {
      border-radius: 10px;
      cursor: pointer;
      opacity: 0.85;
      transition: opacity 0.15s ease;
    }

    .sk-hero-thumb img.is-active,
    .sk-hero-thumb img:hover {
      opacity: 1;
    }

    .sk-hero-progress {
      display: none;
      gap: 0.75rem;
      justify-content: center;
      margin-top: 1rem;
    }

    .sk-hero-progress-dot {
      width: clamp(7px, 1.4vw, 9px);
      height: clamp(7px, 1.4vw, 9px);
      border: 1px solid var(--color-neutral-4, #49494a);
      background: transparent;
      border-radius: 0;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .sk-hero-progress-dot.is-active,
    .sk-hero-progress-dot:focus-visible {
      background: var(--sk-brand);
      border-color: var(--sk-brand);
    }

    .sk-hero-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: none;
      background: rgba(0, 0, 0, 0.45);
      color: var(--color-white);
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 2;
    }

    .sk-hero-arrow:focus-visible {
      outline: 2px solid var(--sk-brand);
      outline-offset: 2px;
      box-shadow: 0 0 0 4px rgba(var(--color-brand-rgb), 0.2);
    }

    .sk-hero-arrow--prev {
      left: 1rem;
    }

    .sk-hero-arrow--next {
      right: 1rem;
    }

    /* gallery arrows sit over gallery */
    .sk-hero-gallery-controls {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      pointer-events: none;
      padding: 0 0.5rem;
    }

    .sk-hero-gallery-controls .sk-hero-arrow {
      pointer-events: auto;
      background: rgba(0, 0, 0, 0.35);
      width: 34px;
      height: 34px;
    }

    /* =============================
       CONTENT
    ============================= */

    .sk-hero-content {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .sk-eyebrow {
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-neutral-2, #6b6b76);
      margin: 0;
    }

    .sk-product-title {
      font-size: 1rem;
      line-height: 1.15;
      margin: 0;
    }

    @media (min-width: 990px) {
      .sk-product-title {
        font-size: 1.25rem;
      }

      .sk-product-hero {
        padding: 3rem 0 4rem;
      }

      .sk-hero-content {
        gap: 2rem;
      }

      .sk-eyebrow {
        font-size: 1.35rem;
        letter-spacing: 0.12em;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
        font-weight: 500;
        color: var(--color-neutral-2, #6b6b76);
      }

      .sk-product-title {
        font-size: clamp(2.8rem, 3vw, 3.8rem);
        line-height: 0.45;
        margin-bottom: 0.75rem;
        font-weight: var(--fw-semibold);
      }

      .sk-product-subtitle {
        font-size: 1.9rem;
        line-height: 1.6;
        margin-bottom: 1rem;
      }

      .sk-offer-card__title {
        font-size: 2rem;
        font-weight: 600;
        line-height: 1.2;
        margin: 0;
      }

      .sk-pill {
        font-size: var(--fs-xs);
      }
    }

    /* =============================
       PILLS
    ============================= */

    /* Raden arver LED-paletten fra samme kilde som lagerbaandet, saa prikkene
       og gloeden lyser i produktets EGEN boelgelengde. Standard er roedt og
       naer-infraroedt (Radiance); --blue bytter til det kalde spekteret. */
    .sk-radiance-pills {
      --glow-1: var(--led-rose);
      --glow-2: var(--led-magenta);
      --glow-3: var(--led-violet);
      display: flex;
      gap: var(--space-2);
      flex-wrap: wrap;
      margin: 0;
    }

    .sk-radiance-pills--blue {
      --glow-1: var(--led-violet);
      --glow-2: var(--led-indigo);
      --glow-3: var(--led-blue);
    }

    /* Paddingen er strammet inn samtidig som fontstoerrelsen ble rettet.
       Uten det brakk raden til tre linjer da den fjerde pillen kom til. */
    .sk-pill {
      display: inline-flex;
      align-items: center;
      border: 1px solid var(--color-border-light, #d4d4dc);
      border-radius: 999px;
      padding: var(--space-1) var(--space-3);
      /* Var 1.15rem — det ga 11,5 px ved 10 px rot, under caption-gulvet. */
      font-size: var(--fs-xs);
      font-weight: var(--fw-medium);
      line-height: var(--lh-relaxed);
      background: var(--color-white);
    }

    /* Lyspunktet. Hvert faktum foeres av en liten diode i sin egen farge —
       --sk-dot settes per pille i Liquid og peker paa --glow-1/2/3, saa raden
       leser som et spekter og ikke som en grå liste. Gloeden er en myknet
       kopi av samme farge; uten den blir prikken en flat sirkel. */
    .sk-pill::before {
      content: '';
      flex: none;
      width: 6px;
      height: 6px;
      margin-right: var(--space-2);
      border-radius: 999px;
      background: var(--sk-dot, var(--glow-3));
      box-shadow: 0 0 6px color-mix(in srgb, var(--sk-dot, var(--glow-3)) 60%, transparent);
    }

    /* Sertifiseringspill. Samme form som produktfaktaene, men tyngre kant og
       vekt saa den leser som dokumentasjon og ikke som en egenskap.
       Haken erstatter dioden: sertifiseringen er ikke en boelgelengde. */
    .sk-pill--cert {
      gap: 0;
      border-color: var(--ink-300);
      font-weight: var(--fw-semibold);
      color: var(--ink-900);
    }

    .sk-pill--cert::before {
      content: '✓';
      width: auto;
      height: auto;
      border-radius: 0;
      background: none;
      box-shadow: none;
      margin-right: var(--space-2);
      font-size: 0.9em;
      line-height: 1;
      color: var(--ink-700);
    }

    /* =============================
       OFFER CARDS (Single vs Bundle)
    ============================= */

    .sk-offer-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, max-content));
      column-gap: var(--sk-gap-sm, 1rem);
      row-gap: var(--sk-gap-sm, 1rem);
      margin: 0;
      grid-auto-rows: auto;
      align-items: stretch;
      justify-content: flex-start;
      justify-items: start;
      max-width: 100%;
    }

    .sk-offer-card {
      cursor: pointer;
      display: flex;
      align-items: stretch;
      position: relative;
      width: 100%;
      height: 100%;
    }

    .sk-offer-card input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .sk-offer-card__inner {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 0;
      overflow: hidden;
      border-radius: 16px;
      border: 1px solid var(--sk-border);
      background: var(--color-white);
      transition: border 0.2s ease, transform 0.08s ease;
      min-height: 330px;
      flex: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      .sk-offer-card__inner {
        transition: none;
        transform: none;
      }
    }

    .sk-offer-card input:checked + .sk-offer-card__inner {
      border-color: var(--sk-brand);
      border-radius: 16px;
      box-shadow: 0 12px 34px rgba(48, 39, 62, 0.12);
    }

    .sk-offer-card input:focus-visible + .sk-offer-card__inner {
      outline: 2px solid var(--sk-brand);
      outline-offset: 4px;
      box-shadow: 0 0 0 1px rgba(var(--color-brand-rgb), 0.35);
    }

    .sk-offer-card:active .sk-offer-card__inner {
      transform: none;
    }

    .sk-offer-card__badge {
      position: absolute;
      top: 0.75rem;
      left: 0.75rem;
      z-index: 2;
      display: inline-flex;
      width: max-content;
      background: var(--sk-brand);
      color: var(--color-white);
      font-size: 1.1rem;
      padding: 0.45rem 0.75rem;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .sk-offer-card__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .sk-offer-card__notify {
      display: none;
      min-width: 0;
      text-decoration: none;
    }

    .sk-offer-card__notify.is-visible {
      display: inline-flex;
      align-self: flex-start;
      margin-top: 0.5rem;
      gap: 0.5rem;
      padding: 0;
      background: none;
      border: none;
      color: var(--sk-brand);
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      text-decoration: underline;
      cursor: pointer;
    }

    .sk-offer-card__notify.is-visible:hover,
    .sk-offer-card__notify.is-visible:focus-visible {
      text-decoration: none;
      opacity: 0.85;
    }

    .sk-offer-card__title {
      font-size: 1.5rem;
      font-weight: 600;
      line-height: 2;
      margin: 0;
    }

    .sk-offer-card__subtitle {
      font-size: 0.85rem;
      color: var(--sk-neutral-contrast, #7a7a85);
      margin: 0;
    }

    .sk-offer-card__price {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      line-height: 1;
    }

    .sk-offer-card__price .sk-price {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .sk-offer-card__price .sk-price__value {
      font-size: 1.35rem;
      font-weight: 400;
      color: var(--color-neutral-2, #9a9aa0);
      text-decoration: line-through;
      text-decoration-thickness: 1px;
      text-transform: none;
      letter-spacing: 0;
      min-height: 1.15rem;
      display: block;
    }

    .sk-offer-card__price .sk-price__value:empty {
      visibility: hidden;
      text-decoration: none;
    }

    .sk-offer-card__price .sk-price__current {
      font-size: 2.5rem;
      font-weight: 600;
      color: var(--color-neutral-4, #49494a);
      position: relative;
    }

    .sk-offer-card__price .sk-price__badge {
      display: block;
      width: auto;
      margin: 0.75rem calc(var(--sk-card-pad-x, 0.75rem) * -1) calc(var(--sk-card-pad-b, 0.9rem) * -1);
      font-size: var(--fs-xs); /* var 1.15rem = 11,5px ved 10px rot */
      font-weight: 600;
      color: var(--sk-brand, var(--ink-900));
      background: color-mix(in srgb, var(--color-lilac, #cdb7ed) 30%, #fff);
      border: none;
      padding: 0.55em 0.6em;
      border-radius: 0;
      line-height: 1.3;
      letter-spacing: 0.01em;
      text-align: center;
      white-space: nowrap;
    }

    .sk-offer-card__price .sk-price__badge:empty {
      display: none;
    }

    }

    @media (min-width: 990px) {
      .sk-offer-card__title {
        font-size: 1.6rem;
        line-height: 1.35;
        font-weight: 600;
        margin: 0;
        letter-spacing: -0.01em;
      }

      .sk-offer-cards {
        gap: 1.5rem;
      }

      .sk-offer-card {
        max-width: 280px;
      }

      .sk-offer-card__inner {
        gap: 0.75rem;
        padding: 0;
        border-radius: 16px;
        border: 1px solid #e5e5ec;
        background: #fff;
      }

      .sk-offer-card input:checked + .sk-offer-card__inner {
        border-color: var(--ink-900);
        box-shadow: 0 12px 34px rgba(48, 39, 62, 0.12);
      }

      .sk-offer-card__content {
        --sk-card-pad-x: 1.25rem;
        --sk-card-pad-b: 1.25rem;
        gap: 0.75rem;
        padding: 0 var(--sk-card-pad-x) var(--sk-card-pad-b);
      }

      .sk-offer-card__price {
        margin-top: 0.5rem;
      }

      .sk-offer-card__price .sk-price__value {
        font-size: 1.35rem;
        opacity: 0.8;
        min-height: 1.15rem;
      }

      .sk-offer-card__price .sk-price__current {
        font-size: 2.5rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--color-neutral-4, #49494a);
        margin: 0 0 1rem;
      }
    }

    .sk-offer-card__check {
      position: absolute;
      bottom: 1rem;
      right: 1rem;
      width: 11px;
      height: 11px;
      border-radius: 50%;
      border: 1px solid var(--color-border-light, #cfcfd6);
      background: var(--color-white);
      transition: border 0.2s ease, background 0.2s ease;
    }

    .sk-offer-card input:checked + .sk-offer-card__inner .sk-offer-card__check {
      background: var(--sk-brand);
      border-color: var(--sk-brand);
    }

    .sk-offer-card__footer {
      display: none;
    }

    .sk-offer-card.is-unavailable {
    }

    .sk-offer-card.is-unavailable::after {
      content: 'Utsolgt';
      position: absolute;
      top: 14px;
      left: 14px;
      font-size: 0.8rem;
      color: var(--sk-info-muted, #8c8c95);
    }
    .sk-offer-card.is-unavailable .sk-offer-card__badge,
    .sk-offer-card.is-unavailable .sk-offer-card__image-wrapper,
    .sk-offer-card.is-unavailable .sk-offer-card__content,
    .sk-offer-card.is-unavailable .sk-offer-card__check {
      opacity: 0.45;
    }

    .sk-offer-card__image-wrapper {
      width: 100%;
      aspect-ratio: 1 / 1;
      min-height: 0;
      border-radius: 0;
      background: transparent;
      overflow: hidden;
    }

    .sk-offer-card__content {
      --sk-card-pad-x: 0.75rem;
      --sk-card-pad-b: 0.9rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding: 0 var(--sk-card-pad-x) var(--sk-card-pad-b);
    }

    .sk-offer-card {
      max-width: 260px;
      width: 260px;
    }

    @media (max-width: 768px) {
      .sk-trust-icons {
        gap: 0.25rem;
      }

      .sk-trust-icon {
        flex: 1 1 80px;
        max-width: 120px;
      }

      /* Var 1.2rem = 12 px ved 10 px rot — under caption-gulvet paa 13 px. */
      .sk-pill {
        font-size: var(--fs-xs);
      }
    }

    @media (max-width: 989px) {
      .sk-offer-card__inner {
        padding: 0;
      }
    }

    /* =============================
       SHARED PRICE SLOT WRAPPER
    ============================= */

    .sk-shared-price {
      margin: 0.5rem 0;
      padding: 0.375rem 0;
      display: flex;
      justify-content: center;
      text-align: center;
    }

    @media (min-width: 768px) {
      .sk-shared-price {
        margin: 0.333rem 0;
        padding: 0.25rem 0;
      }
    }

    .sk-shared-price .sk-radiance-price .sk-price {
      flex-direction: row;
      align-items: baseline;
      justify-content: center;
      gap: 4rem;
      min-height: 3.6rem;
    }

    .sk-shared-price .sk-radiance-price .sk-price__current {
      font-size: 3.2rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--color-neutral-4, #49494a);
      line-height: 1;
      position: relative;
      min-height: 1em;
    }

    .sk-shared-price .sk-radiance-price .sk-price__value {
      font-size: 2.2rem;
      font-weight: 400;
      color: var(--color-neutral-2, #9a9aa0);
      text-decoration: line-through;
      text-decoration-thickness: 1.5px;
      text-transform: none;
      min-height: 1.2em;
      display: inline-block;
    }

    .sk-shared-price .sk-radiance-price .sk-price__value:empty,
    .sk-shared-price .sk-radiance-price .sk-price__value[hidden] {
      visibility: hidden;
      display: inline-block !important;
      text-decoration: none;
    }

    .sk-shared-price .sk-radiance-price .sk-price__badge {
      display: inline-block;
      font-size: 1.6rem;
      font-weight: 600;
      color: var(--sk-brand, var(--ink-900));
      background: color-mix(in srgb, var(--color-lilac, #cdb7ed) 30%, #fff);
      border: 1.5px solid var(--sk-brand, var(--ink-900));
      padding: 0.25em 0.75em;
      border-radius: 6px;
      line-height: 1.3;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }

    .sk-shared-price .sk-radiance-price .sk-price__badge:empty {
      display: none;
    }

    @media (max-width: 767px) {
      .sk-shared-price .sk-radiance-price .sk-price__current {
        font-size: 2.5rem;
      }
      .sk-shared-price .sk-radiance-price .sk-price__value {
        font-size: 1.6rem;
      }
      .sk-shared-price .sk-radiance-price .sk-price__badge {
        font-size: 1.15rem;
      }
      .sk-shared-price .sk-radiance-price .sk-price {
        min-height: 2.8rem;
      }
    }

    /* =============================
       PURCHASE / TRUST
    ============================= */

    .sk-purchase {
      display: grid;
      grid-auto-flow: row;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .sk-purchase > * {
      min-width: 0;
    }

    /* ÆRLIG PRIS — luftig tekstblokk med hårfin toppdeler, ingen kort/ramme.
       Tokens: --ink-900 overskrift, --ink-500 undertekst, --ink-300 deler,
       --ff-serif. Fallbacks følger paletten i CLAUDE.md. */
    .sk-price-honesty {
      margin: 0;
      padding: 1.8rem 0 0;
      border-top: 1px solid var(--ink-300, rgba(45, 27, 61, 0.42));
    }

    .sk-price-honesty__title {
      margin: 0 0 0.6rem;
      font-family: var(--ff-serif);
      font-style: italic;
      font-size: 2.2rem;
      font-weight: 400;
      line-height: 1.3;
      color: var(--ink-900, #2d1b3d);
      letter-spacing: -0.005em;
    }

    .sk-price-honesty__body,
    .sk-price-honesty__body p {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 400;
      line-height: 1.6;
      color: var(--ink-500, rgba(45, 27, 61, 0.72));
    }

    @media (max-width: 600px) {
      .sk-price-honesty__title {
        font-size: 1.9rem;
      }

      .sk-price-honesty__body,
      .sk-price-honesty__body p {
        font-size: 1.6rem;
      }
    }

    /* Tre like kolonner med strekikon + UPPERCASE-tekst.
       Hårfin linje kun over — hvit luft ned mot badge-raden under. */
    .sk-trust-inline {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.6rem;
      font-size: 1.3rem;
      font-weight: 400;
      line-height: 1.5;
      color: var(--color-neutral-1, #6c6c6c);
      letter-spacing: 0.02em;
      text-transform: uppercase;
      margin: 0;
      padding: 1.6rem 0;
      border-top: 1px solid var(--color-neutral-5, #d5d5d9);
    }

    .sk-trust-inline__item {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      white-space: normal;
    }

    .sk-trust-inline__icon {
      flex: 0 0 auto;
      width: 1.7rem;
      height: 1.7rem;
    }

    @media (max-width: 480px) {
      .sk-trust-inline {
        grid-template-columns: 1fr;
        gap: 1.2rem;
      }

      .sk-trust-inline__item {
        justify-content: flex-start;
      }
    }

    @media (max-width: 768px) {
      .sk-trust-icons {
        gap: 0.15rem;
      }

      .sk-trust-icon {
        flex: 1 1 0;
        max-width: 120px;
      }
    }
    .sk-trust-icons {
      display: flex;
      gap: 0.15rem;
      align-items: center;
      flex-wrap: wrap;
      justify-content: center;
      opacity: 0.7;
      overflow-x: hidden;
    }

    .sk-trust-icon {
      flex: 1 1 0px;
      max-width: 120px;
      min-width: 0;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .sk-trust-icon img {
      width: auto;
      max-width: 100%;
      max-height: clamp(64px, 9vw, 90px);
      height: auto;
      display: block;
    }

    /* Mobil: 3 badges per rad (3+2 = maks 2 rader), moderat sirkelstørrelse.
       6-spors grid der hver badge spenner 2 spor, slik at de to siste kan
       sentreres på nederste rad. Desktop uendret. */
    @media (max-width: 480px) {
      .sk-trust-icons {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 1rem 1.2rem;
        justify-items: center;
      }

      .sk-trust-icon {
        grid-column: span 2;
        max-width: none;
      }

      .sk-trust-icon img {
        width: 100%;
        max-width: 115px;
        max-height: none;
      }

      /* Ved 5 badges: fjerde badge forskyves ett spor slik at nederste
         rad (badge 4 og 5) står sentrert under de tre første */
      .sk-trust-icon:nth-child(4):nth-last-child(2) {
        grid-column: 2 / span 2;
      }
    }

    /* =============================
       PURCHASE STACK REFINEMENT
    ============================= */

    .sk-purchase {
      margin-top: 0.5rem;
      gap: clamp(1.75rem, 2.2vw, 2.5rem);
    }

    .sk-purchase [data-sk-buy-wrapper] {
      padding-bottom: 0.5rem;
    }

    .sk-trust-icons {
      margin-top: 0.75rem;
      padding-top: 0.75rem;
    }

    /* =============================
       NOTIFY BUTTON (Klaviyo trigger)
    ============================= */

    .sk-notify {
      display: none;
    }

    .sk-notify__button {
      width: 100%;
      border-radius: 12px;
      padding: 1rem 1rem;
      font-weight: var(--fw-semibold);
      border: 1px solid var(--sk-brand);
      background: var(--color-white);
      color: var(--sk-brand);
      cursor: pointer;
    }

    .sk-notify__hint {
      margin-top: 0.5rem;
      font-size: 0.85rem;
      color: var(--color-neutral-2, #6b6b76);
    }

    /* =============================
       INFO
    ============================= */

    .sk-hero-info {
      margin-top: 2.5rem;
      padding-top: 2rem;
      border-top: 1px solid var(--sk-info-divider);
    }

    @media (max-width: 768px) {
      /* ── Lagerbaandet paa mobil: alt paa én linje ──
         Hoeyden kom av at etiketten og leveringsteksten laa stablet. Lagt
         paa samme linje som tallet blir hele baandet én tekstlinje, og
         brekker foerst hvis teksten faktisk er for lang. 67 px -> ~36 px. */
      /* Vanlig tekstflyt, ikke flex: flex-wrap kan ikke brekke INNI et
         element, saa den lange leveringsteksten ble dyttet til egen linje
         og baandet ble tre linjer hoeyt. Som inline tekst brekker den der
         det er plass. */
      .sk-stock {
        display: block;
        margin-top: var(--space-3);
        padding: var(--space-2) var(--space-3);
        border-radius: 12px;
        line-height: var(--lh-relaxed);
      }

      /* Tallet holdes nede paa mobil: med --fs-lg ble linjeboksen 27 px, og
         to linjer med den hoeyden er halve besparelsen spist opp. */
      .sk-stock__count {
        font-size: var(--fs-md);
        line-height: inherit;
        margin-right: var(--space-1);
      }

      .sk-stock__body {
        display: inline;
      }

      .sk-stock__label,
      .sk-stock__restock {
        display: inline;
      }

      .sk-stock__label {
        font-size: var(--fs-xs);
        letter-spacing: var(--tracking-wide);
      }

      .sk-stock__restock {
        font-size: var(--fs-xs);
        color: var(--ink-700);
      }

      .sk-stock__restock::before {
        content: '· ';
        color: var(--ink-300);
      }

      /* ── Pills: fra fire rammer til én flytende linje ──
         Rammene, paddingen og mellomrommene kostet mer plass enn teksten.
         Paa mobil droppes boksene og punktene skilles med en midtprikk —
         samme informasjon, langt mindre flate. Raden brekker av seg selv,
         saa den er dynamisk uansett hvor mange punkter produktet har. */
      .sk-radiance-pills {
        display: block;
        font-size: var(--fs-xs);
        line-height: var(--lh-relaxed);
        /* Var --ink-500. Raden leste som grå smaatekst; dette er
           produktets faktiske spesifikasjon og skal baere sin egen vekt. */
        color: var(--ink-700);
      }

      /* Boksene er fortsatt borte — det var de som kostet hoeyde. Men
         prikken blir med: den er baade skilletegn OG farge, saa raden
         faar liv uten aa vokse en eneste piksel. */
      .sk-pill {
        display: inline;
        border: 0;
        border-radius: 0;
        padding: 0;
        background: none;
        font-size: inherit;
        font-weight: var(--fw-regular);
      }

      .sk-pill::before {
        display: inline-block;
        vertical-align: 0.12em;
        margin-right: 5px;
      }

      /* Luft foran neste diode, ikke etter teksten — ellers henger et
         mellomrom igjen paa slutten av en brukket linje. */
      .sk-pill + .sk-pill {
        margin-left: 5px;
      }

      /* Sertifiseringen er radens ankerpunkt: liten fylt chip med haken i
         produktets lysfarge. Den er det eneste elementet med flate her,
         og det er meningen — blikket skal lande paa den. */
      .sk-pill--cert {
        display: inline-block;
        padding: 1px var(--space-2);
        border-radius: 999px;
        background: color-mix(in srgb, var(--ink-900) 6%, transparent);
        font-weight: var(--fw-semibold);
        color: var(--ink-900);
      }

      .sk-pill--cert::before {
        vertical-align: baseline;
        margin-right: 4px;
        color: var(--sk-dot, var(--glow-2));
      }

      .sk-eyebrow {
        margin: 0 0 var(--space-1);
        letter-spacing: 0.1em;
        font-weight: 500;
        line-height: 1;
        opacity: 0.85;
        font-size: 1.2rem;
      }

      .sk-product-title {
        font-size: 2.3rem;
        font-weight: 600;
        margin: 0 0 var(--space-1);
        line-height: 1.18;
      }

      .sk-product-subtitle {
        margin: 0 0 var(--space-2);
        font-size: 1.4rem;
        line-height: 1.5;
        color: var(--color-neutral-4, #8c8c95);
        opacity: 0.9;
        letter-spacing: 0.02em;
      }

      .sk-product-hero {
        padding: 0 1rem 2.5rem;
      }

      .sk-hero-content {
        gap: 1rem;
      }

      .sk-hero-info {
        margin-top: 1.5rem;
        padding-top: 1.5rem;
      }

      .sk-hero-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .sk-hero-progress {
        display: flex;
      }

      .sk-hero-media {
        /* Full-bleed på mobil: bryt ut av .page-width + .sk-product-hero
           sidepadding så hero-bildet dekker hele skjermbredden edge-to-edge.
           calc(50% - 50vw) = negativ margin lik den symmetriske sidepaddingen. */
        width: 100vw;
        max-inline-size: 100vw;
        margin-left: calc(50% - 50vw);
        margin-right: calc(50% - 50vw);
        align-items: center;
        padding: 0;
      }

      .sk-hero-media-main {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        margin: 0;
        border-radius: 0;
        /* Kapp hovedbildet til maks ~58% av skjermhøyden så tittel, pris
           og CTA kommer med over fold. Kvadratisk når 100vw < 58vh
           (høye telefoner), ellers beskjæres det til 58vh-båndet. */
        max-height: 58vh;
      }

      .sk-hero-media-swiper {
        width: 100%;
        aspect-ratio: 1 / 1;
        max-width: 100%;
        min-width: 0;
        max-height: 58vh;
      }

      .sk-hero-gallery-wrapper,
      .sk-hero-gallery,
      .sk-hero-thumb,
      .sk-hero-gallery-controls {
        display: none;
      }

      .sk-offer-cards {
        width: 100%;
        margin: 0;
        justify-items: stretch;
      }

      .sk-offer-card {
        width: 100%;
        max-width: none;
      }

      .sk-offer-card__inner {
        display: grid;
        grid-template-columns: minmax(72px, 88px) 1fr;
        grid-auto-rows: min-content;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1rem;
        min-height: auto;
        border-radius: 16px;
      }

      .sk-offer-card input:checked + .sk-offer-card__inner {
        border-color: var(--sk-brand);
        background: var(--sk-hero-muted);
      }

      .sk-offer-card__image-wrapper {
        width: 88px;
        height: 88px;
        flex: 0 0 auto;
        border-radius: 14px;
        overflow: hidden;
      }

      .sk-offer-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .sk-offer-card__content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.5rem;
        padding: 0;
      }

      .sk-offer-card__title {
        font-size: 1.6rem;
        line-height: 1.45;
        margin: 0;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .sk-offer-card__subtitle {
        font-size: 0.9rem;
        color: var(--sk-neutral-contrast);
        margin: 0;
      }

      .sk-offer-card__price {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .sk-offer-card__price .sk-price__value {
        font-size: 1.5rem;
      }

      .sk-offer-card__price .sk-price__current {
        font-size: 2.5rem;
        color: var(--color-neutral-4, #49494a);
        font-weight: 600;
      }

      .sk-offer-card__price .sk-price__badge {
        display: inline-block;
        width: auto;
        margin: 0.25rem 0 0;
        padding: 0.25em 0.6em;
        border-radius: 5px;
        text-align: start;
      }

      .sk-offer-card__footer {
        display: none;
      }

      .sk-offer-card__badge {
        position: static !important;
        display: inline-flex;
        align-self: flex-start;
        width: max-content;
        background: var(--sk-brand);
        color: var(--color-white);
        font-size: var(--fs-xs); /* var 0.65rem = 6,5px ved 10px rot */
        padding: 0.25rem 0.5rem;
        grid-column: 1 / -1;
        justify-self: end;
        margin-bottom: 0.5rem;
      }

      .sk-offer-cards,
      .sk-offer-card,
      .sk-hero-info,
      .sk-hero-content {
        min-width: 0;
      }

      .sk-hero-info h2,
      .sk-hero-info h3 {
        font-size: clamp(2.2rem, 4vw, 2.8rem) !important;
      }

      .sk-hero-info h4 {
        font-size: clamp(1.8rem, 3.8vw, 2.4rem) !important;
      }

      .sk-hero-info li {
        font-size: clamp(1.7rem, 3.5vw, 2.4rem) !important;
        padding-left: 40px;
      }
    }

    /* =============================
         RADIANCE CONTENT (Rich text)
      ============================= */

    .sk-hero-info h2,
    .sk-hero-info h3,
    .sk-hero-info h4 {
      font-weight: 600;
      margin-bottom: 1rem;
      color: var(--sk-brand);
      letter-spacing: -0.01em;
    }

    .sk-hero-info h2,
    .sk-hero-info h3 {
      font-size: clamp(2.1rem, 2.6vw, 2.7rem);
    }

    .sk-hero-info h4 {
      font-size: clamp(1.8rem, 2.2vw, 2.35rem);
    }

    .sk-hero-info ul {
      list-style: none;
      padding-left: 0;
      margin: 0;
    }

    .sk-hero-info li {
      position: relative;
      padding-left: 3rem;
      margin-bottom: 1rem;
      line-height: 1.55;
      color: var(--color-dark, #3a3939);
      font-size: clamp(1.2rem, 1.6vw, 1.9rem);
    }

    .sk-hero-info strong,
    .sk-hero-info b {
      color: var(--sk-brand);
      text-decoration: underline;
      text-decoration-color: var(--sk-brand);
    }

    .sk-hero-info h2 strong,
    .sk-hero-info h3 strong,
    .sk-hero-info h4 strong,
    .sk-hero-info h2 b,
    .sk-hero-info h3 b,
    .sk-hero-info h4 b {
      text-decoration: none;
    }

    .sk-hero-info a {
      font-weight: 600;
      color: var(--sk-brand);
      text-decoration: underline;
      text-decoration-color: var(--sk-brand);
      text-decoration-thickness: 2px;
    }

    .sk-hero-info a:hover,
    .sk-hero-info a:focus-visible,
    .sk-hero-info a:active {
      color: var(--sk-brand);
      text-decoration-color: var(--sk-brand);
      opacity: 0.9;
    }

    .sk-hero-info li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.3em;
      width: 1.1em;
      height: 1.1em;
      border-radius: 50%;
      background: var(--color-brand);
    }

    .sk-hero-info li::after {
      content: '';
      position: absolute;
      left: 0.38em;
      top: 0.53em;
      width: 0.35em;
      height: 0.6em;
      border-right: 2px solid var(--color-white);
      border-bottom: 2px solid var(--color-white);
      transform: rotate(45deg);
    }

    /**====PAYMENT=====*/
  .payment-icons {
    font-size: 1.2rem;
    color: var(--color-neutral-3, #57575f);
    margin-bottom: 1.6rem;
  }

  .payment-icons__label {
    margin-right: 0.8rem;
  }

  .payment-icons__list {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    padding: 0;
    margin: 0;
    list-style: none;
    vertical-align: middle;
  }

  .payment-icons__item {
    display: flex;
    align-items: center;
    line-height: 0;
  }

  .payment-icons__item svg,
  .payment-icons__item img {
    display: block;
    width: auto;
    max-width: 100%;
    height: clamp(2rem, 5vw, 2.67rem);
    overflow: visible;
  }

  /* =============================
     HERO LIGHTBOX (klikk for å forstørre)
  ============================= */

  .sk-hero-media-main .swiper-slide img {
    cursor: zoom-in;
  }

  .sk-hero-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: rgba(255, 255, 255, 0.98);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sk-hero-lightbox[hidden] {
    display: none;
  }

  .sk-hero-lightbox__stage {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .sk-hero-lightbox__slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.6rem, 4vw, 4.8rem);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease;
  }

  .sk-hero-lightbox__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .sk-hero-lightbox__slide img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .sk-hero-lightbox__close {
    position: absolute;
    top: clamp(1.2rem, 2.5vw, 2.4rem);
    right: clamp(1.2rem, 2.5vw, 2.4rem);
    z-index: 2;
    width: 4.4rem;
    height: 4.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-brand, var(--ink-900));
    color: #fff;
    border: none;
    border-radius: 50%;
    font-size: 2.2rem;
    line-height: 1;
    cursor: pointer;
    transition: opacity 0.18s ease;
  }

  .sk-hero-lightbox__close:hover {
    opacity: 0.85;
  }

  .sk-hero-lightbox__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 4.4rem;
    height: 4.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: var(--color-brand, var(--ink-900));
    border: 1px solid var(--color-border, #e7e7ed);
    border-radius: 50%;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.18s ease;
  }

  .sk-hero-lightbox__nav:hover {
    background: var(--color-bg-light, #f1eff4);
  }

  .sk-hero-lightbox__nav--prev {
    left: clamp(1.2rem, 2.5vw, 2.4rem);
  }

  .sk-hero-lightbox__nav--next {
    right: clamp(1.2rem, 2.5vw, 2.4rem);
  }

  .sk-hero-lightbox__counter {
    position: absolute;
    bottom: clamp(1.6rem, 3vw, 2.8rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-size: 1.4rem;
    letter-spacing: 0.04em;
    color: var(--color-neutral-2, #7a7a85);
  }

  @media (max-width: 768px) {
    .sk-hero-lightbox__nav {
      display: none;
    }

    /* Bildene går kant til kant på mobil — ingen padding rundt sliden */
    .sk-hero-lightbox__slide {
      padding: 0;
    }

    .sk-hero-lightbox__slide img {
      width: 100%;
    }
  }
</style>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign product_info_reference = product.metafields.custom.product_info
  | default: product.metafields.product_info
-%}
{%- assign product_info = product_info_reference.value -%}
{%- assign product_form_id = 'product-form-' | append: section.id -%}
{%- assign media_images = product.media | where: 'media_type', 'image' -%}

{%- comment -%}
  Bundle wiring (IMPORTANT):
  Create a Product reference metafield on the BASE product:
  - custom.bundle_product (type: Product)
  Select your "Bundler standalone bundle product" there.
{%- endcomment -%}

{%- assign bundle_product_ref = product.metafields.custom.bundle_product.value -%}
{%- assign bundle_handle = '' -%}
{%- assign bundle_title = '' -%}
{%- if bundle_product_ref != blank -%}
  {%- assign bundle_handle = bundle_product_ref.handle -%}
  {%- assign bundle_title = bundle_product_ref.title -%}
{%- endif -%}
{%- assign base_variant = product.selected_or_first_available_variant -%}
{%- assign bundle_variant = bundle_product_ref.first_available_variant -%}
{%- if bundle_variant == blank -%}
  {%- assign bundle_variant = bundle_product_ref.variants.first -%}
{%- endif -%}
{%- assign single_image_alt = product.featured_image.alt | default: product.title -%}
{%- assign bundle_image_obj = bundle_product_ref.featured_image -%}
{%- if bundle_image_obj == blank -%}
  {%- assign bundle_image_obj = product.featured_image -%}
{%- endif -%}
{%- if bundle_image_obj != blank -%}
  {%- assign bundle_image_alt = bundle_image_obj.alt | default: bundle_title | default: product.title -%}
{%- else -%}
  {%- assign bundle_image_alt = bundle_title | default: product.title -%}
{%- endif -%}

{%- comment -%}
  Pills: robust detection using JSON output.
  - Array -> json starts with [
  - String -> json starts with "
{%- endcomment -%}
{%- assign pills_raw = product_info.radiance_pills.value | default: blank -%}
{%- assign pills_list = blank -%}
{%- if pills_raw != blank -%}
  {%- assign pills_json = pills_raw | json -%}
  {%- assign pills_json_first = pills_json | slice: 0, 1 -%}
  {%- if pills_json_first == '[' -%}
    {%- assign pills_list = pills_raw -%}
  {%- else -%}
    {%- assign pills_clean = pills_raw | strip -%}
    {%- if pills_clean contains '[' and pills_clean contains ']' -%}
      {%- assign pills_clean = pills_clean | remove: '[' | remove: ']' -%}
      {%- assign pills_clean = pills_clean
        | replace: '","', '|||'
        | replace: '", "', '|||'
        | replace: '",', '|||'
        | replace: ',"', '|||'
      -%}
      {%- assign pills_clean = pills_clean | replace: '"', '' -%}
      {%- assign pills_list = pills_clean | split: '|||' -%}
    {%- elsif pills_clean contains '\n' -%}
      {%- assign pills_list = pills_clean | split: '\n' -%}
    {%- else -%}
      {%- assign pills_list = pills_clean | split: '|||' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<product-info
  id="MainProduct-{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-url="{{ product.url }}"
>
  <div class="page-width">
    <section
      class="sk-product-hero"
      id="sk-radiance-product-hero-{{ section.id }}"
      data-base-handle="{{ product.handle | handleize }}"
      data-base-product-id="{{ product.id }}"
      data-base-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-base-available="{% if product.selected_or_first_available_variant.available %}true{% else %}false{% endif %}"
      data-bundle-handle="{{ bundle_handle | handleize }}"
      data-bundle-title="{{ bundle_title | escape }}"
      data-money-format="{{ shop.money_without_trailing_zeros_format | escape }}"
    >
      <div class="sk-hero-grid">
        <!-- ================= LEFT: CANONICAL MEDIA ================= -->
        <div class="sk-hero-media">
          {% if media_images.size > 0 %}
            <div class="sk-hero-media-main">
              <div class="sk-hero-media-swiper swiper">
                <div class="swiper-wrapper">
                  {% for image in media_images %}
                    <div class="swiper-slide">
                      <img
                        src="{{ image | image_url: width: 900 }}"
                        srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w"
                        {%- comment -%}
                          sizes matcher faktisk rendret bredde av .sk-hero-media-main, utledet fra
                          .page-width (max-width 1600px, padding 40px/side ved >=889px viewport) og
                          .sk-hero-grid sin 45/55-kolonnedeling med 6rem (60px) gap ved >=990px:
                          kolonnebredde = 45vw - 63px, med tak 693px når 100vw-80px når 1600px (vw=1680).
                          769-989px er énkolonne (60vw), <=768px er full-bleed (100vw).
                        {%- endcomment -%}
                        sizes="(max-width: 768px) 100vw, (max-width: 989px) 60vw, (min-width: 1680px) 693px, calc(45vw - 63px)"
                        alt="{{ image.alt | default: product.title | append: ' LED light therapy device' }}"
                        width="900"
                        height="900"
                        {%- comment -%}
                          Bilde 2 lastes ogsaa med én gang. Peek-kanten paa mobil
                          viser 47 px av neste slide, men med loading="lazy" ble
                          bildet aldri hentet — maalt naturalWidth 0 og tom
                          currentSrc — saa kanten var en tom hvit flate.
                          Geometrien var riktig; det manglet bare et bilde i den.
                          fetchpriority="low" saa det ikke konkurrerer med LCP.
                        {%- endcomment -%}
                        {% if forloop.first %}
                          loading="eager" fetchpriority="high"
                        {% elsif forloop.index == 2 %}
                          loading="eager" fetchpriority="low"
                        {% else %}
                          loading="lazy"
                        {% endif %}
                      >
                    </div>
                  {% endfor %}
                </div>
                {% if media_images.size > 1 %}
                  <button class="sk-hero-arrow sk-hero-arrow--prev" type="button" aria-label="Previous hero image">
                    ‹
                  </button>
                  <button class="sk-hero-arrow sk-hero-arrow--next" type="button" aria-label="Next hero image">
                    ›
                  </button>
                {% endif %}
              </div>
            </div>

            <div class="sk-hero-gallery-wrapper">
              <div class="sk-hero-gallery">
                {% for image in media_images %}
                  <div class="sk-hero-thumb">
                    <img
                      src="{{ image | image_url: width: 240 }}"
                      srcset="
                        {{ image | image_url: width: 120 }} 120w,
                        {{ image | image_url: width: 240 }} 240w,
                        {{ image | image_url: width: 360 }} 360w,
                        {{ image | image_url: width: 480 }} 480w
                      "
                      sizes="120px"
                      alt="{{ image.alt | default: product.title }}"
                      width="120"
                      height="120"
                      loading="lazy"
                    >
                  </div>
                {% endfor %}
              </div>
              {% if media_images.size > 1 %}
                <div class="sk-hero-gallery-controls" aria-hidden="true">
                  <button class="sk-hero-arrow sk-hero-arrow--prev" type="button" aria-label="Scroll gallery left">
                    ‹
                  </button>
                  <button class="sk-hero-arrow sk-hero-arrow--next" type="button" aria-label="Scroll gallery right">
                    ›
                  </button>
                </div>
              {% endif %}
            </div>

            {% if media_images.size > 1 %}
              <div class="sk-hero-progress" role="tablist" aria-label="Hero swipe progress">
                {% for image in media_images %}
                  <button
                    type="button"
                    role="tab"
                    class="sk-hero-progress-dot{% if forloop.first %} is-active{% endif %}"
                    data-media-index="{{ forloop.index0 }}"
                    aria-label="View media {{ forloop.index }}"
                    aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  ></button>
                {% endfor %}
              </div>
            {% endif %}
          {% endif %}
        </div>

        <!-- ================= RIGHT: METAOBJECT CONTENT ================= -->
        <div class="sk-hero-content">
          {% if product_info.radiance_eyebrow.value != blank %}
            <p class="sk-eyebrow">{{ product_info.radiance_eyebrow.value }}</p>
          {% endif %}

          <h1 class="sk-product-title">
            {{ product_info.radiance_heading.value | default: product.title }}
          </h1>

          {% if product_info.radiance_subheading.value != blank %}
            <p class="sk-product-subtitle">{{ product_info.radiance_subheading.value }}</p>
          {% endif %}

          {%- comment -%}
            LAGERSTATUS
            Tallet hentes foerst fra produktets eget metafelt custom.stock_left,
            saa hvert produkt kan ha sitt eget. Er det tomt, faller den tilbake
            til seksjonsinnstillingen — men merk at product.sk-radiance.json er
            ÉN mal delt av alle tre produktene, saa reserven gir samme tall paa
            alle. Metafeltet er det riktige stedet naar tallene skiller seg.

            Vises kun naar antallet er paa eller under terskelen. Over den er
            linja usynlig, slik at den aldri staar der uten dekning — og ikke
            mister kraft av aa vaere permanent.
          {%- endcomment -%}
          {%- liquid
            comment
              Antallet settes MANUELT, per produkt.

              Shopifys eget lagertall brukes bevisst IKKE: beholdningen der
              er ikke ajour (maalt 135 / 25 / 28 mot faktisk situasjon), og
              et automatisk tall som er galt er verre enn ingen linje.

              1) metafeltet custom.stock_left — per produkt, dette er stedet
              2) seksjonsinnstillingen — reserve. product.sk-radiance.json er
                 ÉN mal delt av alle produktene, saa den gir samme tall paa
                 alle. Bruk den bare hvis tallet faktisk skal vaere likt.
            endcomment
            assign stock_left = product.metafields.custom.stock_left.value | default: product.metafields.custom.stock_left

            if stock_left == blank
              assign stock_left = section.settings.stock_left
            endif
            assign stock_threshold = section.settings.stock_threshold | default: 5

            comment
              Gloedens palett foelger maskens egen boelgelengde.
              1) metafeltet custom.led_glow ("blue" eller "red") vinner
              2) ellers utledes den av handle — Clear er blaatt lys,
                 Radiance er roedt og naer-infraroedt
              Faller alltid tilbake til roedt, som er flertallet.
            endcomment
            assign glow_kind = product.metafields.custom.led_glow.value | default: product.metafields.custom.led_glow | downcase | strip
            if glow_kind == blank
              if product.handle contains 'clear'
                assign glow_kind = 'blue'
              else
                assign glow_kind = 'red'
              endif
            endif
            assign glow_class = ''
            assign pills_glow_class = ''
            if glow_kind == 'blue'
              assign glow_class = ' sk-stock--blue'
              assign pills_glow_class = ' sk-radiance-pills--blue'
            endif

            assign show_stock = false
            if section.settings.stock_show and stock_left != blank and stock_left > 0 and stock_left <= stock_threshold
              assign show_stock = true
            endif
          -%}
          {%- comment -%}
            Anmeldelsene staar FOER lagerbaandet: vurderingen svarer paa
            "er den bra", knappheten paa "maa jeg bestemme meg naa". Det
            foerste spoerdmaalet kommer foerst, og et hastesignal foer
            produktet er vurdert leser som press.
          {%- endcomment -%}
          <div class="sk-product-reviews">
            {% for block in section.blocks %}
              {% if block.type == '@app' %}
                {% render block %}
              {% endif %}
            {% endfor %}
          </div>

          {%- if show_stock -%}
            <div class="sk-stock{{ glow_class }}" role="status">
              <span class="sk-stock__count" aria-hidden="true">{{ stock_left }}</span>
              <span class="sk-stock__body">
                <span class="sk-stock__label">
                  {{- section.settings.stock_label | default: 'igjen på lager' -}}
                </span>
                {%- if section.settings.stock_restock != blank -%}
                  <span class="sk-stock__restock">{{ section.settings.stock_restock }}</span>
                {%- endif -%}
              </span>
              <span class="visually-hidden">
                {{- stock_left }} {{ section.settings.stock_label | default: 'igjen på lager' -}}
              </span>
            </div>
          {%- endif -%}

          {%- comment -%}
            PILLS — produktfakta fra metafeltet, pluss sertifiseringen til slutt.

            CE staar som seksjonsinnstilling og ikke i metafeltet: merkingen
            gjelder alle produktene likt, saa den skal settes ett sted. Den er
            ogsaa plassert sist med vilje — produktfaktaene svarer «hva er
            dette», sertifiseringen svarer «toer jeg».

            Vilkaaret dekker ogsaa tilfellet der et produkt mangler pills:
            da rendres raden likevel, med bare sertifiseringen.
          {%- endcomment -%}
          {% if pills_list != blank or section.settings.ce_text != blank %}
            <div class="sk-radiance-pills{{ pills_glow_class }}">
              {% for pill in pills_list %}
                {% assign pill_text = pill | strip %}
                {% if pill_text != blank %}
                  {%- comment -%}
                    Prikken vandrer gjennom --glow-1/2/3 og begynner forfra
                    naar de er brukt opp. Fargene bytter med masken, saa raden
                    lyser i det spekteret produktet faktisk sender ut.
                  {%- endcomment -%}
                  {%- assign dot_index = forloop.index0 | modulo: 3 | plus: 1 -%}
                  <span class="sk-pill" style="--sk-dot: var(--glow-{{ dot_index }})">
                    {{- pill_text -}}
                  </span>
                {% endif %}
              {% endfor %}

              {% if section.settings.ce_text != blank %}
                <span class="sk-pill sk-pill--cert">{{ section.settings.ce_text }}</span>
              {% endif %}
            </div>
          {% endif %}

          <!-- OFFER SELECTOR (Single vs Bundle) -->
          <div class="sk-offer-cards" data-sk-offer-cards>
            <!-- SINGLE -->
            <label class="sk-offer-card" data-sk-offer-card="single">
              <input type="radio" name="sk-offer" value="single" checked>
              <div class="sk-offer-card__inner">
                <div class="sk-offer-card__image-wrapper">
                  <img
                    src="{{ product.featured_image | image_url: width: 640 }}"
                    alt="{{ single_image_alt | escape }}"
                    class="sk-offer-card__image"
                    width="640"
                    height="640"
                    loading="lazy"
                  >
                </div>
                <div class="sk-offer-card__content">
                  <div>
                    <div class="sk-offer-card__title">{{ product.title }}</div>
                  </div>
                  <div class="sk-offer-card__price" data-sk-card-price="single">
                    <div class="sk-price">
                      <span class="sk-price__value">
                        {%- if base_variant.compare_at_price and base_variant.compare_at_price > base_variant.price -%}
                          {{ base_variant.compare_at_price | money_without_trailing_zeros }}
                        {%- endif -%}
                      </span>
                      <span class="sk-price__current">
                        {{ base_variant.price | money_without_trailing_zeros }}
                      </span>
                      {%- if base_variant.compare_at_price and base_variant.compare_at_price > base_variant.price -%}
                        {%- assign savings_pct = base_variant.compare_at_price
                          | minus: base_variant.price
                          | times: 100
                          | divided_by: base_variant.compare_at_price
                        -%}
                        <span class="sk-price__badge">Spar {{ savings_pct }}%</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                <div class="sk-offer-card__footer" aria-hidden="true"></div>
                <span class="sk-offer-card__check" aria-hidden="true"></span>
                {%- comment -%}
                  Render notify-lenken KUN når varianten faktisk er utsolgt.
                  Ellers ligger «Gi beskjed når tilgjengelig» i rå-HTML (bare
                  CSS-skjult) og får AI/bots til å tro produktet er utsolgt —
                  i strid med JSON-LD (InStock). is-visible gjør den synlig
                  uten å vente på JS.
                {%- endcomment -%}
                {%- if base_variant.available == false -%}
                  <a
                    href="#"
                    class="sk-offer-card__notify is-visible"
                    data-sk-card-notify-button
                    data-klaviyo-backinstock
                    data-variant-id="{{ base_variant.id }}"
                    aria-label="Gi beskjed når tilgjengelig"
                  >
                    Gi beskjed når tilgjengelig
                  </a>
                {%- endif -%}
              </div>
            </label>

            <!-- BUNDLE -->
            <label
              class="sk-offer-card"
              data-sk-offer-card="bundle"
              data-sk-bundle-card
              {% if bundle_handle == blank %}
                style="display:none"
              {% endif %}
            >
              <input type="radio" name="sk-offer" value="bundle">
              <div class="sk-offer-card__inner">
                <span class="sk-offer-card__badge">Best verdi</span>
                <div class="sk-offer-card__image-wrapper">
                  <img
                    src="{{ bundle_image_obj | image_url: width: 640 }}"
                    alt="{{ bundle_image_alt | escape }}"
                    class="sk-offer-card__image"
                    width="640"
                    height="640"
                    loading="lazy"
                  >
                </div>
                <div class="sk-offer-card__content">
                  <div>
                    <div class="sk-offer-card__title">{{ bundle_title | default: 'Face + Neck Kit' }}</div>
                  </div>
                  <div class="sk-offer-card__price" data-sk-card-price="bundle">
                    <div class="sk-price">
                      <span class="sk-price__value">
                        {%- if bundle_variant.compare_at_price and bundle_variant.compare_at_price > bundle_variant.price -%}
                          {{ bundle_variant.compare_at_price | money_without_trailing_zeros }}
                        {%- endif -%}
                      </span>
                      <span class="sk-price__current">
                        {%- if bundle_variant and bundle_variant.price -%}
                          {{ bundle_variant.price | money_without_trailing_zeros }}
                        {%- else -%}
                          —
                        {%- endif -%}
                      </span>
                      {%- if bundle_variant.compare_at_price and bundle_variant.compare_at_price > bundle_variant.price -%}
                        {%- assign bundle_savings_pct = bundle_variant.compare_at_price
                          | minus: bundle_variant.price
                          | times: 100
                          | divided_by: bundle_variant.compare_at_price
                        -%}
                        <span class="sk-price__badge">Spar {{ bundle_savings_pct }}%</span>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
                <div class="sk-offer-card__footer" aria-hidden="true"></div>
                <span class="sk-offer-card__check" aria-hidden="true"></span>
                {%- comment -%} Se kommentar over: kun ved faktisk utsolgt bundle. {%- endcomment -%}
                {%- if bundle_variant.available == false -%}
                  <a
                    href="#"
                    class="sk-offer-card__notify is-visible"
                    data-sk-card-notify-button
                    data-klaviyo-backinstock
                    data-variant-id="{{ bundle_variant.id }}"
                    aria-label="Gi beskjed når tilgjengelig"
                  >
                    Gi beskjed når tilgjengelig
                  </a>
                {%- endif -%}
              </div>
            </label>
          </div>

          <!-- SHARED PRICE SLOT (changes with offer) -->
          <div class="sk-shared-price" data-sk-shared-price>
            {% render 'sk-radiance-price', product: product, section: section, show_badges: false %}
          </div>

          {%- comment -%}
            ÆRLIG PRIS — skjules mens kampanjen går. «Ingen rabattkupp. Ingen
            falske «før»-priser.» rett over en strøket førpris er en direkte
            selvmotsigelse. Betinget i stedet for slettet, så budskapet kommer
            tilbake av seg selv når bryteren slås av.
          {%- endcomment -%}
          {%- if section.settings.honesty_show and settings.kampanje_aktiv != true -%}
            <div class="sk-price-honesty">
              {%- if section.settings.honesty_heading != blank -%}
                <p class="sk-price-honesty__title">{{ section.settings.honesty_heading }}</p>
              {%- endif -%}
              {%- if section.settings.honesty_body != blank -%}
                {%- comment -%}
                  [pris]-token i body-teksten erstattes dynamisk med produktets aktuelle pris.
                  Slik følger teksten produktet (Clear: 4 390 kr, Radiance: 4 690 kr) uten
                  manuell oppdatering, og du slipper troverdighetsbrudd hvis pris endres.
                {%- endcomment -%}
                {%- assign sk_formatted_price = product.price | money_without_trailing_zeros -%}
                {%- assign sk_honesty_body = section.settings.honesty_body | replace: '[pris]', sk_formatted_price -%}
                <div class="sk-price-honesty__body">{{ sk_honesty_body }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%}
            Kampanjestripe – vises kun når tema-innstillingen «Kampanje aktiv»
            er på. Besparelsen regnes fra produktets egen pris vs «sammenlign
            med»-pris, så hver produktside viser sitt eget, korrekte tall.
          {%- endcomment -%}
          {% render 'sk-campaign-banner', product: product, layout: 'inline' %}

          <!-- PURCHASE -->
          <div class="sk-purchase">
            <!-- Buy buttons wrapper (we toggle this) -->
            <div data-sk-buy-wrapper>
              {% if shop.enabled_payment_types.size > 0 %}
                {%- assign excluded_payment_types = 'american_express,unionpay' | split: ',' -%}
                <div class="payment-icons">
                  <ul class="payment-icons__list">
                    {% for type in shop.enabled_payment_types %}
                      {%- unless excluded_payment_types contains type -%}
                        <li class="payment-icons__item">
                          {{ type | payment_type_svg_tag }}
                        </li>
                      {%- endunless -%}
                    {% endfor %}
                    {%- comment -%} Vipps - Third-party payment gateway not in Shopify's native list {%- endcomment -%}
                    {% if settings.show_vipps_payment_icon %}
                      <li class="payment-icons__item">
                        <img src="{{ 'icon-vipps.svg' | asset_url }}" alt="Vipps" height="22" width="55">
                      </li>
                    {% endif %}
                  </ul>
                </div>
              {% endif %}
              {% render 'sk-radiance-buy-buttons',
                product: product,
                product_form_id: product_form_id,
                section_id: section.id
              %}
            </div>

            <div class="sk-trust-inline">
              <span class="sk-trust-inline__item">
                <svg class="sk-trust-inline__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                <span>Gratis frakt i Norge</span>
              </span>
              <span class="sk-trust-inline__item">
                <svg class="sk-trust-inline__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                <span>Prøv hjemme i 30 dager</span>
              </span>
              <span class="sk-trust-inline__item">
                <svg class="sk-trust-inline__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>Trygg betaling</span>
              </span>
            </div>

            {% assign trust_badges_source = product_info.trust_badges | default: blank %}
            {% assign trust_badges_value = trust_badges_source.value | default: trust_badges_source %}
            {% assign trust_badges_size = trust_badges_value | size %}
            {% if trust_badges_value != blank and trust_badges_size > 0 %}
              <div class="sk-payment sk-trust-icons">
                {% for badge in trust_badges_value %}
                  {% assign badge_img = badge.url | default: badge.image | default: badge.src | default: badge %}
                  {% assign badge_alt = badge.alt | default: badge.alt_text | default: 'Trust badge' %}
                  {% if badge_img != blank %}
                    <span class="sk-trust-icon">
                      <img
                        src="{{ badge_img | image_url: width: 60 }}"
                        alt="{{ badge_alt }}"
                        width="60"
                        height="22"
                        loading="lazy"
                      >
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% if product_info.radiance_content.value != blank %}
              <div class="sk-hero-info">
                {{ product_info.radiance_content | metafield_tag }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </section>
  </div>

  {% if media_images.size > 0 %}
    <div
      id="sk-hero-lightbox-{{ section.id }}"
      class="sk-hero-lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="{{ product.title | escape }} – bildegalleri"
      hidden
    >
      <div class="sk-hero-lightbox__stage">
        {% for image in media_images %}
          <div class="sk-hero-lightbox__slide" data-lightbox-index="{{ forloop.index0 }}">
            <img
              src="{{ image | image_url: width: 1200 }}"
              srcset="{{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w, {{ image | image_url: width: 2048 }} 2048w"
              sizes="100vw"
              alt="{{ image.alt | default: product.title | escape }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              loading="lazy"
            >
          </div>
        {% endfor %}
      </div>
      <button class="sk-hero-lightbox__close" type="button" aria-label="Lukk bildegalleri">&times;</button>
      {% if media_images.size > 1 %}
        <button class="sk-hero-lightbox__nav sk-hero-lightbox__nav--prev" type="button" aria-label="Forrige bilde">‹</button>
        <button class="sk-hero-lightbox__nav sk-hero-lightbox__nav--next" type="button" aria-label="Neste bilde">›</button>
        <div class="sk-hero-lightbox__counter" aria-live="polite"></div>
      {% endif %}
    </div>
  {% endif %}

  {% render 'sk-radiance-sticky-bar', section: section, product: product, product_form_id: product_form_id %}

  {%- render 'sk-product-jsonld' -%}

  <script>
    document.addEventListener('DOMContentLoaded', async function () {
      // =========================
      // HERO SWIPER
      // =========================
      (function initHeroSwiper() {
        if (typeof Swiper === 'undefined') return;

        const sectionEl = document.getElementById('sk-radiance-product-hero-{{ section.id }}');
        if (!sectionEl) return;

        const swiperRoot = sectionEl.querySelector('.sk-hero-media-swiper');
        if (!swiperRoot) return;

        const swiperElement = swiperRoot.querySelector('.swiper') || swiperRoot;
        if (!swiperElement) return;

        const prevButton = swiperRoot.querySelector('.sk-hero-arrow--prev');
        const nextButton = swiperRoot.querySelector('.sk-hero-arrow--next');
        const thumbnails = sectionEl.querySelectorAll('.sk-hero-thumb img');
        const progressDots = sectionEl.querySelectorAll('.sk-hero-progress-dot');
        const galleryPrevButton = sectionEl.querySelector('.sk-hero-gallery-controls .sk-hero-arrow--prev');
        const galleryNextButton = sectionEl.querySelector('.sk-hero-gallery-controls .sk-hero-arrow--next');
        const galleryRow = sectionEl.querySelector('.sk-hero-gallery');

        const slideCount = thumbnails.length || swiperElement.querySelectorAll('.swiper-slide').length;
        const shouldLoop = slideCount > 1;

        /* slidesPerView: 1 — IKKE endre til en broekdel her.
           Et forsoek paa peek-kant (1.08, senere 1.18) ble rullet tilbake:
           hero-bildene har tekst bakt inn i selve filen ("UKE 4-6",
           "JEVNERE HUDTONE" osv.), og siden slidene bruker
           object-fit: cover, beskjaerer en smalere slide teksten bort.
           Paa 375px krympet sliden fra 375 til 316 px og kuttet ordene i
           begge kanter.

           Peek er dessuten feil virkemiddel for dette galleriet: kantene av
           produktbildene er samme flate krem (maalt rgb(244,236,228) paa
           begge sider), saa selv en bred kant hadde ingenting aa vise.
           Karusellene som TAALER peek er sk-before-after og
           sk-led-light-work — der er kortene innholdsrike helt ut i kanten. */
        const swiperOptions = {
          slidesPerView: 1,
          loop: shouldLoop,
          allowTouchMove: true,
          speed: 400,
        };
        if (prevButton && nextButton) swiperOptions.navigation = { prevEl: prevButton, nextEl: nextButton };

        const heroSwiper = new Swiper(swiperElement, swiperOptions);

        function updateProgressDots(index) {
          if (!progressDots.length) return;
          progressDots.forEach((dot, dotIndex) => {
            const isActive = dotIndex === index;
            dot.classList.toggle('is-active', isActive);
            dot.setAttribute('aria-pressed', isActive ? 'true' : 'false');
          });
        }

        function updateActiveThumb(index) {
          thumbnails.forEach((thumb, thumbIndex) => {
            thumb.classList.toggle('is-active', thumbIndex === index);
          });
          updateProgressDots(index);
        }

        updateActiveThumb(typeof heroSwiper.realIndex === 'number' ? heroSwiper.realIndex : heroSwiper.activeIndex || 0);

        heroSwiper.on('slideChange', function () {
          const index = typeof heroSwiper.realIndex === 'number' ? heroSwiper.realIndex : heroSwiper.activeIndex;
          updateActiveThumb(index);
        });

        thumbnails.forEach((thumb, index) => {
          thumb.addEventListener('click', function () {
            if (shouldLoop && typeof heroSwiper.slideToLoop === 'function') {
              heroSwiper.slideToLoop(index);
              return;
            }
            heroSwiper.slideTo(index);
          });
        });

        progressDots.forEach((dot, index) => {
          dot.addEventListener('click', function () {
            if (shouldLoop && typeof heroSwiper.slideToLoop === 'function') {
              heroSwiper.slideToLoop(index);
              return;
            }
            heroSwiper.slideTo(index);
          });
        });

        function scrollGallery(direction) {
          if (!galleryRow) return;
          const step = Math.max(150, galleryRow.clientWidth * 0.6);
          galleryRow.scrollBy({ left: direction === 'next' ? step : -step, behavior: 'smooth' });
        }

        if (galleryPrevButton) galleryPrevButton.addEventListener('click', () => scrollGallery('prev'));
        if (galleryNextButton) galleryNextButton.addEventListener('click', () => scrollGallery('next'));

        // ---- Lightbox: klikk på hero-bilde forstørrer galleriet ----
        const lightbox = document.getElementById('sk-hero-lightbox-{{ section.id }}');
        if (lightbox) {
          const lbSlides = Array.from(lightbox.querySelectorAll('.sk-hero-lightbox__slide'));
          const lbCounter = lightbox.querySelector('.sk-hero-lightbox__counter');
          const lbClose = lightbox.querySelector('.sk-hero-lightbox__close');
          const lbPrev = lightbox.querySelector('.sk-hero-lightbox__nav--prev');
          const lbNext = lightbox.querySelector('.sk-hero-lightbox__nav--next');
          let lbIndex = 0;
          let lastFocused = null;

          function lbSetActive(index) {
            lbIndex = (index + lbSlides.length) % lbSlides.length;
            lbSlides.forEach((slide, i) => slide.classList.toggle('is-active', i === lbIndex));
            if (lbCounter) lbCounter.textContent = lbIndex + 1 + ' / ' + lbSlides.length;
          }

          function lbOnKeydown(e) {
            if (e.key === 'Escape') closeLightbox();
            else if (e.key === 'ArrowLeft') lbSetActive(lbIndex - 1);
            else if (e.key === 'ArrowRight') lbSetActive(lbIndex + 1);
          }

          function openLightbox(index) {
            lastFocused = document.activeElement;
            lbSetActive(index);
            lightbox.hidden = false;
            document.body.style.overflow = 'hidden';
            document.addEventListener('keydown', lbOnKeydown);
            if (lbClose) lbClose.focus();
          }

          function closeLightbox() {
            lightbox.hidden = true;
            document.body.style.overflow = '';
            document.removeEventListener('keydown', lbOnKeydown);
            if (shouldLoop && typeof heroSwiper.slideToLoop === 'function') heroSwiper.slideToLoop(lbIndex);
            else heroSwiper.slideTo(lbIndex);
            if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
          }

          swiperElement.addEventListener('click', function (e) {
            if (!e.target.closest('.swiper-slide img')) return;
            const index = typeof heroSwiper.realIndex === 'number' ? heroSwiper.realIndex : heroSwiper.activeIndex || 0;
            openLightbox(index);
          });

          if (lbClose) lbClose.addEventListener('click', closeLightbox);
          if (lbPrev) lbPrev.addEventListener('click', () => lbSetActive(lbIndex - 1));
          if (lbNext) lbNext.addEventListener('click', () => lbSetActive(lbIndex + 1));

          // Klikk på bakgrunnen (utenfor selve bildet) lukker
          lightbox.addEventListener('click', function (e) {
            if (
              e.target.classList.contains('sk-hero-lightbox__slide')
              || e.target.classList.contains('sk-hero-lightbox__stage')
            ) {
              closeLightbox();
            }
          });

          // Swipe på mobil
          let lbStartX = 0;
          let lbSwiping = false;
          lightbox.addEventListener(
            'touchstart',
            function (e) {
              if (!e.touches || e.touches.length !== 1) return;
              lbStartX = e.touches[0].clientX;
              lbSwiping = true;
            },
            { passive: true }
          );
          lightbox.addEventListener('touchend', function (e) {
            if (!lbSwiping || !e.changedTouches || e.changedTouches.length !== 1) return;
            const deltaX = e.changedTouches[0].clientX - lbStartX;
            if (Math.abs(deltaX) > 40) lbSetActive(deltaX < 0 ? lbIndex + 1 : lbIndex - 1);
            lbSwiping = false;
          });
        }
      })();

      // =========================
      // OFFER SWITCHING (Single vs Bundle)
      // - Updates: hidden variant id, shared price, buy/notify, card prices, sold-out state
      // =========================
      const root = document.getElementById('sk-radiance-product-hero-{{ section.id }}');
      if (!root) return;

      const baseHandle = root.dataset.baseHandle;
      const bundleHandleFromMeta = root.dataset.bundleHandle;
      const moneyFormat = root.dataset.moneyFormat || '{{ shop.money_format | escape }}';
      const baseTitle = {{ product.title | json }};
      const bundleTitleFallback = {{ bundle_title | default: product.title | json }};

      // If you do NOT use metafield custom.bundle_product, put your bundle handle here:
      const fallbackBundleHandle = '';
      const bundleHandle = bundleHandleFromMeta || fallbackBundleHandle;

      const baseVariant = {
        id: {{ product.selected_or_first_available_variant.id | json }},
        price: {{ product.selected_or_first_available_variant.price | json }},
        compare_at_price: {{ product.selected_or_first_available_variant.compare_at_price | json }},
        available: {{ product.selected_or_first_available_variant.available | json }}
      };

      const offerRadios = root.querySelectorAll('input[name="sk-offer"]');
      const bundleCard = root.querySelector('[data-sk-bundle-card]');
      const singleCard = root.querySelector('[data-sk-offer-card="single"]');
      const bundleCardWrap = root.querySelector('[data-sk-offer-card="bundle"]');

      const hiddenVariantInput = root.querySelector('[data-sk-selected-variant-id]');
      const sharedPriceEl = root.querySelector('[data-sk-shared-price]');
      const buyWrapper = root.querySelector('[data-sk-buy-wrapper]');
      const notifyWrapper = root.querySelector('[data-sk-notify-wrapper]');
      const notifyBtn = root.querySelector('[data-sk-notify-button]');

      const cardPriceBundle = root.querySelector('[data-sk-card-price="bundle"]');

      const productForm =
        root.querySelector('form[action^="/cart/add"]') ||
        root.querySelector('form[action*="/cart/add"]') ||
        document.querySelector('form[action^="/cart/add"]') ||
        document.querySelector('form[action*="/cart/add"]');

      const mainProductSection = document.getElementById('MainProduct-{{ section.id }}');

      const applyVariantToInput = (input, variantId) => {
        if (!input || !variantId) return;
        const nextValue = String(variantId);
        input.value = nextValue;
        input.setAttribute('value', nextValue);
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      };

      const getVariantInputs = () => {
        const inputs = [];

        if (productForm) {
          inputs.push(...productForm.querySelectorAll('input[name="id"]'));
          inputs.push(...productForm.querySelectorAll('.product-variant-id'));
        }

        inputs.push(...root.querySelectorAll('input[name="id"]'));
        inputs.push(...root.querySelectorAll('.product-variant-id'));

        return Array.from(new Set(inputs));
      };
      window.__SK_ACTIVE_VARIANT_ID = window.__SK_ACTIVE_VARIANT_ID || baseVariant.id;
      window.__SK_ACTIVE_OFFER = window.__SK_ACTIVE_OFFER || 'single';

      const clearProductFormErrors = () => {
        document.querySelectorAll('.product-form__error-message-wrapper').forEach((wrap) => {
          wrap.hidden = true;
          wrap.style.display = 'none';
          const msg = wrap.querySelector('.product-form__error-message');
          if (msg) msg.textContent = '';
        });

        document
          .querySelectorAll('[data-product-form-error], .form__message, .product-form__error')
          .forEach((el) => {
            el.hidden = true;
            el.style.display = 'none';
            if (el.tagName === 'P' || el.tagName === 'DIV') el.textContent = '';
          });
      };

      const setActiveVariantId = (variantId, offer = 'single') => {
        if (!variantId) return [];

        window.__SK_ACTIVE_VARIANT_ID = variantId;
        window.__SK_ACTIVE_OFFER = offer;

        applyVariantToInput(hiddenVariantInput, variantId);

        const inputs = getVariantInputs();

        inputs.forEach((input) => applyVariantToInput(input, variantId));

        // Force-update any other common id inputs (dynamic checkout / buy-now patterns)
        root.querySelectorAll('input[name="id"], input[name="items[0][id]"]').forEach((el) => {
          applyVariantToInput(el, variantId);
        });

        if (mainProductSection) {
          mainProductSection
            .querySelectorAll(
              'form[action^="/cart/add"], form[action*="/cart/add"], form[action^="/cart"], form[action*="/cart"]'
            )
            .forEach((form) => {
              form.querySelectorAll('input[name="id"], .product-variant-id, [data-sk-selected-variant-id]').forEach((el) => {
                applyVariantToInput(el, variantId);
              });
            });
        }

        clearProductFormErrors();

        return inputs;
      };


      const normalizeMoneyString = (value) =>
        typeof value === 'string' ? value.trim() : value;

      const defaultMoneyFormat = moneyFormat || '{% raw %}{{ amount }}{% endraw %}';

      const formatWithDelimiters = (amountInCents, precision = 2, thousands = ',', decimal = '.') => {
        if (amountInCents == null || isNaN(amountInCents)) return '0';

        const negative = amountInCents < 0 ? '-' : '';
        const base = Math.abs(amountInCents / 100).toFixed(Math.max(precision, 0));
        const [integerPart, decimalPart = ''] = base.split('.');
        const formattedInteger = integerPart.replace(/\B(?=(\d{3})+(?!\d))/g, thousands);

        if (precision === 0) {
          return `${negative}${formattedInteger}`;
        }

        return `${negative}${formattedInteger}${decimal}${decimalPart}`;
      };

      const formatMoneyFallback = (cents, formatString = defaultMoneyFormat) => {
        let value = typeof cents === 'string' ? cents.replace('.', '') : cents;
        value = isNaN(value) ? 0 : Number(value);

        const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        const formatMatch = formatString.match(placeholderRegex);
        const placeholder = formatMatch ? formatMatch[1] : 'amount';
        let formattedValue = '';

        switch (placeholder) {
          case 'amount_no_decimals':
            formattedValue = formatWithDelimiters(value, 0);
            break;
          case 'amount_with_comma_separator':
            formattedValue = formatWithDelimiters(value, 2, '.', ',');
            break;
          case 'amount_no_decimals_with_comma_separator':
            formattedValue = formatWithDelimiters(value, 0, '.', ',');
            break;
          case 'amount_no_decimals_with_space_separator':
            formattedValue = formatWithDelimiters(value, 0, ' ', ',');
            break;
          case 'amount_no_decimals_with_apostrophe_separator':
            formattedValue = formatWithDelimiters(value, 0, "'", '.');
            break;
          case 'amount':
          default:
            formattedValue = formatWithDelimiters(value, 2);
        }

        return formatString.replace(placeholderRegex, formattedValue);
      };

      const formatMoney = (cents) => {
        try {
          if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
            return normalizeMoneyString(window.Shopify.formatMoney(cents, moneyFormat));
          }
        } catch (e) {}
        return normalizeMoneyString(formatMoneyFallback(cents));
      };

      const fetchProductJson = async (handle) => {
        const safeHandle = encodeURIComponent(String(handle || '').trim());
        const res = await fetch(`/products/${safeHandle}.js`, { credentials: 'same-origin' });
        if (!res.ok) throw new Error(`Failed to load product JSON: ${handle}`);
        return await res.json();
      };

      const calcSavingsPercent = (compareAt, price) => {
        if (!compareAt || !price || compareAt <= price) return 0;
        return Math.round(((compareAt - price) / compareAt) * 100);
      };

      const ensureBadgeEl = (container) => {
        let badge = container.querySelector('.sk-price__badge');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'sk-price__badge';
          container.appendChild(badge);
        }
        return badge;
      };

      const pickDefaultVariant = (productJson) => {
        if (!productJson || !productJson.variants) return null;
        return productJson.variants.find((v) => v.available) || productJson.variants[0] || null;
      };

      const replaceSharedPrice = (variant) => {
        if (!sharedPriceEl || !variant) return;

        const valueEl = sharedPriceEl.querySelector('.sk-price__value');
        const currentEl = sharedPriceEl.querySelector('.sk-price__current');
        if (!currentEl) return;

        const priceContainer = currentEl.closest('.sk-price') || sharedPriceEl;
        const badgeEl = ensureBadgeEl(priceContainer);

        const compareAt = variant.compare_at_price;
        const price = variant.price;

        const shouldShowCompare = compareAt && compareAt > price;
        const pct = calcSavingsPercent(compareAt, price);

        if (valueEl) {
          valueEl.textContent = shouldShowCompare ? formatMoney(compareAt) : '';
          valueEl.removeAttribute('hidden');
          valueEl.style.visibility = shouldShowCompare ? 'visible' : 'hidden';
        }

        badgeEl.textContent = shouldShowCompare && pct > 0 ? `Spar ${pct}%` : '';

        currentEl.textContent = formatMoney(price);
      };

      const setAvailabilityUI = (available) => {
        if (buyWrapper) buyWrapper.style.display = available ? '' : 'none';
        if (notifyWrapper) notifyWrapper.style.display = available ? 'none' : 'block';
      };

      const setSubmitAvailabilityUI = (available) => {
        const scope = mainProductSection || root;
        if (!scope) return;

        const forms = Array.from(
          scope.querySelectorAll('form[action^="/cart/add"], form[action*="/cart/add"]')
        );
        if (!forms.length && productForm) forms.push(productForm);

        forms.forEach((form) => {
          const productFormEl = form.closest('product-form') || form;
          const submitBtn = productFormEl.querySelector('button[type="submit"], input[type="submit"]');
          if (!submitBtn) return;

          if (available) {
            submitBtn.removeAttribute('disabled');
            submitBtn.removeAttribute('aria-disabled');
          } else {
            submitBtn.setAttribute('disabled', 'disabled');
            submitBtn.setAttribute('aria-disabled', 'true');
          }

          const soldOutMessage = submitBtn.querySelector('.sold-out-message');
          const submitText = submitBtn.querySelector('span');
          if (soldOutMessage && submitText) {
            soldOutMessage.classList.toggle('hidden', !!available);
            submitText.classList.toggle('hidden', !available);
          }
        });
      };

      const setCardUnavailable = (cardEl, isUnavailable, variantId) => {
        if (!cardEl) return;
        cardEl.classList.toggle('is-unavailable', !!isUnavailable);
        cardEl.setAttribute('aria-disabled', isUnavailable ? 'true' : 'false');
        const cardNotifyBtn = cardEl.querySelector('[data-sk-card-notify-button]');
        if (cardNotifyBtn) {
          if (variantId) {
            cardNotifyBtn.setAttribute('data-variant-id', variantId);
          }
          cardNotifyBtn.classList.toggle('is-visible', !!isUnavailable);
        }
        const radioInput = cardEl.querySelector('input[type="radio"]');
        if (radioInput) {
          radioInput.disabled = !!isUnavailable;
        }
      };

      const setNotifyVariant = (variantId) => {
        if (!notifyBtn) return;
        notifyBtn.setAttribute('data-variant-id', variantId);
      };

      const openNotifyFlow = (variantId) => {
        if (!notifyWrapper) return;
        if (variantId) setNotifyVariant(variantId);
        notifyWrapper.style.display = 'block';
        notifyWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
        if (notifyBtn) notifyBtn.click();
      };

      const cardNotifyButtons = root.querySelectorAll('[data-sk-card-notify-button]');
      cardNotifyButtons.forEach((btn) => {
        btn.addEventListener('click', (event) => {
          event.preventDefault();
          event.stopPropagation();
          openNotifyFlow(btn.dataset.variantId || root.dataset.baseVariantId);
        });
      });

      const setBundleCardPrice = (variant) => {
        if (!cardPriceBundle || !variant) return;
        const valueEl = cardPriceBundle.querySelector('.sk-price__value');
        const currentEl = cardPriceBundle.querySelector('.sk-price__current');
        const priceContainer = (currentEl && currentEl.closest('.sk-price')) || cardPriceBundle;
        const badgeEl = ensureBadgeEl(priceContainer);

        const pct = calcSavingsPercent(variant.compare_at_price, variant.price);

        if (valueEl) {
          if (variant.compare_at_price && variant.compare_at_price > variant.price) {
            valueEl.textContent = formatMoney(variant.compare_at_price);
          } else {
            valueEl.textContent = '';
          }
        }
        badgeEl.textContent = pct > 0 ? `Spar ${pct}%` : '';
        if (currentEl) {
          currentEl.textContent = formatMoney(variant.price);
        }
      };

      const hydrateBundleCard = async () => {
        if (!bundleHandle) {
          if (bundleCard) bundleCard.style.display = 'none';
          return null;
        }

        try {
          const bundleJson = await fetchProductJson(bundleHandle);
          const bundleVariant = pickDefaultVariant(bundleJson);
          if (!bundleVariant) return null;

          setBundleCardPrice(bundleVariant);
          setCardUnavailable(bundleCardWrap, !bundleVariant.available, bundleVariant.id);

          return { product: bundleJson, variant: bundleVariant };
        } catch (e) {
          if (bundleCard) bundleCard.style.display = 'none';
          return null;
        }
      };

      const applyOffer = async (offerType, bundleData) => {
        let activeVariant = null;
        let activeProductId = null;

        if (offerType === 'single') {
          activeVariant = baseVariant;
          activeProductId = root.dataset.baseProductId;
        }

        if (offerType === 'bundle') {
          if (!bundleData || !bundleData.variant) return;
          activeVariant = bundleData.variant;
          activeProductId = bundleData.product?.id;
        }

        if (!activeVariant) return;

        setActiveVariantId(activeVariant.id, offerType);
        setNotifyVariant(activeVariant.id);
        
        // Update product-id input if it exists
        const productIdInputs = document.querySelectorAll('input[name="product-id"]');
        if (productIdInputs.length && activeProductId) {
          productIdInputs.forEach(input => {
            input.value = activeProductId;
          });
        }
        
        replaceSharedPrice(activeVariant);
        setAvailabilityUI(!!activeVariant.available);
        setSubmitAvailabilityUI(!!activeVariant.available);

        setCardUnavailable(singleCard, offerType === 'single' && !activeVariant.available, baseVariant.id);
        setCardUnavailable(bundleCardWrap, offerType === 'bundle' && !activeVariant.available, (bundleData && bundleData.variant) ? bundleData.variant.id : null);

        const offerTitle = offerType === 'bundle'
          ? (bundleData && bundleData.product && bundleData.product.title) || bundleTitleFallback || baseTitle
          : baseTitle;

        const priceText = formatMoney(activeVariant.price);
        const savingsPct = calcSavingsPercent(activeVariant.compare_at_price, activeVariant.price);
        const compareText =
          activeVariant.compare_at_price && activeVariant.compare_at_price > activeVariant.price
            ? formatMoney(activeVariant.compare_at_price)
            : '';
        const badgeText = savingsPct > 0 ? `Spar ${savingsPct}%` : '';
        document.dispatchEvent(new CustomEvent('sk:offerchange', {
          detail: {
            offer: offerType,
            variantId: activeVariant.id,
            price: activeVariant.price,
            compare_at_price: activeVariant.compare_at_price,
            priceText,
            compareText,
            badgeText,
            available: activeVariant.available,
            handle: offerType === 'single' ? baseHandle : bundleHandle,
            title: offerTitle
          }
        }));
      };

      const handleOfferChangeEvent = (event) => {
        const detail = event && event.detail;
        if (!detail || !detail.variantId) return;
        setActiveVariantId(detail.variantId, detail.offer || 'single');
      };

      document.addEventListener('sk:offerchange', handleOfferChangeEvent);

      // 1) Hydrate bundle card + store data
      const bundleData = await hydrateBundleCard();

      // 2) Listen to offer changes
      offerRadios.forEach((radio) => {
        radio.addEventListener('change', async function () {
          if (!this.checked) return;

          try {
            if (this.value === 'bundle') {
              await applyOffer('bundle', bundleData);
            } else {
              await applyOffer('single', bundleData);
            }
          } catch (e) {
            // fail safe: revert to single
            offerRadios.forEach((r) => {
              if (r.value === 'single') r.checked = true;
            });
            await applyOffer('single', bundleData);
          }
        });
      });

      // 3) Ensure initial offer is applied AND sticky bar is hydrated
      clearProductFormErrors();
      await applyOffer('single', bundleData);
    });
  </script>
</product-info>

