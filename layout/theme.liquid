    {%- comment -%}
      Performance interceptor — runs BEFORE content_for_header so the
      MutationObserver can catch nodes as Shopify inserts them.
      1. Converts accelerated-checkout-backwards-compat.css from render-blocking
         to non-blocking (media=print → onload → all).
      2. Defers any Google Fonts CSS injected by apps (same pattern).
      3. Delays heavy third-party scripts (Meta pixel, Klaviyo, GTM/gtag) until
         first user interaction OR 5 s timeout. This keeps the 0-5 s TBT window
         clean. Purchase tracking + GA4 still fire well before any conversion.
    {%- endcomment -%}
    <script>
      (function () {
        var deferCSS = /accelerated-checkout|fonts\.googleapis\.com/;
        /* Adobe kit CSS — injiseres av content_for_header saa lenge Shopifys
           Adobe Fonts-app er koblet til i admin. Temaet bruker ikke Adobe lenger
           (Fontshare, selvhostet), men appen fortsetter aa sende kit-CSS til den
           kobles fra. Blokkeringen staar til det er gjort; da kan den slettes. */
        var blockCSS = /use\.typekit\.net\/[a-z0-9]+\.css/;
        /* googletagmanager.com added: GTM/gtag was named in the comment above but
           was missing from the regex, so it ran during initial load. Only catches
           copies injected into the MAIN document — scripts loaded inside Shopify's
           sandboxed Web Pixel iframe are outside this MutationObserver's reach. */
        /* Okendo, UpPromote og bundler-appen lagt til (INP-arbeid, aug 2026):
           forsiden lastet okendo-reviews.js selv om temaets egen SKLoader-blokk
           bevisst hopper over Okendo utenfor produktsider — app-embeds injiserer
           sitt eget script utenom den. Ingen av disse har innhold over folden på
           forsiden, så de kan trygt vente på interaksjon / 5 s-timeouten.
           Stjernerangeringen har reservert plass (sk-base.css), så utsatt
           lasting gir ikke CLS. */
        var delayJS =
          /connect\.facebook\.net|static\.klaviyo\.com|googletagmanager\.com|cdn-static\.okendo\.io|uppromote|secomapp|nice-team|bundler/;
        var saved = [];
        var done = false;

        var mo = new MutationObserver(function (list) {
          for (var i = 0; i < list.length; i++) {
            var nodes = list[i].addedNodes;
            for (var j = 0; j < nodes.length; j++) {
              var n = nodes[j];
              if (n.nodeType !== 1) continue;
              /* Adobe kit CSS → strip entirely (redundant, CLS-causing) */
              if (n.tagName === 'LINK' && n.rel === 'stylesheet' && blockCSS.test(n.href || '')) {
                n.media = 'not all';
                n.disabled = true;
                if (n.parentNode) n.parentNode.removeChild(n);
                continue;
              }
              /* Non-critical CSS → non-blocking */
              if (n.tagName === 'LINK' && n.rel === 'stylesheet' && deferCSS.test(n.href || '')) {
                n.media = 'print';
                n.onload = function () {
                  this.media = 'all';
                };
              }
              /* Marketing scripts → delay until interaction / timeout.
                 NB: `type = 'text/plain'` hindrer KJOERING, ikke nedlasting.
                 MutationObserver fyrer etter innsetting, saa hentingen er
                 allerede startet. Skriptet lastes altsaa ned én gang uten aa
                 kjoere, og hentes igjen ved re-injisering — den andre gangen
                 fra cache (maalt transferSize 0). Baandbreddekostnaden er
                 dermed uendret, men nedlastingen skjer tidlig mens effekten
                 kommer sent. Forsoek paa aa avbryte med removeChild ga ingen
                 maalbar endring; en ekte loesning maa hindre innsettingen,
                 ikke reagere paa den. */
              if (n.tagName === 'SCRIPT' && n.src && delayJS.test(n.src)) {
                saved.push(n.src);
                n.type = 'text/plain';
              }
            }
          }
        });

        mo.observe(document.documentElement, { childList: true, subtree: true });

        /* INP-arbeid (aug 2026): tidligere ble ALLE utsatte skript (~35: Klaviyo,
           Okendo, pixels) injisert i én synkron løkke – trigget av brukerens
           FØRSTE interaksjon, altså nøyaktig i vinduet INP måles. Det ga en
           byge av long-tasks midt i tappet (målt INP 340 ms).
           Nå slippes de i små puljer per idle-slot: interaksjonen får returnere
           først, og hovedtråden puster mellom hver pulje. Ingenting fjernes –
           kun NÅR det kjøres endres. 2 s timeout garanterer at sporing fyrer
           selv om nettleseren aldri blir helt idle. */
        var idle =
          window.requestIdleCallback ||
          function (cb) {
            return setTimeout(cb, 1);
          };

        function drain(i) {
          if (i >= saved.length) return;
          idle(
            function () {
              /* Liten pulje per slot – nok til å komme gjennom raskt, lite nok
                 til at ingen enkelt task blir lang. */
              for (var n = 0; n < 2 && i < saved.length; n++, i++) {
                var s = document.createElement('script');
                s.src = saved[i];
                s.async = true;
                document.body.appendChild(s);
              }
              drain(i);
            },
            { timeout: 2000 }
          );
        }

        /* Prioritet: Google-taggene (GTM/gtag/Ads) skal fyre FØRST av de utsatte,
           så konverterings- og kampanjedata registreres så tidlig som mulig.
           De er få og lette sammenlignet med Klaviyo/Okendo, og køen sorteres
           bare – ingenting hoppes over.
           MERK: Clarity er ikke i delayJS i det hele tatt (lastes i <head>,
           linje ~18), så den har allerede høyest prioritet og berøres ikke. */
        var priorityJS = /googletagmanager\.com|google-analytics\.com|\/gtag\/|googleads|googleadservices/;

        function fire() {
          if (done) return;
          done = true;
          mo.disconnect();
          saved.sort(function (a, b) {
            return (priorityJS.test(b) ? 1 : 0) - (priorityJS.test(a) ? 1 : 0);
          });
          drain(0);
        }

        /* Expose: disconnect observer early once content_for_header is done,
           but keep delayed-fire for saved marketing scripts. */
        window.__SK_PERF = {
          disconnectObserver: function () {
            mo.disconnect();
          },
          fire: fire,
        };

        ['mouseover', 'touchstart', 'scroll', 'keydown'].forEach(function (e) {
          document.addEventListener(e, fire, { once: true, passive: true });
        });
        setTimeout(fire, 5000);
      })();
    </script>

    {%- comment -%}
      Server-side filtering of content_for_header:
      Strip any Product JSON-LD injected by apps (e.g. Okendo Rich Snippets)
      so only our sk-product-jsonld.liquid controls the Product schema.
      This ensures Google sees ONE authoritative Product schema in View Source.
    {%- endcomment -%}
    {%- capture cfh -%}{{ content_for_header }}{%- endcapture -%}
    {%- comment -%}
      Strip empty JSON-LD blocks injected by apps (e.g. Okendo on non-product pages).
      Uses broad 'application/ld+json' match to catch variants with extra attributes
      like <script type="application/ld+json" data-source="app-name">.
    {%- endcomment -%}
    {%- assign _ld_parts = cfh | split: '</script>' -%}
    {%- capture cfh -%}
      {%- for _part in _ld_parts -%}
        {%- if _part contains 'application/ld+json' -%}
          {%- assign _before_ld = _part | split: '<script' | first -%}
          {%- assign _after_script_open = _part | split: '<script' | last -%}
          {%- assign _tag_attrs = _after_script_open | split: '>' | first -%}
          {%- assign _tag_full = _tag_attrs | prepend: '<script' | append: '>' -%}
          {%- assign _ld_body = _part | split: _tag_full | last | strip -%}
          {{- _before_ld -}}
          {%- if _ld_body != blank -%}
            <script type="application/ld+json">{{- _ld_body -}}</script>
          {%- endif -%}
        {%- else -%}
          {{- _part -}}
          {%- unless forloop.last -%}</script>{%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if request.page_type == 'product' and cfh contains '"@type": "Product"' -%}
      {%- assign cfh_parts = cfh | split: '<script type="application/ld+json">' -%}
      {%- for part in cfh_parts -%}
        {%- if forloop.first -%}
          {{- part -}}
        {%- elsif part contains '"@type": "Product"' or part contains '"@type":"Product"' -%}
          {%- assign part_tails = part | split: '</script>' -%}
          {%- for tail in part_tails -%}
            {%- unless forloop.first -%}
              {%- unless forloop.last -%}
                {{- tail -}}
                </script>
              {%- else -%}
                {{- tail -}}
              {%- endunless -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          <script type="application/ld+json">
            {{- part -}}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {{- cfh -}}
    {%- endif -%}

    {%- comment -%}
      Disconnect the performance interceptor's MutationObserver now that
      content_for_header has been rendered. All CSS/script injections it
      needs to catch are already processed. Leaving it running would fire
      the callback on every subsequent DOM mutation — unnecessary TBT cost.
    {%- endcomment -%}
    <script>
      if (window.__SK_PERF) window.__SK_PERF.disconnectObserver();
    </script>

