{%- comment -%}
  ab-radiance — MÅLING for A/B-testen av produktsiden for Skinora Radiance Face.

  Fordelingen gjøres av Google Ads (Eksperimenter): kontrollarmen lander på
  den vanlige produktsiden (A), eksperimentarmen får Final URL suffix
  view=sk-lp-radiance og lander på product.sk-lp-radiance (B). Ingen
  omdirigering, ingen cookie, ingen skjuling – B laster like fort som A, og
  Google-referansen og gclid følger med.

  (Til 29.09.2026 fordelte dette skriptet selv med cookie + location.replace.
  Det kostet en ekstra sidelasting på B og talte ikke dem som snudde under
  omlastingen. Erstattet av Ads-eksperimentet; tellingen startet på nytt.)

  Rendres øverst i <head> fra theme.liquid, bare på denne produktsiden og bare
  når temainnstillingen ab_radiance_enabled er på.

  Hvem telles:
    B = siden vises med ?view=sk-lp-radiance
    A = vanlig produktside OG URL-en har en Google-klikk-ID (gclid, gbraid,
        wbraid, srsltid) – altså trafikk fra kontrollarmen
    Alle andre (organisk, direkte, Meta) telles ikke.
    ?ab=A|B overstyrer for QA.

  Måling: GA4 ab_exposure + brukeregenskap ab_rf_variant via sidens egen gtag
  (lastes av Google & YouTube-appen – vi venter på den, definerer den aldri),
  og cart attribute _ab_rf_variant (første eksponering vinner) så varianten
  følger ordren.

  Alt er pakket i try/catch: en feil her skal aldri blokkere siden.
{%- endcomment -%}
<script>
  (function () {
    try {
      var EXPERIMENT = 'rf_ads_2026_09';
      var VIEW = 'sk-lp-radiance';
      var CLICK_IDS = ['gclid', 'gbraid', 'wbraid', 'srsltid'];

      var params = new URLSearchParams(window.location.search);
      var qa = (params.get('ab') || '').toUpperCase();
      var onB = params.get('view') === VIEW;
      var hasClickId = CLICK_IDS.some(function (k) { return params.has(k); });

      var variant = null;
      if (qa === 'A' || qa === 'B') variant = qa;
      else if (onB) variant = 'B';
      else if (hasClickId) variant = 'A';
      if (!variant) return; // utenfor testen

      (function waitForGtag(triesLeft) {
        if (typeof window.gtag === 'function') {
          window.gtag('set', 'user_properties', { ab_rf_variant: variant });
          window.gtag('event', 'ab_exposure', { experiment_id: EXPERIMENT, variant: variant });
          return;
        }
        if (triesLeft > 0) setTimeout(function () { waitForGtag(triesLeft - 1); }, 250);
      })(40);

      // Første eksponering vinner: en kunde som først så B og senere kommer
      // til A-siden, beholder B på ordren.
      fetch('/cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          if (cart && cart.attributes && cart.attributes._ab_rf_variant) return;
          return fetch('/cart/update.js', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: { _ab_rf_variant: variant } })
          });
        })
        .catch(function () {});
    } catch (e) {}
  })();
</script>
