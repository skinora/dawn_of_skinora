{%- comment -%}
  ab-radiance — 50/50 A/B-test av produktsiden for Skinora Radiance Face.

  A = vanlig produktmal. B = product.lp-radiance (landingssiden som produktmal),
  vist via ?view=lp-radiance på samme URL. Canonical peker allerede til
  produkt-URL-en (theme.liquid, canonical_url), så B blir ikke en egen side.

  Rendres øverst i <head> fra theme.liquid, bare på denne produktsiden og bare
  når temainnstillingen ab_radiance_enabled er på. Av = ingen kode på siden.

  Hvem er med: bare besøkende som kommer med en Google-klikk-ID (gclid, gbraid,
  wbraid, srsltid) ved første besøk. Alle andre, også organisk og Meta, står
  utenfor: ingen cookie, ingen omdirigering, ingen hendelse. ?ab=A|B overstyrer
  for QA, uansett kilde. Roboter behandles som alle andre (ingen UA-sjekk).

  Måling: GA4 ab_exposure + brukeregenskap ab_rf_variant via sidens egen gtag
  (lastes av Google & YouTube-appen – vi venter på den, definerer den aldri),
  og cart attribute _ab_rf_variant så varianten følger ordren.

  Alt er pakket i try/catch: en feil her skal aldri blokkere siden.
{%- endcomment -%}
<script>
  (function () {
    try {
      var EXPERIMENT = 'rf_lp_2026_10';
      var COOKIE = 'sk_ab_rf';
      var VIEW = 'lp-radiance';
      var CLICK_IDS = ['gclid', 'gbraid', 'wbraid', 'srsltid'];

      var url = new URL(window.location.href);
      var params = url.searchParams;
      var onB = params.get('view') === VIEW;
      var hasClickId = CLICK_IDS.some(function (k) { return params.has(k); });
      var match = document.cookie.match(/(?:^|;\s*)sk_ab_rf=([AB])(?:;|$)/);
      var variant = match ? match[1] : null;
      var qa = (params.get('ab') || '').toUpperCase();

      function setCookie(v) {
        document.cookie = COOKIE + '=' + v + '; Max-Age=5184000; Path=/; SameSite=Lax; Secure';
      }

      if (qa === 'A' || qa === 'B') {
        variant = qa;
        setCookie(variant);
      } else if (!variant) {
        // Utenfor testen. Gjelder også en delt ?view=lp-radiance-lenke uten
        // klikk-ID: siden vises som B, men telles ikke.
        if (!hasClickId) return;
        if (onB) {
          variant = 'B';
        } else {
          var byte = new Uint8Array(1);
          window.crypto.getRandomValues(byte);
          variant = byte[0] < 128 ? 'A' : 'B';
        }
        setCookie(variant);
      }

      if (variant === 'B' && !onB) {
        params.set('view', VIEW);
        params.delete('ab');
        // Anti-flimmer bare for B, og aldri lenger enn 1,5 s.
        var root = document.documentElement;
        root.style.visibility = 'hidden';
        setTimeout(function () { root.style.visibility = ''; }, 1500);
        window.location.replace(url.toString());
        return;
      }

      // Tildelt A, men står på en B-lenke (f.eks. delt URL): vis siden som den
      // er, men ikke registrer eksponering – innholdet matcher ikke varianten.
      if (variant === 'A' && onB) return;

      (function waitForGtag(triesLeft) {
        if (typeof window.gtag === 'function') {
          window.gtag('set', 'user_properties', { ab_rf_variant: variant });
          window.gtag('event', 'ab_exposure', { experiment_id: EXPERIMENT, variant: variant });
          return;
        }
        if (triesLeft > 0) setTimeout(function () { waitForGtag(triesLeft - 1); }, 250);
      })(40);

      fetch('/cart.js', { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          if (cart && cart.attributes && cart.attributes._ab_rf_variant === variant) return;
          return fetch('/cart/update.js', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: { _ab_rf_variant: variant } })
          });
        })
        .catch(function () {});
    } catch (e) {}
  })();
</script>
