{%- liquid
  assign resolved_section_id = section_id | default: section.id
  assign resolved_product_form_id = product_form_id | default: 'product-form-' | append: resolved_section_id
  assign current_variant = product.selected_or_first_available_variant

  # Knappetekst: under kampanje bærer den besparelsen. «Legg i handlekurv» er
  # en instruksjon; «Legg i kurv – spar 1 300 kr» er et argument. Beløpet
  # regnes fra produktets egne tall (evt. forhåndsvisningsprisen på DEV), så
  # knappen aldri kan love noe annet enn kampanjestripen over den.
  assign btn_label = 'products.product.add_to_cart' | t
  assign btn_save = 0
  if settings.kampanje_aktiv
    if product.compare_at_price > product.price
      assign btn_save = product.compare_at_price | minus: product.price
    elsif settings.kampanje_forhandsvis_ordinaerpris > 0
      assign _prev = settings.kampanje_forhandsvis_ordinaerpris | times: 100
      if _prev > product.price
        assign btn_save = _prev | minus: product.price
      endif
    endif
    if btn_save > 0
      # Beløpet MÅ formateres i et eget steg. Skrevet på én linje traff
      # | money_without_trailing_zeros resultatet av replace (hele strengen),
      # ikke tallet – og knappen endte med å vise «0».
      assign btn_save_money = btn_save | money_without_trailing_zeros
      assign btn_label = 'sections.cart.campaign_cta' | t | replace: '{amount}', btn_save_money
    endif
  endif
-%}

<div
  class="sk-radiance-buy-buttons sk-radiance-buy-buttons--{{ block.settings.button_layout }} sk-radiance-buy-buttons--{{ block.settings.button_style }}"
  {{ block.shopify_attributes }}
>
  <div class="sk-radiance-buy-buttons__container">
    <product-form class="sk-radiance-product-form" data-section-id="{{ resolved_section_id }}">
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: resolved_product_form_id,
        class: 'sk-radiance-product-form__form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ current_variant.id }}"
          class="product-variant-id"
          form="{{ resolved_product_form_id }}"
          data-sk-selected-variant-id
        >

        <div class="sk-radiance-buy-buttons__wrapper">
          <div class="sk-radiance-buy-buttons__buttons">
            <button
              id="ProductSubmitButton-{{ resolved_section_id }}"
              type="submit"
              name="add"
              class="sk-btn sk-btn--primary sk-radiance-buy-buttons__button"
              style="width: 100%;"
            >
              <span class="sk-radiance-buy-buttons__button-text">
                {{ btn_label }}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          </div>
        </div>
      {%- endform -%}
    </product-form>
  </div>

  {%- comment -%} Pickup availability removed - snippet not available {%- endcomment -%}
</div>
