{%- liquid
  assign resolved_section_id = section_id | default: section.id
  assign resolved_product_form_id = product_form_id | default: 'product-form-' | append: resolved_section_id
  assign current_variant = product.selected_or_first_available_variant

  # Knappetekst: under kampanje bærer den besparelsen. «Legg i handlekurv» er
  # en instruksjon; «Legg i kurv – spar 1 300 kr» er et argument. Beløpet
  # regnes fra produktets egne tall (evt. forhåndsvisningsprisen på DEV), så
  # knappen aldri kan love noe annet enn kampanjestripen over den.
  assign btn_label = 'products.product.add_to_cart' | t
  assign btn_save = 0
  if settings.kampanje_aktiv
    if product.compare_at_price > product.price
      assign btn_save = product.compare_at_price | minus: product.price
    elsif settings.kampanje_forhandsvis_ordinaerpris > 0
      assign _prev = settings.kampanje_forhandsvis_ordinaerpris | times: 100
      if _prev > product.price
        assign btn_save = _prev | minus: product.price
      endif
    endif
    if btn_save > 0
      # Beløpet MÅ formateres i et eget steg. Skrevet på én linje traff
      # | money_without_trailing_zeros resultatet av replace (hele strengen),
      # ikke tallet – og knappen endte med å vise «0».
      assign btn_save_money = btn_save | money_without_trailing_zeros
      assign btn_label = 'sections.cart.campaign_cta' | t | replace: '{amount}', btn_save_money
    endif
  endif
-%}

<div
  class="sk-radiance-buy-buttons sk-radiance-buy-buttons--{{ block.settings.button_layout }} sk-radiance-buy-buttons--{{ block.settings.button_style }}"
  {{ block.shopify_attributes }}
>
  <div class="sk-radiance-buy-buttons__container">
    <product-form class="sk-radiance-product-form" data-section-id="{{ resolved_section_id }}">
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: resolved_product_form_id,
        class: 'sk-radiance-product-form__form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ current_variant.id }}"
          class="product-variant-id"
          form="{{ resolved_product_form_id }}"
          data-sk-selected-variant-id
        >

        <div class="sk-radiance-buy-buttons__wrapper">
          <div class="sk-radiance-buy-buttons__buttons">
            {%- comment -%}
              data-sk-main-atc er ankeret for to uavhengige maalinger:
              sticky-baren skjuler seg naar denne knappen er synlig, og
              atc_visible-eventet fyrer foerste gang den kommer i viewport.
              Begge trenger ETT stabilt holdepunkt — id-en inneholder
              seksjons-id og er derfor ikke egnet som selektor.
            {%- endcomment -%}
            <button
              id="ProductSubmitButton-{{ resolved_section_id }}"
              data-sk-main-atc
              type="submit"
              name="add"
              class="sk-btn sk-btn--primary sk-radiance-buy-buttons__button"
              style="width: 100%;"
            >
              <span class="sk-radiance-buy-buttons__button-text">
                {{ btn_label }}
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          </div>
        </div>
      {%- endform -%}
    </product-form>
  </div>

  {%- comment -%} Pickup availability removed - snippet not available {%- endcomment -%}
</div>

{%- comment -%}
  ── Klikk-respons paa hovedknappen ────────────────────────────────────────
  Knappen foeltes uresponsiv: man maatte trykke hardt eller flere ganger foer
  noe skjedde. Trefferflaten er ikke problemet — den er 339x49 px, ingenting
  ligger over den, og den er ikke deaktivert. Problemet er at det gaar ~0,7 s
  med kurv-kallet uten at knappen sier fra om at trykket ble registrert.

  Sticky-baren har allerede en «Legger til …»-tilstand nettopp av denne
  grunn, med denne begrunnelsen i koden: «umiddelbar respons paa knappen som
  faktisk ble trykket». Hovedknappen fikk aldri den behandlingen — den laa
  langt nede paa siden og var ikke den man trykket paa. Naa som den ligger
  over folden arver den problemet.

  To lag, i den rekkefoelgen de merkes:

  1. :active gir svar paa SAMME frame som fingeren treffer. Ren CSS, ingen
     JS involvert, ingen ventetid. Temaets eksisterende regel var
     translateY(1px) — for smaatt til aa merkes paa en telefon.

  2. .is-adding settes ved pointerdown, ikke ved submit. Pointerdown fyrer
     med det samme; submit venter paa at fingeren slippes.

  Opprydningen er med vilje paranoid. En knapp som henger i «Legger til …»
  er verre enn ingen tilstand i det hele tatt, saa den nullstilles paa alt
  som ligner en avslutning — inkludert en hard tidsfrist.
{%- endcomment -%}

<style>
  body .sk-radiance-buy-buttons__button:active {
    transform: scale(0.985) translateY(1px);
    filter: brightness(0.92);
  }

  .sk-radiance-buy-buttons__button.is-adding {
    cursor: progress;
    filter: brightness(0.92);
  }

  /* MERK: ingen ::after med ellipse her.
     Foerste versjon la paa « …» for aa gi umiddelbar respons. Men temaets
     egen product-form.js bytter allerede hele etiketten til «Legger til …»
     (locales/nb.json -> products.product.adding), saa de to la seg oppaa
     hverandre og knappen sa «Legger til … …».

     Den umiddelbare responsen er uansett daekket av :active, som svarer paa
     samme frame som fingeren treffer, og av .is-adding sin nedtoning. */

  @media (prefers-reduced-motion: reduce) {
    body .sk-radiance-buy-buttons__button:active {
      transform: none;
    }
  }
</style>

<script>
  (function () {
    var SEL = '[data-sk-main-atc]';

    function clear(btn) {
      if (btn) btn.classList.remove('is-adding');
    }

    function clearAll() {
      document.querySelectorAll(SEL + '.is-adding').forEach(clear);
    }

    document.addEventListener(
      'pointerdown',
      function (event) {
        var btn = event.target.closest && event.target.closest(SEL);
        if (!btn || btn.disabled) return;

        btn.classList.add('is-adding');

        /* Hard frist. Feiler kurv-kallet, eller svarer det aldri, skal
           knappen uansett bli trykkbar igjen. */
        setTimeout(function () {
          clear(btn);
        }, 3000);
      },
      true
    );

    /* Alt som betyr «ferdig»: kurven oppdatert, skuffen aapnet, eller
       brukeren forlot og kom tilbake. */
    ['cart:updated', 'cart:refresh', 'cart-drawer:open', 'sk:cartupdated'].forEach(function (name) {
      document.addEventListener(name, clearAll);
    });

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) clearAll();
    });

    /* Kurv-skuffen har ingen felles hendelse paa tvers av temaets varianter,
       saa vi ser etter at den faktisk aapner seg i DOM-en. */
    if (window.MutationObserver) {
      var drawer = document.querySelector('cart-drawer');
      if (drawer) {
        new MutationObserver(function () {
          if (drawer.classList.contains('active')) clearAll();
        }).observe(drawer, { attributes: true, attributeFilter: ['class'] });
      }
    }
  })();
</script>
