{%- comment -%}
  sk-article-body — article.content med én H1 per side.

  Seksjonen setter artikkeltittelen som <h1>. Flere artikler har i tillegg
  limt inn tittelen som <h1> øverst i selve teksten (etter byline-avsnittet),
  så siden fikk to H1 og tittelen sto to ganger.

  - En <h1> før første <h2> er en gjentatt tittel og fjernes.
  - Øvrige <h1> er egentlig mellomtitler og senkes til <h2>.

  - Lenker til konkurrenter fjernes: <a>-taggen strippes, lenketeksten blir
    stående som ren tekst (artikkelen kan fortsatt nevne navnet). Treffer på
    VERTSNAVNET i href (ikke tittel eller tekst), så forskningskilder som
    PubMed og AAD og lenker til skinora.no ikke berøres. Listen ligger i
    sab_blocked under; legg til et ord for å blokkere flere. «shark» treffer
    alle vertsnavn som inneholder ordet. Artikkelinnholdet i Shopify røres
    ikke, så regelen overlever synkingen fra det andre systemet.

  Bruk: {%- render 'sk-article-body', html: article.content -%}
  Kan fanges med capture når innholdet skal bearbeides videre.
{%- endcomment -%}
{%- liquid
  assign sab_html = html
  assign sab_intro = sab_html | split: '<h2' | first

  if sab_intro contains '<h1'
    assign sab_inner = sab_intro | split: '<h1' | slice: 1 | first | split: '</h1>' | first
    assign sab_title = '<h1' | append: sab_inner | append: '</h1>'
    assign sab_html = sab_html | remove_first: sab_title
  endif

  assign sab_html = sab_html | replace: '<h1', '<h2' | replace: '</h1>', '</h2>'

  assign sab_blocked = 'alvaskin,alva-skin,shark,iviskin,omnilux,currentbody' | split: ','
  if sab_html contains '<a '
    assign sab_parts = sab_html | split: '<a '
    assign sab_out = sab_parts.first
    for sab_part in sab_parts offset: 1
      assign sab_attrs = sab_part | split: '>' | first
      assign sab_href = ''
      if sab_attrs contains 'href="'
        assign sab_href = sab_attrs | split: 'href="' | last | split: '"' | first
      elsif sab_attrs contains "href='"
        assign sab_href = sab_attrs | split: "href='" | last | split: "'" | first
      endif
      assign sab_href = sab_href | downcase | strip
      assign sab_drop = false
      assign sab_lead = sab_href | slice: 0, 2
      if sab_href contains '://' or sab_lead == '//'
        assign sab_host = sab_href | split: '//' | last | split: '/' | first | split: '?' | first
        for sab_word in sab_blocked
          if sab_host contains sab_word
            assign sab_drop = true
          endif
        endfor
      endif
      if sab_drop
        assign sab_unwrapped = sab_part | remove_first: sab_attrs | slice: 1, sab_part.size | remove_first: '</a>'
        assign sab_out = sab_out | append: sab_unwrapped
      else
        assign sab_out = sab_out | append: '<a ' | append: sab_part
      endif
    endfor
    assign sab_html = sab_out
  endif
-%}
{{- sab_html -}}
