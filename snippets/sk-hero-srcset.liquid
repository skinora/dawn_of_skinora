{%- comment -%}
  sk-hero-srcset — srcset med w-beskrivelser for et fullbredde-bilde.

  Forventer:
    image  – Shopify-bildeobjekt
    widths – kommaliste med ønskede bredder, f.eks. '1600,2000,2600,3168'

  Bredder større enn kildefilen kappes til kildens egen bredde. En kandidat
  som er mindre enn 10 % bredere enn den forrige hoppes over: mobilbildet er
  768 px, så listen '750,1000,1500' ble '750w, 768w' — to nesten like filer.
  Shopify kan uansett ikke levere flere piksler enn kildefilen har.

  Bruk: {%- render 'sk-hero-srcset', image: img, widths: '750,1500' -%}
{%- endcomment -%}
{%- liquid
  assign shs_prev = 0
  assign shs_out = ''
  assign shs_list = widths | split: ','
  for shs_w in shs_list
    assign shs_px = shs_w | strip | plus: 0
    if image.width < shs_px
      assign shs_px = image.width
    endif
    assign shs_floor = shs_prev | times: 11 | divided_by: 10
    if shs_px > shs_floor
      assign shs_prev = shs_px
      assign shs_url = image | image_url: width: shs_px
      assign shs_item = shs_url | append: ' ' | append: shs_px | append: 'w'
      if shs_out == ''
        assign shs_out = shs_item
      else
        assign shs_out = shs_out | append: ', ' | append: shs_item
      endif
    endif
  endfor
-%}
{{- shs_out -}}
