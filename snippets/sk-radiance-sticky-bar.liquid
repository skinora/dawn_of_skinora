{%- comment -%}
  Snippet: sk-radiance-sticky-bar
  FINAL FIX:
  - No inline transforms
  - CSS controls animation
  - Scroll-triggered visibility
  - Correct offer sync
  - No regressions
{%- endcomment -%}

<style>
  /* =============================
     STICKY BAR (PORTAL)
  ============================== */

  .sk-radiance-sticky-bottom-bar--portal {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2147483000;

    /* Gradienten gir knappen noe aa staa MOT. Med ensfarget --ink-900 fikk
       baren samme farge som knappen, og knappen forsvant inn i flaten.

       Jeg fjernet den en kort stund fordi prisen maalte 1,69:1 mot den lyse
       enden — men det gjaldt en midlertidig radlayout der prisen sto helt
       til venstre, paa #c9c6cc. I to-raders layouten staar prisen SENTRERT,
       altsaa midt i overgangen (~rgb(123,112,132)), og maaler 4,7:1. Det
       klarer WCAG AA baade for stor og normal tekst.

       Konklusjonen: gradienten var aldri problemet — radlayouten var det.
       Endres layouten slik at prisen flyttes mot venstre igjen, maa
       kontrasten maales paa nytt. */
    background: linear-gradient(90deg, #c9c6cc, var(--ink-900));
    color: #fff;
    padding: 0.5rem 0;
    box-sizing: border-box;

    display: flex;
    align-items: center;

    box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.18);

    transform: translateY(100%);
    transition: transform 0.28s ease;
  }

  /* Skjul sticky-baren når handlekurv-skuffen er åpen. Baren ligger på
     z-index 2147483000 (over skuffens 1000), så den dekket ellers «gå til
     kasse»-knappen nederst i skuffen. cart-drawer.active = åpen skuff. */
  body:has(cart-drawer.active) .sk-radiance-sticky-bottom-bar--portal {
    display: none;
  }

  /* Tablet + desktop: make sticky bar ~33% taller */
  @media (min-width: 750px) {
    .sk-radiance-sticky-bottom-bar--portal {
      padding: 0.75rem 0;
    }
  }

  .sk-radiance-sticky-bottom-bar--portal.visible {
    transform: translateY(0);
  }

  .sk-radiance-sticky-bottom-bar {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0 1.25rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  /* Tablet + desktop: match the taller look from padding: 1.8rem and bring content closer to center */
  @media (min-width: 750px) {
    .sk-radiance-sticky-bottom-bar--portal {
      padding: 1.8rem 18px;
    }

    .sk-radiance-sticky-bottom-bar {
      padding: 0;
    }

    .sk-radiance-sticky-bottom-bar__content {
      max-width: 1200px;
      margin: 0 auto;
    }

    .sk-radiance-sticky-bottom-bar__product-name {
      font-size: 2.5rem;
      font-weight: 500;
      line-height: 1.25;
    }

    .sk-radiance-sticky-bottom-bar__price {
      font-family: var(--font-body-family, var(--font-heading-family, inherit));
      font-size: 2.5rem;
      font-weight: 500;
      line-height: 1.25;
    }

    .sk-radiance-sticky-bottom-bar__price .sk-price__value,
    .sk-radiance-sticky-bottom-bar__price .sk-price__current {
      font: inherit;
      opacity: 1;
    }

    .sk-radiance-sticky-bottom-bar__price .sk-price__value {
      text-decoration: line-through;
      text-decoration-thickness: 1.5px;
      opacity: 0.65;
      font-size: 1.8rem;
      font-weight: 400;
    }

    .sk-radiance-sticky-bottom-bar__price .sk-price__badge {
      font-size: 1.2rem;
    }

    .sk-radiance-sticky-bottom-bar__cta {
      font-size: 2rem;
      min-height: 4.8rem;
      padding: 0 48px;
    }
  }

  .sk-radiance-sticky-bottom-bar__content {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .sk-radiance-sticky-bottom-bar__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.25rem;
  }

  .sk-radiance-sticky-bottom-bar__product-name {
    font-size: 2.5rem;
    font-weight: 500;
    color: #fff;
    margin: 0;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sk-radiance-sticky-bottom-bar__price {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 1.25rem;
    line-height: 1;
  }

  /* Var 0.8rem. Rot er 10px (sk-base.css:8), saa det ble 8px — forfatteren
     regnet mot 16px og mente 12,8px. --fs-xs er 13-14px, altsaa det som var
     tenkt, og caption-gulvet i CLAUDE.md. */
  .sk-radiance-sticky-bottom-bar__price .sk-price__value {
    font-size: var(--fs-xs);
    opacity: 0.85;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .sk-radiance-sticky-bottom-bar__price .sk-price__value:empty {
    display: none;
  }

  /* Var 1.25rem = 12,5px. Dette er salgsprisen i den vedvarende
     kjoepsknappen paa mobil — sidens viktigste tall. Mente 20px. */
  .sk-radiance-sticky-bottom-bar__price .sk-price__current {
    font-size: var(--fs-xl);
    font-weight: 600;
  }

  .sk-radiance-sticky-bottom-bar__price .sk-price__badge {
    display: inline-block;
    font-size: var(--fs-xs); /* var 0.8rem = 8px */
    font-weight: 600;
    color: var(--sk-brand, var(--ink-900));
    background: color-mix(in srgb, var(--color-lilac, #cdb7ed) 30%, #fff);
    border: 1.5px solid var(--sk-brand, var(--ink-900));
    padding: 0.2em 0.5em;
    border-radius: 4px;
    line-height: 1.3;
    white-space: nowrap;
  }

  .sk-radiance-sticky-bottom-bar__price .sk-price__badge:empty {
    display: none;
  }

  .sk-radiance-sticky-bottom-bar__cta {
    cursor: pointer;
  }

  /* «Legger til …»-tilstand: umiddelbar respons på knappen som faktisk ble
     trykket. Hovedskjemaets knapp er scrollet ut av syne når baren er synlig,
     så uten dette så klikket uresponsivt ut i de ~0,7 s kallet tar. */
  .sk-radiance-sticky-bottom-bar__cta.is-adding {
    background: rgba(var(--color-brand-rgb), 0.82);
    cursor: progress;
  }

  .sk-radiance-sticky-bottom-bar__button {
    min-width: clamp(10rem, 24vw, 15rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Tablet + desktop: keep CTA compact (mobile stays full-width via max-width rule below) */
  @media (min-width: 750px) {
    /* Ensure desktop/tablet price typography wins over the base small sizes below */
    .sk-radiance-sticky-bottom-bar__price {
      font-family: var(--font-body-family, var(--font-heading-family, inherit));
      font-size: 2.5rem;
      font-weight: 500;
      line-height: 1.25;
    }

    .sk-radiance-sticky-bottom-bar__price .sk-price__value,
    .sk-radiance-sticky-bottom-bar__price .sk-price__current {
      font-size: inherit;
      font-weight: inherit;
      line-height: inherit;
      opacity: 1;
    }

    .sk-radiance-sticky-bottom-bar__price .sk-price__value {
      font-size: 1.6rem;
      font-weight: 400;
      opacity: 0.65;
      text-decoration: line-through;
      text-decoration-thickness: 1.5px;
    }

    .sk-radiance-sticky-bottom-bar__price .sk-price__badge {
      font-size: 1.1rem;
    }

    .sk-radiance-sticky-bottom-bar__cta {
      font-size: 2rem;
      min-height: 4.8rem;
      padding: 0 48px;
    }

    .sk-radiance-sticky-bottom-bar__button {
      min-width: auto;
    }
  }

  /* ── Mobil: tilbake til to rader ──────────────────────────────────────────
     Jeg forsoekte aa presse baren fra 116 til 52 px ved aa legge pris og
     knapp paa samme rad. Det ga gjentatte feil: knappen arvet width:100%
     fra .sk-btn og rant utenfor skjermen, og da jeg loeste det ble prisens
     foer-pris og spar-merke skjult for aa skaffe plass.

     Baren er det siste kjoepspunktet paa siden. En bar som er 64 px hoy men
     viser en kuttet knapp eller mangler besparelsen, er verre enn en som er
     116 px og fungerer. Derfor er radlayouten reversert i sin helhet.

     Beholdt fra forsoeket: ensfarget bakgrunn (gradienten ga 1,69:1 kontrast
     paa prisen) og IntersectionObserver-styringen, som er uavhengig av
     dette og retter at baren ikke viste seg ved foerste paint.

     Skal hoeyden ned igjen, maa det gjoeres med en skjerm foran seg — ikke
     paa maalinger i en fane som ikke maler frames. */
  @media (max-width: 749px) {
    .sk-radiance-sticky-bottom-bar {
      padding: 0 0.75rem;
    }

    .sk-radiance-sticky-bottom-bar__content {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .sk-radiance-sticky-bottom-bar__info {
      width: 100%;
      text-align: center;
    }

    .sk-radiance-sticky-bottom-bar__product-name {
      font-size: 1.125rem;
      white-space: normal;
      line-height: 1.4;
      max-height: 2.8em;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .sk-radiance-sticky-bottom-bar__price {
      justify-content: center;
    }

    .sk-radiance-sticky-bottom-bar__button {
      width: 100%;
      min-width: auto;
    }
  }
</style>

{%- liquid
  assign section_id = section.id
  assign add_label = 'products.product.add_to_cart' | t
  assign sold_out_label = 'products.product.sold_out' | t
  assign adding_label = 'Legger til …'
  assign selected_variant = product.selected_or_first_available_variant
-%}

<!-- SOURCE TEMPLATE -->
<div id="stickyBottomBar-{{ section_id }}" style="display:none">
  <div class="sk-radiance-sticky-bottom-bar" data-sk-sticky>
    <div class="sk-radiance-sticky-bottom-bar__content">
      <div class="sk-radiance-sticky-bottom-bar__info">
        <div class="sk-radiance-sticky-bottom-bar__product-name" data-sk-sticky-title>
          {{ product.title }}
        </div>
      </div>

      <div class="sk-radiance-sticky-bottom-bar__price">
        <span class="sk-price__current">{{ selected_variant.price | money_without_trailing_zeros }}</span>
        <span class="sk-price__value">
          {%- if selected_variant.compare_at_price and selected_variant.compare_at_price > selected_variant.price -%}
            {{ selected_variant.compare_at_price | money_without_trailing_zeros }}
          {%- endif -%}
        </span>
        {%- if selected_variant.compare_at_price and selected_variant.compare_at_price > selected_variant.price -%}
          {%- assign sticky_savings_pct = selected_variant.compare_at_price
            | minus: selected_variant.price
            | times: 100
            | divided_by: selected_variant.compare_at_price
          -%}
          <span class="sk-price__badge">Spar {{ sticky_savings_pct }}%</span>
        {%- endif -%}
      </div>

      <button
        type="button"
        class="sk-btn sk-btn--primary sk-radiance-sticky-bottom-bar__cta sk-radiance-sticky-bottom-bar__button"
        data-sk-sticky-cta
        data-product-form="{{ product_form_id }}"
        {%- unless selected_variant.available -%}
          disabled
        {%- endunless -%}
      >
        {%- if selected_variant.available -%}
          {{ add_label }}
        {%- else -%}
          {{ sold_out_label }}
        {%- endif -%}
      </button>
    </div>

    <input type="hidden" data-sk-sticky-variant value="{{ selected_variant.id }}">
  </div>
</div>

<script>
  (function () {
    const sectionId = '{{ section_id }}';
    const sourceId = 'stickyBottomBar-' + sectionId;
    const portalId = sourceId + '-portal';
    let latestOfferDetail = null;

    function mountPortal() {
      const source = document.getElementById(sourceId);
      if (!source) return null;

      let portal = document.getElementById(portalId);
      if (!portal) {
        portal = document.createElement('div');
        portal.id = portalId;
        portal.className = 'sk-radiance-sticky-bottom-bar--portal';
        portal.innerHTML = source.innerHTML;
        document.body.appendChild(portal);
      }
      return portal;
    }

    /* ── Synlighet styrt av hoved-ATC, ikke av scroll ────────────────────────
       Foer: updateVisibility() maalte hele #MainProduct-seksjonen og ble kun
       kalt fra scroll- og resize-hendelser — aldri ved init. Derfor manglet
       .visible ved foerste paint, baren sto paa translateY(100%) utenfor
       skjermen, og den dukket foerst opp naar brukeren scrollet. Paa en side
       der knappen uansett ligger under folden var det stikk motsatt av hva
       baren er til for.

       Naa er regelen den enkle: baren er en STEDFORTREDER for hoved-knappen.
       Er knappen synlig, trengs ingen stedfortreder. Er den ute av syne,
       trengs den. En IntersectionObserver svarer paa akkurat det spoersmaalet
       uten aa vite noe om scroll-posisjon eller -retning, og den fyrer ved
       observe() — saa tilstanden er riktig fra foerste frame. */
    function setBarVisible(portal, visible) {
      portal.classList.toggle('visible', visible);
      document.documentElement.classList.toggle('sk-sticky-bar-visible', visible);
    }

    function observeMainAtc(portal) {
      const main = document.getElementById('MainProduct-' + sectionId) || document;
      const atc =
        main.querySelector('[data-sk-main-atc]') ||
        main.querySelector('.sk-radiance-buy-buttons button[type="submit"]') ||
        main.querySelector('form[action*="/cart/add"] button[type="submit"]') ||
        main.querySelector('button[name="add"]');

      if (!atc || typeof IntersectionObserver === 'undefined') {
        /* Finner vi ikke knappen, er det tryggere aa vise baren enn aa la
           siden staa uten kjoepsmulighet i det hele tatt. */
        setBarVisible(portal, true);
        return;
      }

      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            /* ── Retningen er avgjoerende ────────────────────────────────────
               Foerste versjon brukte bare !entry.isIntersecting. Det er feil,
               fordi «ikke synlig» daekker TO motsatte tilstander:

                 knappen er OVER viewporten  -> brukeren har scrollet forbi,
                                                baren skal opp
                 knappen er UNDER viewporten -> brukeren har ikke kommet dit
                                                enda, baren skal ligge

               Paa mobil laa hoved-ATC paa 693 px i dokumentet, mens en ekte
               telefon ofte har ~650-700 px synlig naar nettleserlinja er
               framme. Knappen var altsaa saavidt under folden ved lasting,
               og baren spratt opp med én gang — foer kunden hadde rukket aa
               se at det finnes en kjoepsknapp i det hele tatt.

               boundingClientRect.bottom < 0 betyr at hele knappen har
               passert oppover forbi toppen av skjermen. Det, og bare det,
               er «scrollet bort fra kjoepsknappen». Ingen tilstand aa holde
               styr paa — geometrien svarer selv. */
            setBarVisible(portal, entry.boundingClientRect.bottom <= 0);
          });
        },
        /* ── Terskelen MAA inneholde 0 ────────────────────────────────────
           Foerste retningsfiks brukte threshold: 0.35 alene. Da varslet
           observeren kun naar knappen krysset 35 % synlighet — og i det
           oeyeblikket er den fortsatt delvis synlig, saa bottom > 0 og
           baren ble liggende. Naar knappen deretter forsvant helt ut paa
           toppen kom det INGEN ny callback, fordi det ikke fantes noen
           terskel paa 0 aa krysse. Betingelsen ble dermed aldri evaluert
           i det ene oeyeblikket den ville sagt ja, og baren kom aldri.

           Med 0 i lista fyrer observeren ogsaa naar siste piksel forlater
           skjermen. Det er noeyaktig det tidspunktet baren skal opp.

           rootMargin -24px i bunn staar igjen: en knapp som saavidt
           stikker inn under nettleserlinja teller ikke som synlig. Den
           paavirker kun naar intersection regnes ut, ikke
           boundingClientRect, som alltid maales mot ekte viewport. */
        { rootMargin: '0px 0px -24px 0px', threshold: [0, 0.35] }
      ).observe(atc);
    }

    function findProductForm(btn) {
      const mainSection = document.getElementById('MainProduct-' + sectionId);
      if (mainSection) {
        const sectionForm = mainSection.querySelector('form[action^="/cart/add"], form[action*="/cart/add"]');
        if (sectionForm) return sectionForm;

        const anyForm = mainSection.querySelector('form');
        if (anyForm) return anyForm;
      }

      const fallback = document.querySelector(
        'form[action^="/cart/add"], form[action*="/cart/add"], form[action^="/cart"], form[action*="/cart"]'
      );
      return fallback || null;
    }

    function applyVariantToInput(input, variantId) {
      if (!input || !variantId) return;
      const nextValue = String(variantId);
      input.value = nextValue;
      input.setAttribute('value', nextValue);
      input.dispatchEvent(new Event('input', { bubbles: true }));
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }

    function safeSubmitForm(form) {
      if (!form) return false;
      const submitBtn = form.querySelector(
        'button[type="submit"], input[type="submit"], [data-add-to-cart], .add-to-cart'
      );
      if (submitBtn) {
        try {
          submitBtn.click();
          return true;
        } catch (error) {}
      }
      if (typeof form.requestSubmit === 'function') {
        try {
          form.requestSubmit();
          return true;
        } catch (error) {}
      }
      if (typeof form.submit === 'function') {
        try {
          form.submit();
          return true;
        } catch (error) {}
      }
      return false;
    }

    function handlePortalClick(event) {
      const btn = event.target.closest && event.target.closest('[data-sk-sticky-cta]');
      if (!btn) return;
      event.preventDefault();
      const form = findProductForm(btn);
      if (!form) return;

      if (latestOfferDetail && latestOfferDetail.variantId) {
        const mainSection = document.getElementById('MainProduct-' + sectionId);
        const scope = mainSection || form;
        scope
          .querySelectorAll('input[name="id"], .product-variant-id, [data-sk-selected-variant-id]')
          .forEach((input) => applyVariantToInput(input, latestOfferDetail.variantId));
      }

      /* Tilbakemelding på DENNE knappen. safeSubmitForm() sender hovedskjemaet,
         så product-form.js gir «Legger til …» på hovedknappen – men den er
         scrollet ut av syne når sticky-baren er synlig, så klikket her så helt
         uresponsivt ut i de ~0,7 s kallet tar. Vi speiler samme mønster lokalt.
         cartUpdate/cartError (pub-sub) rydder opp; timeout er sikkerhetsnett. */
      if (!btn.dataset.skAdding) {
        btn.dataset.skAdding = '1';
        btn.dataset.skLabel = btn.textContent;
        btn.textContent = '{{ adding_label | default: "Legger til …" }}';
        btn.classList.add('is-adding');
        btn.setAttribute('aria-disabled', 'true');
        restoreStickyCta(btn);
      }

      safeSubmitForm(form);
    }

    /* Gjenopprett knappen når kurven har svart (eller etter timeout). */
    function restoreStickyCta(btn) {
      let done = false;
      const restore = () => {
        if (done) return;
        done = true;
        clearTimeout(timer);
        btn.textContent = btn.dataset.skLabel || btn.textContent;
        btn.classList.remove('is-adding');
        btn.removeAttribute('aria-disabled');
        delete btn.dataset.skAdding;
        delete btn.dataset.skLabel;
      };
      const timer = setTimeout(restore, 4000);
      if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
        const un1 = subscribe(PUB_SUB_EVENTS.cartUpdate, () => { restore(); un1 && un1(); });
        const un2 = subscribe(PUB_SUB_EVENTS.cartError, () => { restore(); un2 && un2(); });
      }
    }

    function updateSticky(detail) {
      latestOfferDetail = detail;
      const portal = document.getElementById(portalId);
      if (!portal || !detail) return;

      const variantInput = portal.querySelector('[data-sk-sticky-variant]');
      if (variantInput && detail.variantId) {
        applyVariantToInput(variantInput, detail.variantId);
      }

      portal.querySelector('[data-sk-sticky-title]').textContent = detail.title;
      portal.querySelector('.sk-price__current').textContent = detail.priceText || '';
      portal.querySelector('.sk-price__value').textContent = detail.compareText || '';

      let badgeEl = portal.querySelector('.sk-price__badge');
      if (!badgeEl) {
        badgeEl = document.createElement('span');
        badgeEl.className = 'sk-price__badge';
        portal.querySelector('.sk-radiance-sticky-bottom-bar__price').appendChild(badgeEl);
      }
      badgeEl.textContent = detail.badgeText || '';

      const btn = portal.querySelector('[data-sk-sticky-cta]');
      btn.disabled = !detail.available;
      btn.setAttribute('aria-disabled', detail.available ? 'false' : 'true');
      btn.textContent = detail.available ? '{{ add_label }}' : '{{ sold_out_label }}';
    }

    const portal = mountPortal();
    if (!portal) return;

    portal.addEventListener('click', handlePortalClick);

    /* Scroll- og resize-lytterne er borte med vilje. De maalte layout ved hver
       hendelse og krevde en rAF-gate for ikke aa gi reflow-storm paa mobil,
       der resize fyrer gjentatte ganger naar nettleserlinja skjules under
       scrolling. IntersectionObserver gjoer maalingen utenfor hovedtraaden og
       kaller bare tilbake naar svaret faktisk endrer seg. */
    observeMainAtc(portal);

    document.addEventListener('sk:offerchange', (e) => updateSticky(e.detail));
  })();
</script>
