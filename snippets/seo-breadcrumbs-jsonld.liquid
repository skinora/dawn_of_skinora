{%- comment -%}
  seo-breadcrumbs-jsonld.liquid
  Outputs BreadcrumbList JSON-LD for product, collection, article and page templates.
  Render from theme.liquid (after meta-tags). Outputs nothing when no context exists.
{%- endcomment -%}

{%- if request.page_type == 'product' -%}
  {%- comment -%}
    Kanoniske produkt-URL-er har ingen collection-kontekst. Ligger produktet i
    rodlysmaske-samlingen, brukes den i brødsmulestien uansett inngang.
  {%- endcomment -%}
  {%- assign bc_col = collection -%}
  {%- unless bc_col -%}
    {%- for c in product.collections -%}
      {%- if c.handle == 'rodlysmaske' -%}{%- assign bc_col = c -%}{%- endif -%}
    {%- endfor -%}
  {%- endunless -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Hjem",
          "item": {{ request.origin | append: '/' | json }}
        }
        {%- if bc_col -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ bc_col.title | json }},
            "item": {{ request.origin | append: '/collections/' | append: bc_col.handle | json }}
          }
          ,{
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }}
          }
        {%- else -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.title | json }}
          }
        {%- endif -%}
      ]
    }
  </script>

{%- elsif request.page_type == 'collection' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
