        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }}
        }
      ]
    }
  </script>

{%- elsif request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Hjem",
          "item": {{ request.origin | append: '/' | json }}
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ blog.title | json }},
          "item": {{ request.origin | append: '/blogs/' | append: blog.handle | json }}
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ article.title | json }}
        }
      ]
    }
  </script>

{%- elsif request.page_type == 'page' -%}
